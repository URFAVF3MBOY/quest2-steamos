+/*
+ * q2 (desk-377): panel refresh rate by frame length.  The Quest 2's video-mode panel keeps the bootloader's timing
+ * (continuous splash: 432 x 4916 lines = 90 Hz, of which 1231 are vertical front porch); a longer frame with the same
+ * line time lowers the refresh rate (6144 lines = 72 Hz, Meta's jdi_4k_dsc_video entry), the "VFP" kind of dynamic
+ * fps that Meta's 90 Hz panel entry enables (60-90 Hz).
+ * desk-378: the DSI controllers keep their own copy of the frame length (VIDEO_MODE_TOTAL) and send the panel its
+ * frame structure from it, so they change too.
+ * desk-380: the INTF and the DSI controllers must switch at the SAME frame boundary.  Written from sysfs, the INTF
+ * flush raced the display commits (it often took several writes) while the DSI latched at once: for those frames the
+ * two ran with different frame lengths, their frame starts drifted apart, and the panel showed garbage until a reboot
+ * (DSI FIFO errors).  Like Meta's own dfps (DSI timing + INTF timing in one commit, before its flush), the store now
+ * only records the request; _sde_encoder_trigger_flush() applies it in the next commit, under the encoder spinlock,
+ * right before that commit's CTL flush.
+ * desk-380: DSI commands in video mode go out at the DMA schedule line, which the driver computes from the panel
+ * entry it booted with (the 144 Hz one: back porch 7) - inside the real picture (back porch 20), where a command
+ * never goes out (tx_cmd "succeeded" but the DMA stayed busy).  The schedule line is moved to the first blanking line.
+ *   cat /sys/kernel/q2display/vtotal          current frame length in lines
+ *   echo 6144 > /sys/kernel/q2display/vtotal  72 Hz (4916 = 90 Hz); waits up to 200 ms for the next commit
+ */
+#include <linux/kobject.h>
+#include <linux/sysfs.h>
+#include <linux/wait.h>
+#include "dsi_display.h"
+#include "dsi_ctrl.h"
+#define Q2_DSI_VIDEO_MODE_ACTIVE_V	0x028
+#define Q2_DSI_VIDEO_MODE_TOTAL		0x02C
+#define Q2_DSI_TIMING_FLUSH		0x1E4
+#define Q2_DSI_TIMING_DB_MODE		0x1E8
+#define Q2_INTF_CONFIG			0x004
+#define Q2_INTF_HSYNC_CTL		0x008
+#define Q2_INTF_VSYNC_PERIOD_F0		0x00C
+#define Q2_INTF_PROG_FETCH_START	0x170
+static struct drm_encoder *q2_dsi_enc;
+static DEFINE_MUTEX(q2_vtotal_lock);
+static DECLARE_WAIT_QUEUE_HEAD(q2_vtotal_wq);
+static u32 q2_vtotal_req;		/* lines requested, 0 = nothing pending; under the encoder spinlock */
+static bool q2_dma_line_fixed;
+
+static struct dsi_display *q2_phys_dsi(struct sde_encoder_phys *phys)
+{
+	if (!phys->connector || to_sde_connector(phys->connector)->connector_type != DRM_MODE_CONNECTOR_DSI)
+		return NULL;
+	return to_sde_connector(phys->connector)->display;
+}
+
+/* called from _sde_encoder_trigger_flush() with the encoder spinlock held, before the commit's flush */
+static void q2_vtotal_apply(struct sde_encoder_phys *phys)
+{
+	struct dsi_display *disp;
+	struct sde_hw_blk_reg_map *c;
+	u32 i, lines = q2_vtotal_req, hper, old, cfg, fetch, period, tot;
+
+	if (!phys->hw_intf || !phys->hw_ctl || !phys->ops.is_master || !phys->ops.is_master(phys))
+		return;
+	disp = q2_phys_dsi(phys);
+	if (disp && !q2_dma_line_fixed) {
+		for (i = 0; i < disp->ctrl_count; i++) {
+			struct dsi_ctrl *dc = disp->ctrl[i].ctrl;
+			struct dsi_mode_info *t;
+			u32 vend, base;
+
+			if (!dc || !dc->hw.base)
+				continue;
+			t = &dc->host_config.video_timing;
+			vend = readl_relaxed(dc->hw.base + Q2_DSI_VIDEO_MODE_ACTIVE_V) >> 16;  /* real last picture line + 1 */
+			base = t->v_back_porch + t->v_sync_width + t->v_active;
+			if (vend > base && vend < base + 1000) {
+				dc->host_config.u.video_engine.dma_sched_line = vend + 1 - base;
+				pr_info("q2display: DSI ctrl %u command line %u (was %u)\n", i, vend + 1, base + 1);
+			}
+		}
+		q2_dma_line_fixed = true;
+	}
+	if (!lines)
+		return;
+	q2_vtotal_req = 0;
+	c = &phys->hw_intf->hw;
+	hper = SDE_REG_READ(c, Q2_INTF_HSYNC_CTL) >> 16;
+	if (!hper || !phys->hw_ctl->ops.update_bitmask_intf)
+		goto done;
+	for (i = 0; disp && i < disp->ctrl_count; i++) {
+		struct dsi_ctrl *dc = disp->ctrl[i].ctrl;
+
+		if (!dc || !dc->hw.base)
+			continue;
+		tot = readl_relaxed(dc->hw.base + Q2_DSI_VIDEO_MODE_TOTAL);
+		writel_relaxed(0x1, dc->hw.base + Q2_DSI_TIMING_DB_MODE);
+		writel_relaxed(((lines - 1) << 16) | (tot & 0xFFFF), dc->hw.base + Q2_DSI_VIDEO_MODE_TOTAL);
+		writel_relaxed(0x1, dc->hw.base + Q2_DSI_TIMING_FLUSH);
+	}
+	period = lines * hper;
+	old = SDE_REG_READ(c, Q2_INTF_VSYNC_PERIOD_F0);
+	cfg = SDE_REG_READ(c, Q2_INTF_CONFIG);
+	fetch = SDE_REG_READ(c, Q2_INTF_PROG_FETCH_START);
+	SDE_REG_WRITE(c, Q2_INTF_VSYNC_PERIOD_F0, period);
+	if ((cfg & BIT(31)) && fetch)   /* programmable fetch: same distance before the end of the frame */
+		SDE_REG_WRITE(c, Q2_INTF_PROG_FETCH_START, fetch + period - old);
+	wmb();
+	phys->hw_ctl->ops.update_bitmask_intf(phys->hw_ctl, phys->hw_intf->idx, true);
+	pr_info("q2display: frame length %u -> %u lines in this commit (DSI + INTF)\n", old / hper, lines);
+done:
+	wake_up_all(&q2_vtotal_wq);
+}
+
+static struct sde_encoder_phys *q2_vtotal_phys(void)
+{
+	struct sde_encoder_virt *sde_enc;
+
+	if (!q2_dsi_enc || sde_kms_is_suspend_state(q2_dsi_enc->dev))
+		return NULL;
+	sde_enc = to_sde_encoder_virt(q2_dsi_enc);
+	if (!sde_enc->cur_master || !sde_enc->cur_master->hw_intf)
+		return NULL;
+	return sde_enc->cur_master;
+}
+
+static ssize_t q2_vtotal_show(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+	struct sde_encoder_phys *phys;
+	struct sde_hw_blk_reg_map *c;
+	u32 hper, period;
+	ssize_t ret = -ENODEV;
+
+	mutex_lock(&q2_vtotal_lock);
+	phys = q2_vtotal_phys();
+	if (phys) {
+		c = &phys->hw_intf->hw;
+		hper = SDE_REG_READ(c, Q2_INTF_HSYNC_CTL) >> 16;
+		period = SDE_REG_READ(c, Q2_INTF_VSYNC_PERIOD_F0);
+		ret = scnprintf(buf, PAGE_SIZE, "%u\n", hper ? period / hper : 0);
+	}
+	mutex_unlock(&q2_vtotal_lock);
+	return ret;
+}
+
+static ssize_t q2_vtotal_store(struct kobject *kobj, struct kobj_attribute *attr, const char *buf, size_t count)
+{
+	struct sde_encoder_virt *sde_enc;
+	unsigned long flags;
+	u32 lines;
+	long left;
+	int ret = kstrtou32(buf, 0, &lines);
+
+	if (ret)
+		return ret;
+	if (lines < 3700 || lines > 9000)   /* 3664 visible lines + blanking; 9000 = ~49 Hz */
+		return -EINVAL;
+	mutex_lock(&q2_vtotal_lock);
+	if (!q2_vtotal_phys()) {
+		mutex_unlock(&q2_vtotal_lock);
+		return -ENODEV;
+	}
+	sde_enc = to_sde_encoder_virt(q2_dsi_enc);
+	spin_lock_irqsave(&sde_enc->enc_spinlock, flags);
+	q2_vtotal_req = lines;
+	spin_unlock_irqrestore(&sde_enc->enc_spinlock, flags);
+	left = wait_event_timeout(q2_vtotal_wq, READ_ONCE(q2_vtotal_req) == 0, msecs_to_jiffies(200));
+	if (!left) {   /* no commit came: drop the request rather than apply it at some random later time */
+		spin_lock_irqsave(&sde_enc->enc_spinlock, flags);
+		q2_vtotal_req = 0;
+		spin_unlock_irqrestore(&sde_enc->enc_spinlock, flags);
+		mutex_unlock(&q2_vtotal_lock);
+		pr_info("q2display: no display commit within 200 ms, frame length unchanged\n");
+		return -EAGAIN;
+	}
+	mutex_unlock(&q2_vtotal_lock);
+	return count;
+}
+
+static struct kobj_attribute q2_vtotal_attr = __ATTR(vtotal, 0644, q2_vtotal_show, q2_vtotal_store);
+
+static int __init q2_display_sysfs_init(void)
+{
+	struct kobject *kobj = kobject_create_and_add("q2display", kernel_kobj);
+
+	if (!kobj)
+		return -ENOMEM;
+	return sysfs_create_file(kobj, &q2_vtotal_attr.attr);
+}
+late_initcall(q2_display_sysfs_init);
+
