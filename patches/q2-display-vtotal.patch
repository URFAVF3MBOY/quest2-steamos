+/*
+ * q2 (desk-377): panel refresh rate by frame length.  The Quest 2's video-mode panel keeps the bootloader's timing
+ * (continuous splash: 432 x 4916 lines = 90 Hz, of which 1231 are vertical front porch); a longer frame with the same
+ * line time lowers the refresh rate (6145 lines = 72 Hz), the "VFP" kind of dynamic fps.  Written registers latch
+ * only with an INTF flush through the CTL, as sde_encoder_set_lineptr_value() does it.
+ * desk-378: the DSI controllers keep their own copy of the frame length (VIDEO_MODE_TOTAL) and send the panel its
+ * frame structure from it - with only the INTF changed the panel got garbage.  Like the panel's own dynamic fps
+ * ("dfps_immediate_porch_mode_vfp", dsi_ctrl_async_timing_update): timing double-buffer on, new vertical total,
+ * TIMING_FLUSH - on every controller of the panel, then the INTF, so both latch at the same frame boundary.
+ *   cat /sys/kernel/q2display/vtotal          current frame length in lines
+ *   echo 6145 > /sys/kernel/q2display/vtotal  72 Hz (4916 = 90 Hz); the programmable fetch start moves along
+ */
+#include <linux/kobject.h>
+#include <linux/sysfs.h>
+#include "dsi_display.h"
+#include "dsi_ctrl.h"
+#define Q2_DSI_VIDEO_MODE_TOTAL		0x02C
+#define Q2_DSI_TIMING_FLUSH		0x1E4
+#define Q2_DSI_TIMING_DB_MODE		0x1E8
+#define Q2_INTF_CONFIG			0x004
+#define Q2_INTF_HSYNC_CTL		0x008
+#define Q2_INTF_VSYNC_PERIOD_F0		0x00C
+#define Q2_INTF_PROG_FETCH_START	0x170
+static struct drm_encoder *q2_dsi_enc;
+static DEFINE_MUTEX(q2_vtotal_lock);
+
+static struct sde_encoder_phys *q2_vtotal_phys(void)
+{
+	struct sde_encoder_virt *sde_enc;
+
+	if (!q2_dsi_enc || sde_kms_is_suspend_state(q2_dsi_enc->dev))
+		return NULL;
+	sde_enc = to_sde_encoder_virt(q2_dsi_enc);
+	if (!sde_enc->cur_master || !sde_enc->cur_master->hw_intf)
+		return NULL;
+	return sde_enc->cur_master;
+}
+
+static ssize_t q2_vtotal_show(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+	struct sde_encoder_phys *phys;
+	struct sde_hw_blk_reg_map *c;
+	u32 hper, period;
+	ssize_t ret = -ENODEV;
+
+	mutex_lock(&q2_vtotal_lock);
+	phys = q2_vtotal_phys();
+	if (phys) {
+		c = &phys->hw_intf->hw;
+		hper = SDE_REG_READ(c, Q2_INTF_HSYNC_CTL) >> 16;
+		period = SDE_REG_READ(c, Q2_INTF_VSYNC_PERIOD_F0);
+		ret = scnprintf(buf, PAGE_SIZE, "%u\n", hper ? period / hper : 0);
+	}
+	mutex_unlock(&q2_vtotal_lock);
+	return ret;
+}
+
+static ssize_t q2_vtotal_store(struct kobject *kobj, struct kobj_attribute *attr, const char *buf, size_t count)
+{
+	struct sde_encoder_phys *phys;
+	struct sde_hw_blk_reg_map *c;
+	struct sde_hw_ctl *ctl;
+	unsigned long flags;
+	u32 lines, hper, old, cfg, fetch, period;
+	int ret = kstrtou32(buf, 0, &lines);
+
+	if (ret)
+		return ret;
+	if (lines < 3700 || lines > 9000)   /* 3664 visible lines + blanking; 9000 = ~49 Hz */
+		return -EINVAL;
+	mutex_lock(&q2_vtotal_lock);
+	phys = q2_vtotal_phys();
+	if (!phys || !phys->hw_ctl) {
+		mutex_unlock(&q2_vtotal_lock);
+		return -ENODEV;
+	}
+	c = &phys->hw_intf->hw;
+	ctl = phys->hw_ctl;
+	hper = SDE_REG_READ(c, Q2_INTF_HSYNC_CTL) >> 16;
+	if (!hper || !ctl->ops.update_bitmask_intf || !ctl->ops.trigger_flush) {
+		mutex_unlock(&q2_vtotal_lock);
+		return -ENODEV;
+	}
+	period = lines * hper;
+	if (phys->connector && to_sde_connector(phys->connector)->connector_type == DRM_MODE_CONNECTOR_DSI) {
+		struct dsi_display *disp = to_sde_connector(phys->connector)->display;
+		u32 i, tot;
+
+		for (i = 0; disp && i < disp->ctrl_count; i++) {
+			struct dsi_ctrl *dc = disp->ctrl[i].ctrl;
+
+			if (!dc || !dc->hw.base)
+				continue;
+			tot = readl_relaxed(dc->hw.base + Q2_DSI_VIDEO_MODE_TOTAL);
+			writel_relaxed(0x1, dc->hw.base + Q2_DSI_TIMING_DB_MODE);
+			wmb();
+			writel_relaxed(((lines - 1) << 16) | (tot & 0xFFFF), dc->hw.base + Q2_DSI_VIDEO_MODE_TOTAL);
+			writel_relaxed(0x1, dc->hw.base + Q2_DSI_TIMING_FLUSH);
+			wmb();
+			pr_info("q2display: DSI ctrl %u frame length %u -> %u lines
+", i, (tot >> 16) + 1, lines);
+		}
+	}
+	spin_lock_irqsave(phys->enc_spinlock, flags);
+	old = SDE_REG_READ(c, Q2_INTF_VSYNC_PERIOD_F0);
+	cfg = SDE_REG_READ(c, Q2_INTF_CONFIG);
+	fetch = SDE_REG_READ(c, Q2_INTF_PROG_FETCH_START);
+	SDE_REG_WRITE(c, Q2_INTF_VSYNC_PERIOD_F0, period);
+	if ((cfg & BIT(31)) && fetch)   /* programmable fetch: same distance before the end of the frame */
+		SDE_REG_WRITE(c, Q2_INTF_PROG_FETCH_START, fetch + period - old);
+	spin_unlock_irqrestore(phys->enc_spinlock, flags);
+	ctl->ops.update_bitmask_intf(ctl, phys->hw_intf->idx, true);
+	ctl->ops.trigger_flush(ctl);
+	pr_info("q2display: frame length %u -> %u lines (fetch %u -> %u)\n", old / hper, lines, fetch,
+		SDE_REG_READ(c, Q2_INTF_PROG_FETCH_START));
+	mutex_unlock(&q2_vtotal_lock);
+	return count;
+}
+
+static struct kobj_attribute q2_vtotal_attr = __ATTR(vtotal, 0644, q2_vtotal_show, q2_vtotal_store);
+
+static int __init q2_display_sysfs_init(void)
+{
+	struct kobject *kobj = kobject_create_and_add("q2display", kernel_kobj);
+
+	if (!kobj)
+		return -ENOMEM;
+	return sysfs_create_file(kobj, &q2_vtotal_attr.attr);
+}
+late_initcall(q2_display_sysfs_init);
