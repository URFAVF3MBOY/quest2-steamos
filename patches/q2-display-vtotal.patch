 		timer_setup(&sde_enc->vsync_event_timer,
 				sde_encoder_vsync_event_handler, 0);
+	if (disp_info->intf_type == DRM_MODE_CONNECTOR_DSI && !q2_dsi_enc)
+		q2_dsi_enc = drm_enc;   /* q2: the panel's encoder, for /sys/kernel/q2display/vtotal */
 
 	for (i = 0; i < sde_enc->num_phys_encs; i++) {
