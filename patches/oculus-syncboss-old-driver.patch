--- /dev/null
+++ b/drivers/staging/oculus/mcu/syncboss/syncboss_spi.c
@@ -0,0 +1,3068 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio.h>
+#include <linux/hrtimer.h>
