log "---- mount units:"; ls $NR/usr/lib/systemd/system 2>/dev/null | grep -E '\.mount$|\.automount$' | while IFS= read -r l; do log "|$l"; done
for f in /usr/lib/systemd/system/home.mount /usr/lib/systemd/system/var.mount /usr/lib/systemd/system/efi.mount \
         /usr/lib/systemd/system/dbus-broker.service /usr/lib/systemd/system/systemd-logind.service; do dumpf "$f" 40; done
log "---- generators: $(ls $NR/usr/lib/systemd/system-generators $NR/etc/systemd/system-generators 2>/dev/null | tr '\n' ' ')"

INIT=/usr/lib/systemd/systemd
[ -x "$NR$INIT" ] || INIT=/sbin/init
[ -x "$NR$INIT" ] || fail "no init found in rootfs (looked for /usr/lib/systemd/systemd and /sbin/init)"
log "switching root (mode=$ROOTMODE); init=$INIT"

mkdir -p /mnt/newroot/proc /mnt/newroot/sys /mnt/newroot/dev /mnt/newroot/run /mnt/newroot/tmp
mount --move /proc /mnt/newroot/proc
mount --move /sys /mnt/newroot/sys
mount --move /dev /mnt/newroot/dev
mount --move /run /mnt/newroot/run
if [ "$ROOTMODE" = "ov" ]; then
  mkdir -p /mnt/newroot/run/initramfs/rootfs /mnt/newroot/run/initramfs/ov
  mount --move /mnt/rootfs /mnt/newroot/run/initramfs/rootfs 2>/dev/null
  mount --move /mnt/ov /mnt/newroot/run/initramfs/ov 2>/dev/null
fi
exec switch_root /mnt/newroot "$INIT"
log "switch_root failed"
serial_shell
