#!/bin/sh
# Quest 2 -> SteamOS first-light init (PID 1).
#   1. show the kernel log on the headset display (qscreen -k)
#   2. switch the USB-C port to host mode and wait for the SteamOS drive
#      (MBR disk signature 0x20262026 = PARTUUID 20262026-01, written by steamos_fetch.py)
#   3. mount Valve's btrfs rootfs read-only, put a RAM overlay on top, switch_root to systemd
#   If anything fails: switch the port back to device mode and offer the USB serial shell
#   (same as the RAM-only image) so the failure can be read.

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
export TERM=xterm-256color

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /run /tmp /root /mnt/rootfs /mnt/ov /mnt/newroot
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
hostname quest2

log() { echo "q2-init: $*" > /dev/kmsg 2>/dev/null; echo "q2-init: $*"; }
getarg() { for w in $(cat /proc/cmdline); do case "$w" in "$1="*) echo "${w#*=}"; return 0;; esac; done; return 1; }

M=/sys/devices/platform/soc/a600000.ssusb/mode
ROT="$(getarg qs_rot)"; [ -n "$ROT" ] || ROT=0
WANT_SIG="26202620"   # bytes of 0x20262026 at MBR offset 440 (little-endian, palindromic)
WAIT="$(getarg q2_wait)"; [ -n "$WAIT" ] || WAIT=120
OVSIZE="$(getarg q2_ovsize)"; [ -n "$OVSIZE" ] || OVSIZE=2g

log "SteamOS init rev=desk-16, kernel $(uname -r), qs_rot=$ROT wait=${WAIT}s"

serial_shell() {
  log "FALLBACK: switching USB back to device mode, serial shell on ttyGS0"
  echo peripheral > "$M" 2>/dev/null
  mount -t configfs none /sys/kernel/config 2>/dev/null
  UDC=""; i=0
  while [ $i -lt 30 ]; do UDC="$(ls /sys/class/udc 2>/dev/null | head -n 1)"; [ -n "$UDC" ] && break; i=$((i+1)); sleep 1; done
  G=/sys/kernel/config/usb_gadget/g1
  mkdir -p "$G"
  echo 0x1d6b > "$G/idVendor"; echo 0x0104 > "$G/idProduct"; echo 0x0200 > "$G/bcdUSB"; echo 0x02 > "$G/bDeviceClass"
  mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" "$G/functions/acm.usb0"
  echo "q2-steamos" > "$G/strings/0x409/serialnumber"
  echo "Quest 2 serial console" > "$G/strings/0x409/product"
  echo ACM > "$G/configs/c.1/strings/0x409/configuration"
  ln -s "$G/functions/acm.usb0" "$G/configs/c.1/" 2>/dev/null
  echo "$UDC" > "$G/UDC" 2>/dev/null
  while true; do
    if [ -c /dev/ttyGS0 ]; then getty -L -n -l /bin/bash 115200 ttyGS0 xterm-256color; else sleep 2; fi
  done
}

fail() { log "ERROR: $*"; dmesg | tail -n 25 > /dev/kmsg 2>/dev/null; sleep 5; serial_shell; }

# 1. display
if [ -x /usr/bin/qscreen ]; then
  # default: draw straight into the bootloader's splash framebuffer (-S); qs_drm=1 uses the DRM driver instead
  if [ "$(getarg qs_drm)" = "1" ]; then QSMODE=""; else QSMODE="-S"; fi
  /usr/bin/qscreen $QSMODE -r "$ROT" -k > /run/qscreen.log 2>&1 &
  sleep 3
  while read -r l; do log "qscreen: $l"; done < /run/qscreen.log
else
  log "no qscreen binary; display log disabled"
fi

# 2. USB host + find the drive
log "switching USB port to host mode"
echo host > "$M" 2>/dev/null || log "writing $M failed"

find_root() {
  for d in /sys/block/sd*; do
    [ -e "$d" ] || continue
    n="${d##*/}"
    case "$(readlink -f "$d")" in *usb*) ;; *) continue ;; esac   # skip internal UFS disks
    sig="$(dd if=/dev/$n bs=1 skip=440 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    if [ "$sig" = "$WANT_SIG" ]; then
      echo "$n" > /run/rootdisk
      if [ -b "/dev/${n}1" ]; then echo "/dev/${n}1"; return 0; fi
      # Kernel has no MSDOS_PARTITION, so no /dev/sdX1: attach a loop device at the MBR partition-1 start instead.
      lba="$(od -An -tu4 -j454 -N4 /dev/$n 2>/dev/null | tr -d ' \n')"
      case "$lba" in ''|0|*[!0-9]*) lba=2048 ;; esac
      lo="$(losetup -f 2>/dev/null)"
      if [ -n "$lo" ] && losetup -o $((lba*512)) "$lo" "/dev/$n" 2>/dev/null; then
        log "no /dev/${n}1 (no MSDOS_PARTITION in kernel); using $lo = /dev/$n at LBA $lba" >&2
        echo "$lo"; return 0
      fi
    fi
  done
  return 1
}

diag() {
  B="$(ls /sys/block 2>/dev/null | tr '\n' ' ')"
  log "diag: blockdevs: $B"
  for s in /sys/bus/scsi/devices/1:*:*:*; do          # only the USB host (scsi host1+), not the UFS LUNs
    [ -e "$s" ] || continue
    log "diag: scsi ${s##*/} state=$(cat "$s/state" 2>/dev/null) $(cat "$s/model" 2>/dev/null)"
  done
  # kernel messages only (never our own q2-init lines, or the output feeds back on itself)
  dmesg | grep -v 'q2-init' | grep -E 'sd [0-9]+:|scsi host[1-9]|scsi [1-9]:|usb-storage|usb 1-|xhci|reset|timeout|abort|I/O' | tail -n 12 | while read -r l; do log "diag: $l"; done
}

ROOTDEV=""; i=0
while [ $i -lt "$WAIT" ]; do
  ROOTDEV="$(find_root)" && break
  ROOTDEV=""
  i=$((i+2)); sleep 2
  [ $((i % 20)) -eq 0 ] && diag
done
[ -n "$ROOTDEV" ] || { diag; fail "SteamOS drive (disk signature 20262026) not found after ${WAIT}s"; }
log "rootfs partition: $ROOTDEV (after ${i}s)"

# 2b. persistent log: copy the kernel log (incl. systemd, via systemd.log_target=kmsg) into a raw area of the USB
# drive, past the end of the rootfs partition (11 GiB). Read it on the PC with tools/read_q2log.py.
# It keeps running after switch_root. Disable with q2_log=0.
LOGOFF=11811160064; LOGSIZE=67108864
RD="$(cat /run/rootdisk 2>/dev/null)"
if [ "$(getarg q2_log)" = "0" ]; then
  log "persistent log disabled (q2_log=0)"
elif [ -z "$RD" ] || [ ! -x /usr/bin/qlog ]; then
  log "persistent log unavailable (disk='$RD' qlog=$([ -x /usr/bin/qlog ] && echo yes || echo no))"
elif [ "$(cat /sys/block/$RD/size 2>/dev/null || echo 0)" -le $(( (LOGOFF+LOGSIZE)/512 )) ]; then
  log "persistent log skipped: /dev/$RD is too small (need > 11.1 GiB)"
else
  /usr/bin/qlog "/dev/$RD" "$LOGOFF" "$LOGSIZE" >> /run/qlog.out 2>&1 &
  sleep 1
  log "persistent log: /dev/$RD @ 11GiB ($(cat /run/qlog.out 2>/dev/null | tail -n 1))"
fi

# 3. mount the rootfs.
# Default (q2_root=rw): mount the btrfs read-WRITE directly. A tmpfs overlay does not work on this 4.19 kernel
# (copy-up of btrfs xattrs onto tmpfs fails with EOPNOTSUPP, which broke mkdir/chmod/dbus/logind), and a direct rw
# mount also makes /var, /home and /etc persistent. q2_root=ov forces the old read-only + RAM overlay mode.
MODE="$(getarg q2_root)"; [ -n "$MODE" ] || MODE=rw
ROOTMODE=""
if [ "$MODE" = "rw" ]; then
  if mount -t btrfs -o rw,noatime "$ROOTDEV" /mnt/newroot; then
    ROOTMODE=rw; log "btrfs rootfs mounted READ-WRITE (no overlay); $(ls /mnt/newroot | tr '\n' ' ')"
    # Valve's rootfs is a read-only btrfs *subvolume*: a rw mount still gives EROFS on every write until the flag is cleared
    log "qrw: $(/usr/bin/qrw /mnt/newroot 2>&1)"
    if ( : > /mnt/newroot/.q2rw-test ) 2>/dev/null; then rm -f /mnt/newroot/.q2rw-test; log "rootfs is writable"
    else log "WARNING: rootfs is still NOT writable (EROFS)"; fi
  else
    log "rw btrfs mount failed (see kernel messages); falling back to read-only + RAM overlay"
  fi
fi
if [ -z "$ROOTMODE" ]; then
  mount -t btrfs -o ro "$ROOTDEV" /mnt/rootfs || fail "btrfs mount of $ROOTDEV failed (see kernel messages above)"
  log "btrfs rootfs mounted read-only; $(ls /mnt/rootfs | tr '\n' ' ')"
  mount -t tmpfs -o size="$OVSIZE" tmpfs /mnt/ov || fail "tmpfs for overlay failed"
  mkdir -p /mnt/ov/upper /mnt/ov/work
  mount -t overlay overlay -o lowerdir=/mnt/rootfs,upperdir=/mnt/ov/upper,workdir=/mnt/ov/work /mnt/newroot \
    || fail "overlay mount failed"
  ROOTMODE=ov
fi
NR=/mnt/newroot

dumpf() {   # dumpf FILE [MAXLINES]: copy a file from the new root into the persistent log
  [ -f "$NR$1" ] || { log "---- $1 (missing)"; return; }
  log "---- $1"
  head -n "${2:-60}" "$NR$1" | while IFS= read -r l; do log "|$l"; done
}

# 3b. fix-ups so SteamOS' Steam-Frame-specific setup can run on a Quest 2 with ONE partition (rw root only).
if [ "$ROOTMODE" = "rw" ] && [ "$(getarg q2_fixups)" != "0" ]; then
  # (a) Valve's partition-set mounts (home, persist, efi, esp, ...) point at partitions this single-partition drive
  #     doesn't have; each one costs a 90 s device timeout. fstab: comment those lines out. Mount units
  #     (/usr/lib/systemd/system/*.mount with What= on by-partsets/by-partlabel/PARTLABEL): override each in /etc with a
  #     harmless bind of the directory onto itself and drop the fsck/blockdev/device dependencies.
  mkdir -p $NR/etc/systemd/system
  if [ -f $NR/etc/fstab ]; then
    [ -f $NR/etc/fstab.q2orig ] || cp $NR/etc/fstab $NR/etc/fstab.q2orig
    sed -E '/^[^#[:space:]]+[[:space:]]+\/[[:space:]]/!{/^(\/dev\/disk\/by-part|PARTLABEL=|PARTUUID=)/s/^/# q2: /}' \
      $NR/etc/fstab.q2orig > $NR/etc/fstab.q2new 2>/dev/null
    if [ -s $NR/etc/fstab.q2new ]; then cat $NR/etc/fstab.q2new > $NR/etc/fstab; fi
    rm -f $NR/etc/fstab.q2new
    log "fixup: fstab: $(grep -c '^# q2:' $NR/etc/fstab) partition entries commented out"
  fi
  MOUNTFIX=""
  for f in $NR/usr/lib/systemd/system/*.mount; do
    [ -f "$f" ] || continue
    grep -qE '^What=(/dev/disk/by-part|PARTLABEL=|PARTUUID=)' "$f" || continue
    u="${f##*/}"
    w="$(sed -n 's/^Where=//p' "$f" | head -n 1)"
    [ -n "$w" ] || continue
    mkdir -p "$NR$w" 2>/dev/null
    sed -E -e '/^(Requires|After|BindsTo|Wants|Before|Conflicts)=.*(systemd-fsck@|blockdev@|systemd-growfs@|dev-disk-by)/d' \
           -e '/^(Type|Options)=/d' \
           -e "s#^What=.*#What=$w\nType=none\nOptions=bind#" "$f" > "$NR/etc/systemd/system/$u" 2>/dev/null \
      && MOUNTFIX="$MOUNTFIX $u"
  done
  log "fixup: mount units overridden with self-binds:$MOUNTFIX"
  # (b) mask services that only make sense on Steam Frame hardware (they crash-loop or time out here)
  mkdir -p $NR/etc/systemd/system
  MASKED=""
  for f in $NR/usr/lib/systemd/system/*.service; do
    [ -f "$f" ] || continue
    u="${f##*/}"
    case "$u" in deckard-*|steamvr-*|gpu-trace.service|setubootenv.service) hit=1 ;; *) hit=0 ;; esac
    if [ "$hit" = 0 ] && grep -qE '^Description=.*(Deckard|SteamVR|Predistort|FPGA|Type-C tcpm|Uboot)' "$f"; then hit=1; fi
    if [ "$hit" = 1 ]; then ln -sf /dev/null "$NR/etc/systemd/system/$u"; MASKED="$MASKED $u"; fi
  done
  log "fixup: masked:$MASKED"
  # (c) no GPU/compositor yet: boot to multi-user instead of the graphical (gamescope/steam) session
  if [ "$(getarg q2_target)" != "graphical" ]; then
    ln -sf /usr/lib/systemd/system/multi-user.target $NR/etc/systemd/system/default.target
    log "fixup: default target = multi-user (q2_target=graphical to keep the graphical session)"
  fi
fi

# 3b2. system summary: SteamOS' VR image ships neither neofetch nor fastfetch, so install our own tiny q2fetch
# (/usr/bin/q2fetch) and run it ~25 s after boot; its output goes to the kernel log -> headset display + persistent log.
if [ "$ROOTMODE" = "rw" ] && [ "$(getarg q2_fetch)" != "0" ]; then
  cat > $NR/usr/bin/q2fetch <<'Q2FETCH_EOF'
#!/bin/sh
# q2fetch - neofetch-style system summary that only needs /proc, /sys and /etc/os-release.
# (SteamOS' VR image ships neither neofetch nor fastfetch.)  Works in any POSIX sh.
. /etc/os-release 2>/dev/null
rd() { [ -r "$1" ] && tr -d '\0' < "$1" 2>/dev/null; }
kb() { sed -n "s/^$1:[[:space:]]*\([0-9]*\) kB.*/\1/p" /proc/meminfo | head -n 1; }

host="$(rd /proc/sys/kernel/hostname)"; [ -n "$host" ] || host=$(hostname 2>/dev/null)
title="root@$host"
echo "$title"
printf '%*s\n' "${#title}" '' | tr ' ' '-'

echo "OS: ${PRETTY_NAME:-?} ${VERSION_ID:+$VERSION_ID }${VERSION_CODENAME:+($VERSION_CODENAME${VARIANT_ID:+, $VARIANT_ID}) }$(uname -m)"
echo "Build: ${BUILD_ID:-?}"
model="$(rd /proc/device-tree/model)"; [ -n "$model" ] || model="$(rd /sys/firmware/devicetree/base/model)"
hw="$(sed -n 's/.*androidboot.hardware=\([^ ]*\).*/\1/p' /proc/cmdline | head -n 1)"
echo "Host: ${model:-unknown}${hw:+ [$hw]}"
echo "Kernel: $(uname -r)"

up=$(cut -d. -f1 /proc/uptime 2>/dev/null)
if [ -n "$up" ]; then
  d=$((up/86400)); h=$((up%86400/3600)); m=$((up%3600/60)); s=$((up%60))
  u=""; [ $d -gt 0 ] && u="${d}d "; [ $h -gt 0 ] && u="$u${h}h "; [ $m -gt 0 ] && u="$u${m}m "; echo "Uptime: $u${s}s"
fi

pk=""
[ -d /var/lib/pacman/local ] && pk="$(ls /var/lib/pacman/local 2>/dev/null | grep -vc '^ALPM_DB_VERSION$') (pacman)"
[ -n "$pk" ] && echo "Packages: $pk"
echo "Shell: ${SHELL:-/bin/sh}"

soc="$(rd /sys/devices/soc0/machine)"; sid="$(rd /sys/devices/soc0/soc_id)"
n=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null); f=$(rd /sys/devices/system/cpu/cpu7/cpufreq/cpuinfo_max_freq)
[ -n "$f" ] || f=$(rd /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq)
cpuf=""; [ -n "$f" ] && cpuf=" @ $((f/1000))MHz (max)"
echo "CPU: Qualcomm ${soc:-SoC}${sid:+ (id $sid)} (${n:-?} cores)$cpuf"

gpu="$(rd /sys/class/kgsl/kgsl-3d0/gpu_model)"
[ -n "$gpu" ] && echo "GPU: Qualcomm $gpu (KGSL)" || echo "GPU: no KGSL device visible"

mt=$(kb MemTotal); mf=$(kb MemAvailable)
[ -n "$mt" ] && echo "Memory: $(( (mt-${mf:-0})/1024 ))MiB / $((mt/1024))MiB"

df -h / 2>/dev/null | awk 'NR==2{print "Disk (/): " $3 " / " $2 " (" $5 ") " }' 2>/dev/null || true

for m in /sys/class/drm/card*-*/modes; do [ -r "$m" ] && { echo "Display: $(head -n 1 "$m") ($(echo "$m" | cut -d/ -f5))"; break; }; done
echo "Display (splash fb): 1920x3664 (qscreen)"

nic=""
for i in /sys/class/net/*; do b="${i##*/}"; [ "$b" = lo ] && continue; a="$(ip -4 -o addr show dev "$b" 2>/dev/null | sed -n 's/.*inet \([0-9.\/]*\).*/\1/p' | head -n 1)"; nic="$nic $b${a:+=$a}"; done
echo "Network:${nic:- none}"
Q2FETCH_EOF
  chmod 755 $NR/usr/bin/q2fetch
  mkdir -p $NR/etc/systemd/system/multi-user.target.wants
  cat > $NR/etc/systemd/system/q2-fetch.service <<'UNIT'
[Unit]
Description=Quest 2 port: print system info to the kernel log
[Service]
Type=simple
ExecStart=/bin/sh -c 'sleep 25; ( (fastfetch -l none --pipe 2>/dev/null || /usr/bin/q2fetch) 2>&1 ) | while IFS= read -r l; do echo "q2-fetch: $l" > /dev/kmsg; done'
[Install]
WantedBy=multi-user.target
UNIT
  ln -sf ../q2-fetch.service $NR/etc/systemd/system/multi-user.target.wants/q2-fetch.service
  log "fixup: q2fetch installed (/usr/bin/q2fetch); output goes to the log ~25 s after boot"
fi

# 3b3. software desktop: Xvfb -> q2blit -> splash framebuffer (the msm_drm atomic path rejects Xorg), USB input via XTEST.
# Installs /usr/bin/{q2blit,q2input.py,q2desktop} and a service that starts it ~30 s after boot.  q2_desktop=0 disables it.
if [ "$ROOTMODE" = "rw" ] && [ "$(getarg q2_desktop)" != "0" ]; then
  mkdir -p $NR/etc/systemd/system/multi-user.target.wants
  cp /usr/bin/q2blit $NR/usr/bin/q2blit && chmod 755 $NR/usr/bin/q2blit
  cat > $NR/usr/bin/q2input.py <<'Q2INPUT_EOF'
#!/usr/bin/python3
# q2input - forward USB keyboard / mouse (evdev) into the Xvfb X server via XTEST.  Logs to the kernel log (q2-desk: input: ...).
import ctypes, glob, os, select, struct, sys, time

def log(m):
    try:
        with open('/dev/kmsg', 'w') as f:
            f.write('q2-desk: input: %s\n' % m)
    except Exception:
        pass

try:
    x11 = ctypes.CDLL('libX11.so.6')
    xt = ctypes.CDLL('libXtst.so.6')
except OSError as e:
    log('missing libX11/libXtst: %s' % e)
    sys.exit(1)

x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XFlush.argtypes = [ctypes.c_void_p]
xt.XTestFakeKeyEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
xt.XTestFakeButtonEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
xt.XTestFakeRelativeMotionEvent.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_ulong]

dpy = None
for _ in range(60):
    dpy = x11.XOpenDisplay(b':0')
    if dpy:
        break
    time.sleep(0.5)
if not dpy:
    log('cannot open display :0')
    sys.exit(1)
log('connected to :0')

BTN = {272: 1, 273: 3, 274: 2}   # BTN_LEFT/RIGHT/MIDDLE -> X buttons
EVSZ = struct.calcsize('<qqHHi')
fds = {}                          # fd -> name
logged = 0

def scan():
    for ev in glob.glob('/dev/input/event*'):
        base = os.path.basename(ev)
        try:
            real = os.path.realpath('/sys/class/input/%s/device' % base)
        except Exception:
            continue
        if 'usb' not in real or ev in fds.values():
            continue
        try:
            fd = os.open(ev, os.O_RDONLY | os.O_NONBLOCK)
        except OSError as e:
            log('cannot open %s: %s' % (ev, e))
            continue
        fds[fd] = ev
        log('using %s' % ev)

scan()
last_scan = time.time()
dx = dy = 0
while True:
    if time.time() - last_scan > 3:
        scan()
        last_scan = time.time()
    if not fds:
        time.sleep(0.5)
        continue
    r, _, _ = select.select(list(fds), [], [], 1.0)
    for fd in r:
        try:
            data = os.read(fd, EVSZ * 64)
        except OSError:
            os.close(fd)
            log('lost %s' % fds.pop(fd))
            continue
        for off in range(0, len(data) - EVSZ + 1, EVSZ):
            _s, _u, typ, code, val = struct.unpack_from('<qqHHi', data, off)
            if typ == 1:
                if code in BTN:
                    xt.XTestFakeButtonEvent(dpy, BTN[code], 1 if val else 0, 0)
                elif 0 < code < 256 and val in (0, 1):
                    xt.XTestFakeKeyEvent(dpy, code + 8, val, 0)
                    if val and logged < 12:
                        logged += 1
                        log('key code %d' % code)
            elif typ == 2:
                if code == 0:
                    dx += val
                elif code == 1:
                    dy += val
                elif code == 8 and val:
                    b = 4 if val > 0 else 5
                    for _ in range(abs(val)):
                        xt.XTestFakeButtonEvent(dpy, b, 1, 0)
                        xt.XTestFakeButtonEvent(dpy, b, 0, 0)
            elif typ == 0:
                if dx or dy:
                    xt.XTestFakeRelativeMotionEvent(dpy, dx, dy, 0)
                    dx = dy = 0
                x11.XFlush(dpy)
Q2INPUT_EOF
  chmod 755 $NR/usr/bin/q2input.py
  cat > $NR/usr/bin/q2desktop <<'Q2DESK_EOF'
#!/bin/sh
# q2desktop - software-rendered X desktop on the Quest 2 panel: Xvfb -> q2blit -> splash framebuffer, USB input via XTEST.
# Cmdline switches: q2_desktop=0 (off), q2_swap=0 (do not swap red/blue), q2_dmode=0 (one 3664x1920 canvas instead of a copy per eye)
L() { echo "q2-desk: $*" > /dev/kmsg; }
P() { while IFS= read -r l; do echo "q2-desk: $l" > /dev/kmsg; done; }
export HOME=/root XDG_RUNTIME_DIR=/run DISPLAY=:0 LANG=C.UTF-8
CMD=$(cat /proc/cmdline)
SWAP=bgr; case "$CMD" in *q2_swap=0*) SWAP=rgb;; esac
MODE=1;   case "$CMD" in *q2_dmode=0*) MODE=0;; esac
# Canvas size: the lenses only show the middle of each 1832x1920 eye image, so use a smaller desktop centred in each eye
# with black margins.  Tune from the kernel cmdline: q2_vw=1200 q2_vh=900 (size), q2_ox=/q2_oy= (offset inside the eye).
arg() { for w in $CMD; do case "$w" in $1=*) echo "${w#*=}";; esac; done | tail -n 1; }
VW=$(arg q2_vw); VH=$(arg q2_vh); OXA=$(arg q2_ox); OYA=$(arg q2_oy)
[ -n "$VW" ] || VW=1832; [ -n "$VH" ] || VH=1920
W=$VW; H=$VH; BLITARGS="-w $VW -h $VH -b 1060d0"
[ -n "$OXA" ] && BLITARGS="$BLITARGS -x $OXA"; [ -n "$OYA" ] && BLITARGS="$BLITARGS -y $OYA"
if [ "$MODE" = 0 ]; then W=3664; H=1920; BLITARGS=""; fi
case "$CMD" in *q2_full=1*) W=1832; H=1920; BLITARGS="";; esac
# lens pre-warp "virtual monitor" (default on for the stage-1 look); q2_warp=0 disables; q2_mon=<half-width tan x100> q2_tmax=<x100> q2_d=<lens decenter px>
if [ "$MODE" != 0 ] && [ -n "$BLITARGS" ] && [ "$(arg q2_warp)" != 0 ]; then
  BLITARGS="$BLITARGS -v"
  MONA=$(arg q2_mon); [ -z "$MONA" ] && MONA=95
  BLITARGS="$BLITARGS -s $MONA"
  [ -n "$(arg q2_tmax)" ] && BLITARGS="$BLITARGS -t $(arg q2_tmax)"
  [ -n "$(arg q2_d)" ] && BLITARGS="$BLITARGS -d $(arg q2_d)"
fi
L "starting desktop: Xvfb ${W}x${H}, blit mode $MODE ($BLITARGS), colors $SWAP"

