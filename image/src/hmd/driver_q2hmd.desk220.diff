+		__atomic_thread_fence(__ATOMIC_ACQUIRE);
+		if (__atomic_load_n(g_cpos, __ATOMIC_ACQUIRE) != s0) continue;
+		if (ver < 2 || c <= 0) return false;
+		for (int i = 0; i < 4; i++) q[i] = t[i]; for (int i = 0; i < 9; i++) A[i] = m[i]; *axis = (int)ax;
