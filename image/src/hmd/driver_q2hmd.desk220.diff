+		if (__atomic_load_n(g_ctl, __ATOMIC_ACQUIRE) != s0) continue;
+		if (c <= 0 || t[0] * t[0] + t[1] * t[1] + t[2] * t[2] + t[3] * t[3] < 0.5) return false;
+		for (int i = 0; i < 4; i++) q[i] = t[i];
