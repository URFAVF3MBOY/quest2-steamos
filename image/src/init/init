ConditionPathExists=/usr/bin/q2island-wait

[Service]
Type=simple
ExecStart=/usr/bin/q2island-wait
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
Q2ISLAND_TEST_UNIT
  ln -sf ../q2-island.service "$NR/etc/systemd/system/multi-user.target.wants/q2-island.service"
  log "desk-251: Meta tracking LIVE at boot (head + controllers from Meta, buttons by listen-only reader, faster start, our camera trackers held off, priority; 6DoF head pose + velocity; test mode: echo test > /var/lib/q2/island_mode; off: /var/lib/q2/island_off)"
fi

# desk-197: automatic, read-only tracking/camera diagnostics. This is deliberately passive:
# no SyncBoss commands, no camera streaming/ioctls, no Android mounts, no writes to /persist.
mkdir -p "$NR/usr/bin" "$NR/etc/systemd/system/multi-user.target.wants"
cat > "$NR/usr/bin/q2trackingdiag" <<'Q2TRACKDIAG_EOF'
#!/bin/sh
# Automatic tracking diagnostic for the Quest 2 SteamOS port.
# One camera inventory, then passive snapshots so the user needn't type long commands.
# Ctrl+Alt+U exports /var/log/q2/*.txt via the existing Q2LOGS collector.
set +e
mkdir -p /var/log/q2
OUT=/var/log/q2/tracking-bootdiag.txt
exec >>"$OUT" 2>&1
section() { printf '\n\n========== %s ==========' "$*"; printf '\n'; }
snap() {
    section "snapshot $*"
    date -Is 2>/dev/null || date
    printf 'kernel: '; uname -a
    printf 'cmdline: '; cat /proc/cmdline 2>/dev/null
    printf '\n-- systemd service state --\n'
    for u in q2-headtrack.service q2-vr.service q2-kmsd.service q2-desktop.service; do
        echo "[$u]"
        systemctl show "$u" -p LoadState -p ActiveState -p SubState -p MainPID -p ExecMainStatus -p Result -p ExecStart 2>&1
    done
    echo '[failed units]'
    systemctl --failed --no-pager 2>&1 | head -n 50
    printf '\n-- tracking / VR processes --\n'
    ps -eo pid,ppid,stat,etimes,wchan:24,args 2>&1 | grep -E '[q]2vrd|[q]2headtrack|[q]2vrtest|[v]rserver|[v]rcompositor|[q]2kms|[s]ensorproxy|[t]rackingservice|[s]yncboss|[c]amera' | head -n 120
    printf '\n-- device nodes (listing only) --\n'
    for d in /dev/syncboss* /dev/cam_fp_ife*_q /dev/media* /dev/video* /dev/v4l-subdev*; do
        [ -e "$d" ] && ls -ln "$d" 2>&1
    done
    printf '\n-- SyncBoss control state (read-only sysfs attributes only) --\n'
    for f in /sys/devices/virtual/misc/syncboss0/spi/control/streaming /sys/devices/virtual/misc/syncboss0/spi/control/stats /sys/devices/virtual/misc/syncboss0/spi/control/transaction_length /sys/devices/virtual/misc/syncboss0/spi/control/transaction_period_us /sys/devices/virtual/misc/syncboss0/spi/control/minimum_time_between_transactions_us; do
        [ -r "$f" ] && { echo "[$f]"; cat "$f" 2>&1; }
    done
    printf '\n-- recent relevant kernel messages --\n'
    dmesg 2>&1 | grep -Ei 'syncboss|oculusnrf|cam_fp|camera|cam_req|cam_sensor|cam_isp|csiphy|csid|\bife\b|v4l2|icm42688|imu|q2-head|q2-vr' | tail -n 220
    printf '\n-- tracker log tails, if present --\n'
    for f in /var/log/q2/vrlogs/headtrack.txt /var/log/q2/vr-headtrack.txt /var/log/q2/headtrack.txt /var/log/q2/vrserver.txt; do
        [ -f "$f" ] && { echo "[$f]"; tail -n 80 "$f"; }
    done
    printf '\n-- shared pose/controller buffers (metadata + first bytes only) --\n'
    for f in /dev/shm/q2pose /dev/shm/q2ctl; do
        [ -e "$f" ] && { stat "$f" 2>&1; od -An -tx1 -N80 "$f" 2>&1; }
    done
    printf '\n-- current gyro bias (read-only) --\n'
    [ -f /var/lib/q2/gyrobias ] && cat /var/lib/q2/gyrobias
}
section 'diagnostic started; passive only'
echo 'desk-198: q2-headtrack.service owns SyncBoss from boot; this diagnostic is passive and does not start a second reader or write to /persist.'
sleep 25
section 'one-time camera inventory'
if [ -x /usr/bin/q2caminfo ]; then
    /usr/bin/q2caminfo
    echo "q2caminfo exit=$?; report=/var/log/q2/camera-inventory.txt"
else
    echo 'q2caminfo is unavailable'
fi
snap 'initial (~25 s after boot)'
# Passive sampler observes the independent q2-headtrack.service with or without SteamVR.
i=1
while [ "$i" -le 5 ]; do
    sleep 45
    snap "follow-up $i (~$((25 + i * 45)) s after boot)"
    i=$((i + 1))
done
section 'diagnostic finished'
echo 'Use Ctrl+Alt+U to export reports including /var/log/q2/vr-headtrack.txt. Tracker runs independently of SteamVR.'
exit 0
Q2TRACKDIAG_EOF
chmod 755 "$NR/usr/bin/q2trackingdiag"
cat > "$NR/etc/systemd/system/q2-tracking-diag.service" <<'Q2TRACKDIAG_UNIT'
[Unit]
Description=Quest 2 port: passive tracking and camera diagnostic snapshot
After=q2-vr.service

[Service]
Type=oneshot
ExecStart=/usr/bin/q2trackingdiag
TimeoutStartSec=420
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
Q2TRACKDIAG_UNIT
rm -f "$NR/etc/systemd/system/multi-user.target.wants/q2-tracking-diag.service"; rm -f "$NR/var/log/q2/tracking-bootdiag.txt"   # desk-228: off (8 MB of passive snapshots)
log "desk-198: installed independent q2-headtrack.service, Steam/VR suppressed by default, passive diagnostics export with Ctrl+Alt+U"

# desk-255: boot slim-down.  Meta's tracker does head + controllers now, so our own camera trackers (4 cameras at 60 fps
# + LED tracking, ~1.5 CPU cores until Meta's tracker took over) no longer start at boot, and finished one-time tests
# and recorders from older images are switched off.  Units stay installed (sudo systemctl start <name> still works).
W="$NR/etc/systemd/system/multi-user.target.wants"
for u in q2-camd q2-ctltrack q2-stockcam q2-stockcam2 q2-islandprobe q2-gpucheck q2-vrpaneltest q2-perf q2-tracking-diag \
         q2-blobs q2-camlive q2-camtpg q2-camframe q2-camframe2 q2-imgcheck q2-fetch; do
  [ -e "$W/$u.service" ] || [ -L "$W/$u.service" ] && { rm -f "$W/$u.service"; log "desk-255: $u no longer starts at boot"; }
done
# desk-256: Lepton (Valve's Android layer: VRChat etc.) runs Android in rootless podman.  Kernel 4.19 cannot mount
# overlayfs inside a user namespace (that came in 5.11): every podman command failed with "kernel does not support
# overlay fs: unable to create kernel-style whiteout" and the app never started.  podman storage for the steamos user:
# fuse-overlayfs if the system has it, otherwise the plain "vfs" driver (no overlay needed; uses more disk).
PH="$NR/home/steamos"
if [ -d "$PH" ]; then
  mkdir -p "$PH/.config/containers"
  # desk-257: our own fuse-overlayfs (CI build-fuse-overlayfs) - with vfs alone, Lepton's rootfs overlay ("--rootfs ...:O")
  # still needed a kernel overlay mount and failed ("rootfs-overlay: creating overlay failed ... operation not permitted")
  if [ -f /usr/share/q2fuse/fuse-overlayfs ]; then mkdir -p "$NR/usr/local/bin"; cp /usr/share/q2fuse/fuse-overlayfs "$NR/usr/local/bin/fuse-overlayfs"; chmod 755 "$NR/usr/local/bin/fuse-overlayfs"; fi
  FOV=""; for c in /usr/bin/fuse-overlayfs /usr/local/bin/fuse-overlayfs; do [ -x "$NR$c" ] && FOV=$c; done
  if [ -n "$FOV" ] && [ -e /dev/fuse ]; then PDRV=fuse-overlayfs-c1   # desk-258: C 1.x (new name = storage cleared once)
    printf '[storage]\ndriver = "overlay"\n\n[storage.options.overlay]\nmount_program = "%s"\n' "$FOV" > "$PH/.config/containers/storage.conf"
  else PDRV=vfs
    printf '[storage]\ndriver = "vfs"\n' > "$PH/.config/containers/storage.conf"
  fi
  # desk-259: crun asked the user's systemd (over D-Bus) for the container's cgroup ("sd-bus call: Process
  # org.freedesktop.systemd1 exited with status 1") - Steam runs under runuser + dbus-run-session, with no systemd --user.
  # Plain cgroupfs instead, events and container logs to files (no journald / user-systemd needed).
  # desk-260: rootless networking (pasta) could not create its tap device ("TUNSETIFF ioctl on /dev/net/tun failed:
  # Operation not permitted") -> the container shares the headset's network instead (netns = "host").  This kernel also
  # has Android's "paranoid network": only members of group 3003 (aid_inet) may open internet sockets, and container
  # processes normally lose the steamos user's extra groups -> keep them (crun annotation run.oci.keep_original_groups).
  # desk-263: the real GPU (KGSL) for Android apps.  Lepton bind-mounts renderD128 (on the Quest the display driver) at
  # /dev/kgsl-3d0, so the KGSL device goes in as /dev/q2kgsl (the Quest's Android Turnip opens that first), with ION and
  # the dma-heaps Turnip allocates shareable memory from.
  CDEV='"/dev/kgsl-3d0:/dev/q2kgsl:rwm"'; [ -e /dev/ion ] && CDEV="$CDEV, \"/dev/ion:/dev/ion:rwm\""
  for h in /dev/dma_heap/*; do [ -e "$h" ] && CDEV="$CDEV, \"$h:$h:rwm\""; done
  # desk-272: Android 11 opens shared memory at /dev/ashmem<boot id> (its ueventd makes that name; Lepton's container has
  # none) -> "ashmem creation failed", system_server died.  The Quest's ashmem goes in under both names.
  BID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
  [ -e /dev/ashmem ] && CDEV="$CDEV, \"/dev/ashmem:/dev/ashmem:rwm\"" && [ -n "$BID" ] && CDEV="$CDEV, \"/dev/ashmem:/dev/ashmem$BID:rwm\""
  printf '[engine]\ncgroup_manager = "cgroupfs"\nevents_logger = "file"\n\n[containers]\nlog_driver = "k8s-file"\nnetns = "host"\nannotations = ["run.oci.keep_original_groups=1"]\ndevices = [%s]\n' "$CDEV" > "$PH/.config/containers/containers.conf"
  log "desk-263: devices for Android containers: $CDEV"
  # storage made with the failing overlay driver cannot be reused with another driver: start it fresh once
  if [ "$(cat "$NR/var/lib/q2/podman-driver" 2>/dev/null)" != "$PDRV" ]; then
    rm -rf "$PH/.local/share/containers/storage"; echo "$PDRV" > "$NR/var/lib/q2/podman-driver"
    log "desk-256: podman (Lepton / Android apps) storage driver set to $PDRV (old storage cleared)"
  fi
  chown -R 1000:1000 "$PH/.config/containers" 2>/dev/null
fi
# desk-263: the Quest's Android GPU files (CI build-q2gpu-android: the same patched Mesa as /opt/q2gpu, built for Android).
# Lepton bind-mounts Valve's Android Mesa from /usr/share/guestos/android/vendor into every container; those files are
# made for the Steam Frame's GPU driver.  The Quest's versions replace them; the originals are kept as *.valve.
GV="$NR/usr/share/guestos/android/vendor"
if [ -f /usr/share/q2gpu-android.tar.gz ] && [ -d "$GV" ] && [ ! -e /var/lib/q2/android_gpu_off ] && [ ! -e "$NR/var/lib/q2/android_gpu_off" ]; then
  rm -rf /tmp/q2ga; mkdir -p /tmp/q2ga && tar -xzf /usr/share/q2gpu-android.tar.gz -C /tmp/q2ga
  n=0; for f in $(cd /tmp/q2ga/vendor && find . -type f -name '*.so'); do
    d="$GV/${f#./}"; mkdir -p "$(dirname "$d")"
    [ -e "$d" ] && [ ! -e "$d.valve" ] && cp -a "$d" "$d.valve"
    cp /tmp/q2ga/vendor/$f "$d" && chmod 644 "$d" && n=$((n+1))
  done
  date > "$GV/.q2gpu"
  rm -rf /tmp/q2ga; log "desk-263: Quest Android GPU files installed into /usr/share/guestos ($n files, originals kept as *.valve)"
elif [ -d "$GV" ]; then
  for o in $(find "$GV" -name '*.valve' 2>/dev/null); do mv -f "$o" "${o%.valve}"; done; rm -f "$GV/.q2gpu"
  log "desk-263: Valve's Android GPU files in use (no q2gpu-android.tar.gz in this image, or android_gpu_off)"
fi
# desk-265: GPU priority lanes for every program (KGSL ring buffers; the patched Turnip reads TU_KGSL_PRIO).  Ordinary
# work (MEDIUM) goes to ring 1, so SteamVR's compositor (HIGH/REALTIME on ring 0) can interrupt it to make its frame
# deadline - desk-263: everything shared ring 0, the compositor waited behind Steam's UI and dropped ~36% of frames.
GP=$(cat "$NR/var/lib/q2/tuprio" 2>/dev/null | tr -cd '0-9,' | head -c 20); GP=${GP:-1,1,5,9}
mkdir -p "$NR/etc/systemd/system.conf.d" "$NR/etc/systemd/user.conf.d"
for c in system user; do printf '[Manager]\nDefaultEnvironment="TU_KGSL_PRIO=%s"\n' "$GP" > "$NR/etc/systemd/$c.conf.d/q2-gpuprio.conf"; done
log "desk-265: GPU priority lanes TU_KGSL_PRIO=$GP for all programs (compositor preempts the rest)"
# desk-264: two small edits to Lepton's own scripts (Steam's Lepton folder; re-applied every boot, originals kept as
# *.q2orig, undone with /var/lib/q2/lepton_nopatch):
#  1. mounting.sh gives Android the host's renderD128 as /dev/kgsl-3d0 (on the Steam Frame that node is the GPU).  On the
#     Quest renderD128 is the display driver and the GPU is the real /dev/kgsl-3d0 -> mount the real one.
#  2. properties.sh picks the "minigbm_msm" graphics-memory driver (needs the Frame's msm GPU driver: "failed to open
#     gralloc0 device").  With the Quest's Android GPU files installed it picks "minigbm_gbm_mesa" (already in Lepton's
#     image), which allocates through Mesa's GBM -> zink -> Turnip on KGSL, the same path SteamOS itself uses.
LL="$NR/home/steamos/.local/share/Steam/steamapps/common/Lepton/liblepton"
if [ -f "$LL/mounting.sh" ]; then
  for f in mounting.sh properties.sh; do
    if [ -f "$LL/$f.q2orig" ]; then
      # Lepton updated by Steam since the last boot -> new original; otherwise start from the saved original
      grep -q 'q2:' "$LL/$f" || cp -a "$LL/$f" "$LL/$f.q2orig"
      cp -a "$LL/$f.q2orig" "$LL/$f"
    else cp -a "$LL/$f" "$LL/$f.q2orig"; fi
  done
  if [ ! -e "$NR/var/lib/q2/lepton_nopatch" ]; then
    LP=""
    if grep -q 'podman_mount_entry "/dev/dri/renderD128" "/dev/kgsl-3d0" rw' "$LL/mounting.sh"; then
      sed -i 's|^\( *\)podman_mount_entry "/dev/dri/renderD128" "/dev/kgsl-3d0" rw|\1if [[ -e /dev/kgsl-3d0 ]]; then podman_mount_entry "/dev/kgsl-3d0" "/dev/kgsl-3d0" rw; else podman_mount_entry "/dev/dri/renderD128" "/dev/kgsl-3d0" rw; fi  # q2: real KGSL on the Quest|' "$LL/mounting.sh" && LP="$LP real-kgsl"
    fi
    # desk-278 TEST: the Android container shares SteamOS's network namespace, so Android's SteamVR client can reach the
    # SteamVR server's abstract socket (/steamvr/SteamVR_Namespace; desk-277: "Unable to connect to pipe errno=111").
    # Off: sudo touch /var/lib/q2/lepton_pasta
    for f in networking.sh; do [ -f "$LL/$f.q2orig" ] || cp -a "$LL/$f" "$LL/$f.q2orig"; grep -q 'q2:' "$LL/$f" && cp -a "$LL/$f.q2orig" "$LL/$f"; done
    # desk-281: decided at each launch - separate network (pasta) until the app has started once (Lepton installs over adb
    # through pasta's port forward; on the shared network the install hung, desk-279), shared network after that.
    # q2leptonlog writes /var/lib/q2/lepton_installed when Android starts the app.  Always separate: /var/lib/q2/lepton_pasta
    if grep -q 'print "--network=pasta:' "$LL/networking.sh"; then
      sed -i 's|^\( *\)print "--network=pasta:\(.*\)"$|\1if [[ -e /var/lib/q2/lepton_installed \&\& ! -e /var/lib/q2/lepton_pasta ]]; then print "--network=host"; else print "--network=pasta:\2"; fi  # q2: shared network once installed|' "$LL/networking.sh" && LP="$LP net-auto"
    fi
    # desk-280: keep VRChat's prepared install when a run ends early (Lepton deletes it after every early exit -> each test
    # reinstalled the 327 MB app).  Lepton's own LEPTON_NO_CLEANUP switch, on by default here; off: /var/lib/q2/lepton_cleanup
    for f in liblepton.sh; do [ -f "$LL/$f.q2orig" ] || cp -a "$LL/$f" "$LL/$f.q2orig"; grep -q 'q2:' "$LL/$f" && cp -a "$LL/$f.q2orig" "$LL/$f"; done
    if [ ! -e "$NR/var/lib/q2/lepton_cleanup" ] && grep -q 'LEPTON_NO_CLEANUP:-false}' "$LL/liblepton.sh"; then
      sed -i 's/LEPTON_NO_CLEANUP:-false}/LEPTON_NO_CLEANUP:-true}/' "$LL/liblepton.sh" && echo "# q2: LEPTON_NO_CLEANUP default true (desk-280)" >> "$LL/liblepton.sh" && LP="$LP keep-install"
    fi
    # desk-276: Android's first boot on the Quest takes ~3 min (it also prepares the 327 MB VRChat app); Lepton gave the
    # app 60 s to appear, so VRChat never showed.  5 min instead (LEPTON_APP_LAUNCH_TIMEOUT still overrides).
    if grep -q 'LEPTON_APP_LAUNCH_TIMEOUT:-60}' "$LL/properties.sh"; then
      sed -i 's/LEPTON_APP_LAUNCH_TIMEOUT:-60}/LEPTON_APP_LAUNCH_TIMEOUT:-300}/' "$LL/properties.sh" && LP="$LP launch-300s"
    fi
    # desk-274: ION + ashmem (also as /dev/ashmem<boot id>, the name Android 11 opens) right after the KGSL mount, whatever
    # form that line has (a hand-edited mounting.sh broke desk-273's anchor)
    if ! grep -q 'q2: ashmem' "$LL/mounting.sh" && grep -q 'podman_mount_entry "/dev/kgsl-3d0" "/dev/kgsl-3d0" rw' "$LL/mounting.sh"; then
      awk '{print} /podman_mount_entry "\/dev\/kgsl-3d0" "\/dev\/kgsl-3d0" rw/ && !d {d=1
        print "        [[ -e /dev/ion ]] && podman_mount_entry \"/dev/ion\" \"/dev/ion\" rw  # q2: ion"
        print "        podman_cmdline --security-opt unmask=/proc/sys  # q2: Android sets its own network sysctls (desk-277: read-only /proc/sys -> Ethernet setup restarted ~1500x/min, load 19, headset froze)"
        print "        if [[ -e /dev/ashmem ]]; then podman_mount_entry \"/dev/ashmem\" \"/dev/ashmem\" rw; podman_mount_entry \"/dev/ashmem\" \"/dev/ashmem$(cat /proc/sys/kernel/random/boot_id)\" rw; fi  # q2: ashmem"}' \
        "$LL/mounting.sh" > "$LL/mounting.sh.q2tmp" && mv "$LL/mounting.sh.q2tmp" "$LL/mounting.sh" && chmod 755 "$LL/mounting.sh" && LP="$LP ion+ashmem"
    fi
    if [ -f "$NR/usr/share/guestos/android/vendor/.q2gpu" ] && grep -q 'props_echo "ro.hardware.gralloc=minigbm_msm"' "$LL/properties.sh"; then
      sed -i 's|props_echo "ro.hardware.gralloc=minigbm_msm"|props_echo "ro.hardware.gralloc=minigbm_gbm_mesa"  # q2: GBM (zink/Turnip-KGSL) graphics memory|' "$LL/properties.sh" && LP="$LP gralloc-gbm_mesa"
    fi
    # desk-268: with gbm_mesa, the Frame's allocator@4.0 (minigbm_msm) stays listed but never starts -> surfaceflinger waited
    # for it forever and Android stopped after ~80 s.  Lepton's own functions take it out (clients fall back to 2.0).
    if [ -f "$NR/usr/share/guestos/android/vendor/.q2gpu" ] && grep -q '^            disable_qti_display$' "$LL/mounting.sh"; then
      sed -i 's|^            disable_qti_display$|            disable_qti_display; disable_default_allocator  # q2: allocator 2.0 (gbm_mesa) only|' "$LL/mounting.sh" && LP="$LP no-allocator4"
    fi
    chown 1000:1000 "$LL"/*.sh 2>/dev/null
    log "desk-264: Lepton script edits:${LP:- none (lines not found - Lepton changed?)}"
  else log "desk-264: Lepton script edits off (/var/lib/q2/lepton_nopatch)"; fi
fi
# desk-262: Android's own log from inside Lepton's container.  desk-261 booted Android (networking worked) and the
# container stopped while VRChat.apk was being installed ("transaction failed 29189/-22" = a binder call to a service
# that was gone, then cmd and surfaceflinger aborted) - only Android's logcat says why.  While a lepton-* container
# runs, its logcat is streamed to /var/log/q2/lepton/; the last ~1.9 MB (and an errors-only copy) go to
# /var/log/q2/lepton-logcat.txt / lepton-errors.txt; when it stops, "podman logs" + "podman inspect" are saved and the
# logs are handed to the PC by themselves (Ctrl+Alt+U), once per boot.  Off: /var/lib/q2/lepton_nolog, no PC: lepton_nopc
cat > "$NR/usr/bin/q2leptonlog" <<'Q2LEPTONLOG'
#!/bin/bash
D=/var/log/q2/lepton; mkdir -p $D
# desk-279: with the container on SteamOS's network (desk-278 test) podman passes in the host /sys, and rootless crun could
# not re-open the root-only BPF mount ("cannot reopen sys/fs/bpf: Permission denied").  Readable by all (listing only).
[ -e /var/lib/q2/lepton_pasta ] || { mount -o remount,mode=0755 /sys/fs/bpf 2>/dev/null; chmod 755 /sys/fs/bpf 2>/dev/null; }
P() { runuser -u steamos -- env XDG_RUNTIME_DIR=/run/user/1000 timeout 30 podman "$@"; }
log() { echo "$(date +%T) $*" >> $D/watch.txt; }
declare -A SP; SENT=0
while :; do
  [ -e /var/lib/q2/lepton_nolog ] && exit 0
  # cheap check (no podman call): each running container has a conmon process with "-n <name>"
  RUNNING=$(pgrep -a conmon 2>/dev/null | grep -o -E ' -n lepton-[^ ]+' | cut -c5- | sort -u)
  for c in $RUNNING; do
    if [ -z "${SP[$c]}" ] || ! kill -0 ${SP[$c]} 2>/dev/null; then
      [ -n "${SP[$c]}" ] && sleep 3   # logcat ended early (Android's log service not up yet): try again shortly
      log "$c running - streaming its logcat"
      CX=$(ls -dt /tmp/lepton-context.* 2>/dev/null | head -n 1); [ -n "$CX" ] && tar -czf /var/log/q2/lepton-context.bin -C "$CX" . 2>/dev/null
      ( P exec "$c" /system/bin/logcat -v threadtime -b main,system,crash 2>&1 | head -c 200000000 >> $D/$c-logcat.log ) &
      SP[$c]=$!
    fi
    # desk-281: the app has started once -> installed (the next launch uses the shared network)
    if [ ! -e /var/lib/q2/lepton_installed ] && grep -a -q -E "Start proc [0-9]+:com\.vrchat\.android" $D/$c-logcat.log 2>/dev/null; then
      date > /var/lib/q2/lepton_installed; chmod 644 /var/lib/q2/lepton_installed; log "$c: app started once - next launch uses the shared network"
    fi
    for f in $D/$c-logcat.log; do
      tail -c 1900000 $f > /var/log/q2/lepton-logcat.txt 2>/dev/null
      grep -a -E ' [EFW] |AndroidRuntime|DEBUG  |libc    |PackageManager|installd|servicemanager|dex2oat|lowmemorykiller|Abort|FATAL' $f | tail -c 1900000 > /var/log/q2/lepton-errors.txt 2>/dev/null
    done
  done
  # desk-276: the Android container at low CPU priority, so SteamVR, the compositor and the tracker keep the CPU (desk-275:
  # load 19 on 8 cores, 90 C, the headset froze while Android booted and prepared VRChat)
  if [ -n "$RUNNING" ] && [ $(( $(date +%s) % 10 )) -lt 2 ]; then
    for c in $RUNNING; do
      CP=$(pgrep -f "conmon .*-n $c" | head -n 1); [ -n "$CP" ] || continue
      ps -eo pid=,ppid= | awk -v r=$CP '{p[$1]=$2} END{for(i in p){j=i; while(j in p && j!=r && j>1) j=p[j]; if(j==r && i!=r) print i}}' | xargs -r renice -n 15 -p >/dev/null 2>&1
    done
  fi
  for c in "${!SP[@]}"; do
    echo "$RUNNING" | grep -qx "$c" && continue
    log "$c stopped"
    sleep 1; kill ${SP[$c]} 2>/dev/null; unset "SP[$c]"
