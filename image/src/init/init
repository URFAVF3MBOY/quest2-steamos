#!/bin/bash
# desk-290: keep Steam's UI off the cores SteamVR's compositor uses.  With the big dashboard open, Steam's web UI
# compositor thread runs a whole core flat out (desk-286..289 profiles); the compositor's render thread needs ~0.75 core.
# Steam (client + web UI) -> CPUs 0-5 (same priority as before); vrcompositor -> CPUs 6-7 (the two fastest cores).  Re-applied every 5 s
# (new threads/processes).  Off: /var/lib/q2/noaffinity
STEAMCPUS=${STEAMCPUS:-0-5}; COMPCPUS=${COMPCPUS:-6-7}
while :; do
  [ -e /var/lib/q2/noaffinity ] && exit 0
  for p in $(pgrep -x vrcompositor); do taskset -a -c -p $COMPCPUS $p >/dev/null 2>&1; done
  for p in $(pgrep -f 'steamrtarm64/steam( |$)'); do taskset -a -c -p $STEAMCPUS $p >/dev/null 2>&1; done
  # desk-297: Steam's web UI on CPUs 2-6 - what Valve's own ARM64 steamwebhelper.sh does (taskset 0x7c)
  for p in $(pgrep -f 'steamrtarm64/steamwebhelper'); do taskset -a -c -p ${WEBCPUS:-2-6} $p >/dev/null 2>&1; done
  # desk-297: which OpenGL/Vulkan driver each Steam web process really loaded (llvmpipe = software) -> log, once per set
  W=$(pgrep -f 'steamrtarm64/steamwebhelper' | sort -n | tr '\n' ' ')
  if [ -n "$W" ] && [ "$W" != "$WLAST" ] && pgrep -x vrcompositor >/dev/null; then
    sleep 20
    { echo "== $(date +%T) Steam web processes - graphics libraries loaded"
      for p in $(pgrep -f 'steamrtarm64/steamwebhelper'); do
        t=$(tr '\0' '\n' < /proc/$p/cmdline 2>/dev/null | grep -o -- '--type=[a-z-]*' | head -1); [ -n "$t" ] || t="(browser, draws the VR panels)"
        libs=$(grep -o -E '[^/ ]*(gallium|swrast|llvmpipe|zink|vulkan_freedreno|libGLX_mesa|libEGL_mesa|libGLESv2|libvulkan)[^/ ]*\.so[^ ]*' /proc/$p/maps 2>/dev/null | sort -u | tr '\n' ' ')
        env=$(tr '\0' '\n' < /proc/$p/environ 2>/dev/null | grep -E '^(GALLIUM_DRIVER|MESA_LOADER_DRIVER_OVERRIDE|LIBGL_ALWAYS_SOFTWARE|MESA_VK_WSI_DEBUG|LIBGL_DRIVERS_PATH)=' | tr '\n' ' ')
        echo "pid $p $t: $libs | $env"
      done; } >> /var/log/q2/steam-gllibs.txt 2>&1
    WLAST=$W
  fi
  # desk-296: the thread that draws Steam's UI (Chromium's VizCompositorThread and the GPU process main thread) runs one
  # core flat out while a panel animates and delivered ~2-4 panel frames/s on hover animations: it goes to the big cores
  # 4-6 only (the little cores 0-3 are about 3x slower).  Core 6 is shared with SteamVR's compositor (now ~6.3 ms/frame).
  for p in $(pgrep -f 'steamwebhelper.*type=gpu-process'); do
    for t in /proc/$p/task/*; do case "$(cat $t/comm 2>/dev/null)" in VizCompositorTh|steamwebhelper*|CrGpuMain) taskset -c -p ${UICPUS:-4-6} ${t##*/} >/dev/null 2>&1;; esac; done
  done
  sleep 5
done
