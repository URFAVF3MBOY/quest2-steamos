                cands = [os.path.join(root, tgt)] if not tgt.startswith('/') else [mp + tgt[len('/vendor'):] if tgt.startswith('/vendor/') else mp + tgt]
                real = next((c for c in cands if os.path.isfile(c)), None)
                if not real:
                    miss.append('%s->%s' % (fn, tgt)); continue
            try:
                shutil.copyfile(real, os.path.join(dst, rel, fn)); n += 1
            except Exception as e:
                miss.append('%s(%s)' % (fn, e.__class__.__name__))
    return n, miss

def mount_scan(dev, label, offset=None, size=None):
    """mount dev (or a loop of it) read-only, list firmware, copy any a650 files.  Returns number of files copied."""
    lo = None
    if offset is not None:
        rc, lo = sh('losetup', '-f', '--show', '-r', '-o', str(offset), '--sizelimit', str(size), dev)
        if rc:
            log('%s: losetup failed %s' % (label, lo)); return 0
        dev = lo
    mp = '/mnt/q2scan'
    os.makedirs(mp, exist_ok=True)
    ok = None; errs = []
    for t in ('ext4', 'erofs', 'vfat', 'f2fs', 'squashfs'):
        rc, out = sh('mount', '-o', 'ro,noload' if t == 'ext4' else 'ro', '-t', t, dev, mp)
        if rc == 0:
            ok = t; break
        errs.append('%s:%s' % (t, out.split('\n')[-1][-40:]))
    if not ok:
        log('%s: no fs mounted (%s)' % (label, ' '.join(errs))); 
        if lo: sh('losetup', '-d', lo)
        return 0
    log('%s: mounted as %s' % (label, ok))
    for sub in ('firmware', 'image', 'vendor/firmware', 'etc'):
        pth = mp + '/' + sub
        if os.path.isdir(pth):
            logl('%s/%s: ' % (label, sub), ' '.join(sorted(os.listdir(pth))))
    logl('%s top: ' % label, ' '.join(sorted(os.listdir(mp))), 200)
    # stock thermal policy (Android thermal HAL config), for comparing our limits with stock - read-only copy
    for tc in ():
        if os.path.isfile(mp + '/' + tc):
            try:
                os.makedirs('/var/log/q2', exist_ok=True)
                shutil.copyfile(mp + '/' + tc, '/var/log/q2/stock-' + os.path.basename(tc) + '.txt')
                log('%s: copied %s for reference' % (label, tc))
            except Exception as e:
                log('%s: %s copy failed: %s' % (label, tc, e))
    hits = find_hits(mp)
    logl('%s found: ' % label, ' '.join('%s(%d)' % (h.replace(mp, ''), os.path.getsize(h)) for h in hits))
    if any('zap' in h.lower() for h in hits):
