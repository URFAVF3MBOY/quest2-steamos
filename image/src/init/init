#!/bin/sh
# Quest 2 -> SteamOS first-light init (PID 1).
#   1. show the kernel log on the headset display (qscreen -k)
#   2. switch the USB-C port to host mode and wait for the SteamOS drive
#      (MBR disk signature 0x20262026 = PARTUUID 20262026-01, written by steamos_fetch.py)
#   3. mount Valve's btrfs rootfs read-only, put a RAM overlay on top, switch_root to systemd
#   If anything fails: switch the port back to device mode and offer the USB serial shell
#   (same as the RAM-only image) so the failure can be read.

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
export TERM=xterm-256color

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /run /tmp /root /mnt/rootfs /mnt/ov /mnt/newroot
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
hostname quest2

log() { echo "q2-init: $*" > /dev/kmsg 2>/dev/null; echo "q2-init: $*"; }
getarg() { for w in $(cat /proc/cmdline); do case "$w" in "$1="*) echo "${w#*=}"; return 0;; esac; done; return 1; }

M=/sys/devices/platform/soc/a600000.ssusb/mode
ROT="$(getarg qs_rot)"; [ -n "$ROT" ] || ROT=0
WANT_SIG="26202620"   # bytes of 0x20262026 at MBR offset 440 (little-endian, palindromic)
WAIT="$(getarg q2_wait)"; [ -n "$WAIT" ] || WAIT=120
OVSIZE="$(getarg q2_ovsize)"; [ -n "$OVSIZE" ] || OVSIZE=2g

log "SteamOS init rev=desk-317, variant=tracking-camera-constellation3-headsmooth-metactl7-steamkey-gamelinks3-q2gpu2-steamvrgs1-autostart-slim-lepton5-fastpc-netk-alog-agpu-lpatch-gpuprio-andgpu-faststart-alloc2-tiled2-gbm-ashmem3-nosdcardfs-lowprio-sysctl-hostnet2-keep-netauto-dash90off-notrace-vrprof5-affinity-steamprio-binsem2-cefgpu2-uibig-rbstat-web26-noswgl-buttons3-vkui-frameid-match-smallwin-keepprev-gamewrap2-gsopenvr2-kwinwsi2-protonlog3-pcreq-ucrtrepair-rubyfix-nullsink, kernel $(uname -r), qs_rot=$ROT wait=${WAIT}s"

serial_shell() {
  log "FALLBACK: switching USB back to device mode, serial shell on ttyGS0"
  echo peripheral > "$M" 2>/dev/null
  mount -t configfs none /sys/kernel/config 2>/dev/null
  UDC=""; i=0
  while [ $i -lt 30 ]; do UDC="$(ls /sys/class/udc 2>/dev/null | head -n 1)"; [ -n "$UDC" ] && break; i=$((i+1)); sleep 1; done
  G=/sys/kernel/config/usb_gadget/g1
  mkdir -p "$G"
  echo 0x1d6b > "$G/idVendor"; echo 0x0104 > "$G/idProduct"; echo 0x0200 > "$G/bcdUSB"; echo 0x02 > "$G/bDeviceClass"
  mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" "$G/functions/acm.usb0"
  echo "q2-steamos" > "$G/strings/0x409/serialnumber"
  echo "Quest 2 serial console" > "$G/strings/0x409/product"
  echo ACM > "$G/configs/c.1/strings/0x409/configuration"
  ln -s "$G/functions/acm.usb0" "$G/configs/c.1/" 2>/dev/null
  echo "$UDC" > "$G/UDC" 2>/dev/null
  while true; do
    if [ -c /dev/ttyGS0 ]; then getty -L -n -l /bin/bash 115200 ttyGS0 xterm-256color; else sleep 2; fi
  done
}

fail() { log "ERROR: $*"; dmesg | tail -n 25 > /dev/kmsg 2>/dev/null; sleep 5; serial_shell; }

# 1. display
if [ -x /usr/bin/qscreen ]; then
  # default: draw straight into the bootloader's splash framebuffer (-S); qs_drm=1 uses the DRM driver instead
  if [ "$(getarg qs_drm)" = "1" ]; then QSMODE=""; else QSMODE="-S"; fi
  /usr/bin/qscreen $QSMODE -r "$ROT" -k > /run/qscreen.log 2>&1 &
  n=0; while [ $n -lt 30 ] && [ ! -s /run/qscreen.log ]; do sleep 0.1; n=$((n+1)); done   # was a fixed 3 s
  while read -r l; do log "qscreen: $l"; done < /run/qscreen.log
else
  log "no qscreen binary; display log disabled"
fi

# 2. USB host + find the drive
log "switching USB port to host mode"
echo host > "$M" 2>/dev/null || log "writing $M failed"

find_root() {
  # q2_rootdev=userdata: SteamOS lives on the internal "userdata" partition (installed with q2install); the USB drive,
  # if present, is only used for the persistent log.
  if [ "$(getarg q2_rootdev)" = "userdata" ]; then
    for u in /sys/class/block/*/uevent; do
      grep -qx "PARTNAME=userdata" "$u" 2>/dev/null || continue
      d="$(dirname "$u")"; case "$(readlink -f "$d")" in *usb*) continue ;; esac
      k=0; KMAX=1; [ "$(getarg q2_logdisk)" = 1 ] && KMAX=10   # a USB log drive is optional: look once (was: wait 10 s)
      while [ $k -lt $KMAX ] && [ ! -s /run/rootdisk ]; do
        for s in /sys/block/sd*; do
          case "$(readlink -f "$s")" in *usb*) ;; *) continue ;; esac
          [ "$(dd if=/dev/${s##*/} bs=1 skip=440 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n')" = "$WANT_SIG" ] && echo "${s##*/}" > /run/rootdisk
        done
        [ -s /run/rootdisk ] || { sleep 1; k=$((k+1)); }
      done
      echo "/dev/$(basename "$d")"; return 0
    done
    return 1
  fi
  for d in /sys/block/sd*; do
    [ -e "$d" ] || continue
    n="${d##*/}"
    case "$(readlink -f "$d")" in *usb*) ;; *) continue ;; esac   # skip internal UFS disks
    sig="$(dd if=/dev/$n bs=1 skip=440 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    if [ "$sig" = "$WANT_SIG" ]; then
      echo "$n" > /run/rootdisk
      if [ -b "/dev/${n}1" ]; then echo "/dev/${n}1"; return 0; fi
      # Kernel has no MSDOS_PARTITION, so no /dev/sdX1: attach a loop device at the MBR partition-1 start instead.
      lba="$(od -An -tu4 -j454 -N4 /dev/$n 2>/dev/null | tr -d ' \n')"
      case "$lba" in ''|0|*[!0-9]*) lba=2048 ;; esac
      lo="$(losetup -f 2>/dev/null)"
      if [ -n "$lo" ] && losetup -o $((lba*512)) "$lo" "/dev/$n" 2>/dev/null; then
        log "no /dev/${n}1 (no MSDOS_PARTITION in kernel); using $lo = /dev/$n at LBA $lba" >&2
        echo "$lo"; return 0
      fi
    fi
  done
  return 1
}

diag() {
  B="$(ls /sys/block 2>/dev/null | tr '\n' ' ')"
  log "diag: blockdevs: $B"
  for s in /sys/bus/scsi/devices/1:*:*:*; do          # only the USB host (scsi host1+), not the UFS LUNs
    [ -e "$s" ] || continue
    log "diag: scsi ${s##*/} state=$(cat "$s/state" 2>/dev/null) $(cat "$s/model" 2>/dev/null)"
  done
  # kernel messages only (never our own q2-init lines, or the output feeds back on itself)
  dmesg | grep -v 'q2-init' | grep -E 'sd [0-9]+:|scsi host[1-9]|scsi [1-9]:|usb-storage|usb 1-|xhci|reset|timeout|abort|I/O' | tail -n 12 | while read -r l; do log "diag: $l"; done
}

ROOTDEV=""; i=0
while [ $i -lt "$WAIT" ]; do
  ROOTDEV="$(find_root)" && break
  ROOTDEV=""
  i=$((i+2)); sleep 2
  [ $((i % 20)) -eq 0 ] && diag
done
[ -n "$ROOTDEV" ] || { diag; fail "SteamOS drive (disk signature 20262026) not found after ${WAIT}s"; }
log "rootfs partition: $ROOTDEV (after ${i}s)"
[ "$(getarg q2_rootdev)" = "userdata" ] && log "rootfs on INTERNAL userdata ($ROOTDEV); log disk: $(cat /run/rootdisk 2>/dev/null || echo none)"

# 2b. persistent log: copy the kernel log (incl. systemd, via systemd.log_target=kmsg) into a raw area of the USB
# drive, past the end of the rootfs partition (11 GiB). Read it on the PC with tools/read_q2log.py.
# It keeps running after switch_root. Disable with q2_log=0.
LOGOFF=11811160064; LOGSIZE=67108864
RD="$(cat /run/rootdisk 2>/dev/null)"
if [ "$(getarg q2_log)" = "0" ]; then
  log "persistent log disabled (q2_log=0)"
elif [ -z "$RD" ] || [ ! -x /usr/bin/qlog ]; then
  log "persistent log unavailable (disk='$RD' qlog=$([ -x /usr/bin/qlog ] && echo yes || echo no))"
elif [ "$(cat /sys/block/$RD/size 2>/dev/null || echo 0)" -le $(( (LOGOFF+LOGSIZE)/512 )) ]; then
  log "persistent log skipped: /dev/$RD is too small (need > 11.1 GiB)"
else
  /usr/bin/qlog "/dev/$RD" "$LOGOFF" "$LOGSIZE" >> /run/qlog.out 2>&1 &
  sleep 1
  log "persistent log: /dev/$RD @ 11GiB ($(cat /run/qlog.out 2>/dev/null | tail -n 1))"
fi

# 2c. q2_install=1: copy the SteamOS partition block-for-block from the USB drive to the internal "userdata" partition
# (keeps btrfs compression and subvolumes, so it is exactly the partition size), give the copy its own filesystem UUID
# and grow it to the whole partition.  Runs here, before anything mounts the USB filesystem, so the copy is consistent.
# WRITES ONLY to the internal partition whose GPT name is exactly "userdata"; abl/xbl/boot/vbmeta/... are never opened.
install_userdata() {
  UD=""
  for u in /sys/class/block/*/uevent; do
    grep -qx "PARTNAME=userdata" "$u" 2>/dev/null || continue
    d="$(dirname "$u")"; case "$(readlink -f "$d")" in *usb*) continue ;; esac
    UD="/dev/$(basename "$d")"; UDS="$d"
  done
  [ -n "$UD" ] || { log "INSTALL: no internal userdata partition - skipped"; return 1; }
  [ "$(grep '^PARTNAME=' "$UDS/uevent" | cut -d= -f2)" = "userdata" ] || { log "INSTALL: safety check failed (name) - skipped"; return 1; }
  UDB=$(( $(cat "$UDS/size") * 512 ))
  [ "$UDB" -ge $((16*1024*1024*1024)) ] || { log "INSTALL: userdata only $UDB bytes - skipped"; return 1; }
  RDK="$(cat /run/rootdisk 2>/dev/null)"
  case "$(readlink -f /sys/block/$RDK)" in *usb*) ;; *) log "INSTALL: source is not the USB drive - skipped"; return 1;; esac
  # source size = the SteamOS partition only
  case "$ROOTDEV" in
    /dev/loop*) SRCB=$(( $(od -An -tu4 -j458 -N4 /dev/$RDK | tr -d ' ') * 512 )) ;;
    *) SRCB=$(( $(cat /sys/class/block/$(basename $ROOTDEV)/size) * 512 )) ;;
  esac
  [ "$SRCB" -gt $((1024*1024*1024)) ] && [ "$SRCB" -le "$UDB" ] || { log "INSTALL: odd source size $SRCB - skipped"; return 1; }
  log "INSTALL: copying $ROOTDEV ($((SRCB/1048576)) MiB, USB) -> $UD (internal userdata, $((UDB/1073741824)) GiB)"
  dd if="$ROOTDEV" of="$UD" bs=4M iflag=count_bytes count="$SRCB" conv=fsync status=none &
  DP=$!
  while kill -0 $DP 2>/dev/null; do
    sleep 15
    W=$(awk '/^wchar/{print $2}' /proc/$DP/io 2>/dev/null)
    [ -n "$W" ] && log "INSTALL: $((W/1048576)) / $((SRCB/1048576)) MiB"
  done
  wait $DP; RC=$?
  [ $RC = 0 ] || { log "INSTALL: copy FAILED (dd rc=$RC)"; return 1; }
  log "INSTALL: copy done; giving the copy its own filesystem UUID and growing it"
  mount -t btrfs -o ro "$ROOTDEV" /mnt/rootfs || { log "INSTALL: cannot mount the USB rootfs for its tools"; return 1; }
  for b in dev proc sys; do mount --bind /$b /mnt/rootfs/$b; done
  if chroot /mnt/rootfs sh -c "command -v btrfstune" >/dev/null 2>&1; then
    printf 'y\n' | chroot /mnt/rootfs btrfstune -f -u "$UD" 2>&1 | tail -n 3 | while read -r l; do log "INSTALL: btrfstune: $l"; done
  else
    log "INSTALL: WARNING no btrfstune - the copy keeps the same UUID as the USB drive"
  fi
  mkdir -p /mnt/rootfs/mnt 2>/dev/null
  if mount -t btrfs "$UD" /mnt/rootfs/mnt; then
    chroot /mnt/rootfs btrfs filesystem resize max /mnt 2>&1 | tail -n 2 | while read -r l; do log "INSTALL: resize: $l"; done
    log "INSTALL: userdata now: $(chroot /mnt/rootfs df -h /mnt 2>/dev/null | tail -n 1 | tr -s ' ')"
    umount /mnt/rootfs/mnt
  else
    log "INSTALL: could not mount the copy to grow it"
  fi
  for b in sys proc dev; do umount /mnt/rootfs/$b; done
  umount /mnt/rootfs; sync
  log "INSTALL: DONE - SteamOS is on internal userdata. Booting the USB system now; next time boot the userdata image."
}
if [ "$(getarg q2_install)" = "1" ]; then install_userdata; fi

# 3. mount the rootfs.
# Default (q2_root=rw): mount the btrfs read-WRITE directly. A tmpfs overlay does not work on this 4.19 kernel
# (copy-up of btrfs xattrs onto tmpfs fails with EOPNOTSUPP, which broke mkdir/chmod/dbus/logind), and a direct rw
# mount also makes /var, /home and /etc persistent. q2_root=ov forces the old read-only + RAM overlay mode.
MODE="$(getarg q2_root)"; [ -n "$MODE" ] || MODE=rw
ROOTMODE=""
if [ "$MODE" = "rw" ]; then
  if mount -t btrfs -o rw,noatime "$ROOTDEV" /mnt/newroot 2>/dev/null || mount -t ext4 -o rw,noatime "$ROOTDEV" /mnt/newroot; then
    ROOTMODE=rw; log "btrfs rootfs mounted READ-WRITE (no overlay); $(ls /mnt/newroot | tr '\n' ' ')"
    # Valve's rootfs is a read-only btrfs *subvolume*: a rw mount still gives EROFS on every write until the flag is cleared
    log "qrw: $(/usr/bin/qrw /mnt/newroot 2>&1)"
    if ( : > /mnt/newroot/.q2rw-test ) 2>/dev/null; then rm -f /mnt/newroot/.q2rw-test; log "rootfs is writable"
    else log "WARNING: rootfs is still NOT writable (EROFS)"; fi
    # system switch prepared by q2osinstall (fresh install of another SteamOS, or rollback): /.q2-switch names a directory
    # in this filesystem whose contents become the new root; the current root moves into /.q2-old-<version>-<time>.
    # Plain renames inside the userdata filesystem - nothing else is touched, and it can be switched back the same way.
    R=/mnt/newroot
    if [ -s $R/.q2-switch ]; then
      T="$(head -n 1 $R/.q2-switch | tr -cd 'A-Za-z0-9._-')"
      case "$T" in .q2-new|.q2-old-*) ;; *) T="" ;; esac
      if [ -n "$T" ] && [ -d "$R/$T/usr" ]; then
        ov() { echo "$(grep -h '^VERSION_ID=' $1/usr/lib/os-release 2>/dev/null | cut -d= -f2 | tr -d '"')-$(grep -h '^BUILD_ID=' $1/usr/lib/os-release 2>/dev/null | cut -d= -f2 | tr -d '"')"; }
        OLD=".q2-old-$(ov $R)-$(date +%Y%m%d%H%M%S)"
        log "SWITCH: $(ov $R) -> $(ov $R/$T) (current system kept in /$OLD)"
        mkdir "$R/$OLD"
        for e in "$R"/* "$R"/.[!.]*; do
          [ -e "$e" ] || [ -L "$e" ] || continue
          b="${e##*/}"; case "$b" in .q2-new|.q2-old-*|.q2-switch) continue ;; esac
          mv "$e" "$R/$OLD/" || log "SWITCH: could not move $b"
        done
        for e in "$R/$T"/* "$R/$T"/.[!.]*; do [ -e "$e" ] || [ -L "$e" ] || continue; mv "$e" "$R/" || log "SWITCH: could not move ${e##*/}"; done
        rmdir "$R/$T" 2>/dev/null; rm -f $R/.q2-switch; sync
        log "SWITCH: done - now $(ov $R)"
      else
        log "SWITCH: '$T' is not a prepared system - ignored"; rm -f $R/.q2-switch
      fi
    fi
    # After a fresh install (q2osinstall), finish what a full SteamOS install / our old system had:
    OLDS="$(ls -1dt $R/.q2-old-* 2>/dev/null | head -n 1)"
    # a) the port's own payloads that came from raw areas of the old USB drive (q2blob): our Mesa (/opt/q2gl: desktop GL,
    #    Vulkan ICD for SteamVR), Android blobs and Mesa sources - copied from the kept old system (once)
    if [ -n "$OLDS" ]; then
      for d in opt/q2gl opt/q2android opt/q2src opt/q2mesa; do
        if [ ! -e "$R/$d" ] && [ -d "$OLDS/$d" ]; then mkdir -p "$R/opt"; cp -a "$OLDS/$d" "$R/$d" && log "restored /$d from ${OLDS##*/} ($(du -sm $R/$d | cut -f1) MiB)"; fi
      done
      # the clock: no battery-backed time here; systemd-timesyncd restores it from this file's date at boot
      c=var/lib/systemd/timesync/clock
      if [ -f "$OLDS/$c" ] && { [ ! -f "$R/$c" ] || [ "$OLDS/$c" -nt "$R/$c" ]; }; then mkdir -p "$R/${c%/*}"; cp -p "$OLDS/$c" "$R/$c"; log "clock file restored ($(date -r "$R/$c" 2>/dev/null))"; fi
    fi
    # b) SteamOS keeps its own /etc changes (users, groups, ...) in an overlay "upper" dir on the var partition; we run
    #    without that overlay, so fold it into /etc once (overlay whiteouts = deleted files)
    UP=$R/var/lib/overlays/etc/upper
    if [ -d "$UP" ] && [ ! -e $R/etc/.q2-etc-merged ]; then
      cp -a "$UP/." "$R/etc/" 2>/dev/null
      ( cd "$UP" && find . -type c ) | while IFS= read -r f; do rm -rf "$R/etc/$f"; done
      date > $R/etc/.q2-etc-merged; log "folded SteamOS' /etc overlay ($(cd "$UP" && find . -type f | wc -l) files) into /etc"
    fi
    # c) systemd-resolved (DNS) needs its group; SteamOS' fixed-ID list blocks sysusers from creating it (status=216/GROUP
    #    on the fresh 0.3.0 -> no DNS -> Steam can't download itself)
    for n in systemd-resolve systemd-timesync systemd-network; do
      grep -q "^$n:" $R/etc/group 2>/dev/null && continue
      id=$(grep -hE "^[ug][[:space:]]+$n[[:space:]]" $R/usr/lib/sysusers.d/*.conf 2>/dev/null | head -n 1 | awk '{print $3}' | cut -d: -f1 | tr -cd 0-9)
      [ -n "$id" ] || continue
      echo "$n:x:$id:" >> $R/etc/group; grep -q "^$n:" $R/etc/gshadow 2>/dev/null || echo "$n:!*::" >> $R/etc/gshadow
      grep -q "^$n:" $R/etc/passwd || { echo "$n:x:$id:$id:$n:/:/usr/bin/nologin" >> $R/etc/passwd; grep -q "^$n:" $R/etc/shadow 2>/dev/null || echo "$n:!*:::::::" >> $R/etc/shadow; }
      log "added missing system user/group $n ($id)"
    done
  else
    log "rw btrfs mount failed (see kernel messages); falling back to read-only + RAM overlay"
  fi
fi
if [ -z "$ROOTMODE" ]; then
  mount -t btrfs -o ro "$ROOTDEV" /mnt/rootfs || fail "btrfs mount of $ROOTDEV failed (see kernel messages above)"
  log "btrfs rootfs mounted read-only; $(ls /mnt/rootfs | tr '\n' ' ')"
  mount -t tmpfs -o size="$OVSIZE" tmpfs /mnt/ov || fail "tmpfs for overlay failed"
  mkdir -p /mnt/ov/upper /mnt/ov/work
  mount -t overlay overlay -o lowerdir=/mnt/rootfs,upperdir=/mnt/ov/upper,workdir=/mnt/ov/work /mnt/newroot \
    || fail "overlay mount failed"
  ROOTMODE=ov
fi
NR=/mnt/newroot

# desk-196: install the read-only camera/SyncBoss inventory tool into the running SteamOS rootfs.
# It is manual-only (sudo q2caminfo), creates /var/log/q2/camera-inventory.txt, and is collected by Ctrl+Alt+U.
# It never opens capture devices, mounts block devices, reads raw partitions, or writes to /persist.
if [ -f /usr/share/q2vr/q2caminfo.sh ]; then
  mkdir -p "$NR/usr/bin"
  if cp /usr/share/q2vr/q2caminfo.sh "$NR/usr/bin/q2caminfo" && chmod 755 "$NR/usr/bin/q2caminfo"; then
    log "camera inventory helper installed (/usr/bin/q2caminfo; manual, read-only)"
  else
    log "WARNING: could not install camera inventory helper"
  fi
fi

# desk-207: read-only look into Meta's stock partitions for the tracking-camera files (q2stockcam).
# Loop devices are read-only (-r), mounts are ro,noload; nothing is ever written to a stock partition.
if [ -f /usr/share/q2vr/q2stockcam.py ]; then
  mkdir -p "$NR/usr/bin"; cp /usr/share/q2vr/q2stockcam.py "$NR/usr/bin/q2stockcam" && chmod 755 "$NR/usr/bin/q2stockcam" && log "stock camera file extractor installed (/usr/bin/q2stockcam; read-only)"
fi

# desk-208: Phase B.6 real camera capture (q2camlive): powers the four OV7251 sensors through the kernel's
# own sensor driver (rails/MCLK from the device tree), asks the head tracker to send the SyncBoss camera start,
# then csiphy -> CSID -> IFE fastpath RDI0 per camera. Log /var/log/q2/camlive.txt, images camlive_cam*_pgm.bin.
if [ -f /usr/share/q2vr/q2camlive ]; then
  mkdir -p "$NR/usr/bin"
  cp /usr/share/q2vr/q2camlive "$NR/usr/bin/q2camlive" && chmod 755 "$NR/usr/bin/q2camlive" && log "Phase B.6 camera capture installed (/usr/bin/q2camlive)"
fi

# desk-205: Phase B.5 test-pattern capture (q2camtpg): CSID test pattern -> IFE fastpath RDI0, one frame.
# No sensor, no csiphy, no camera power rails, no SyncBoss. Runs once after the B.4 probe; log /var/log/q2/camtpg.txt.
if [ -f /usr/share/q2vr/q2camtpg ]; then
  mkdir -p "$NR/usr/bin"
  if cp /usr/share/q2vr/q2camtpg "$NR/usr/bin/q2camtpg" && chmod 755 "$NR/usr/bin/q2camtpg"; then
    log "Phase B.5 test-pattern capture installed (/usr/bin/q2camtpg; static AArch64; no sensor, no SyncBoss)"
  else
    log "WARNING: could not install Phase B.5 test-pattern capture"
  fi
fi

# desk-204: install the Phase B.4 camera capability/MMU diagnostic. It never opens SyncBoss.
if [ -f /usr/share/q2vr/q2camframe2 ]; then
  mkdir -p "$NR/usr/bin"
  if cp /usr/share/q2vr/q2camframe2 "$NR/usr/bin/q2camframe2" && chmod 755 "$NR/usr/bin/q2camframe2"; then
    log "Phase B.4 camera caps/MMU probe installed (/usr/bin/q2camframe2; static AArch64; no SyncBoss)"
  else
    log "WARNING: could not install Phase B.3.1 camera CRM probe"
  fi
fi

dumpf() {   # dumpf FILE [MAXLINES]: copy a file from the new root into the persistent log
  [ -f "$NR$1" ] || { log "---- $1 (missing)"; return; }
  log "---- $1"
  head -n "${2:-60}" "$NR$1" | while IFS= read -r l; do log "|$l"; done
}

# 3b. fix-ups so SteamOS' Steam-Frame-specific setup can run on a Quest 2 with ONE partition (rw root only).
if [ "$ROOTMODE" = "rw" ] && [ "$(getarg q2_fixups)" != "0" ]; then
  # SteamOS system updates can't apply here (one partition, our kernel and boot image): Steam's updater asked to update
  # SteamOS on the fresh 0.3.0 and could not get past it, and its branch query (steamos-select-branch -c) hung until a
  # timeout every time (Steam stalls meanwhile).  Answer both at once: "no update available", branch "rel".
  # Originals kept as *.q2orig.
  for f in $NR/usr/bin/steamos-update $NR/usr/bin/steamos-polkit-helpers/steamos-update; do
    [ -e "$f" ] || continue
    grep -q "Quest 2 port" "$f" 2>/dev/null || { [ -e "$f.q2orig" ] || cp -p "$f" "$f.q2orig"; }
    printf '#!/bin/sh\n# Quest 2 port: SteamOS updates are not applied on this headset (original: %s.q2orig)\necho "No update available"\nexit 7\n' "${f#$NR}" > "$f"; chmod 755 "$f"
  done
  for f in $NR/usr/bin/steamos-select-branch $NR/usr/bin/steamos-polkit-helpers/steamos-select-branch; do
    [ -e "$f" ] || continue
    grep -q "Quest 2 port" "$f" 2>/dev/null || { [ -e "$f.q2orig" ] || cp -p "$f" "$f.q2orig"; }
    printf '#!/bin/sh\n# Quest 2 port: answers at once (the real one waits for the update daemon; original: %s.q2orig)\ncase "$1" in -c) echo rel ;; -l) printf "rel\\nbeta\\n" ;; esac\nexit 0\n' "${f#$NR}" > "$f"; chmod 755 "$f"
  done
  # Steam's first-run setup asks "jupiter-initial-firmware-update check" whether the one-time firmware step has run.
  # The VR image doesn't ship it (exit 127 -> "failed to run steamos-mandatory-update check").  Jovian-NixOS fixed the
  # same setup error by making this check answer 0 ("done").  Only created when missing; nothing is flashed.
  for f in $NR/usr/bin/jupiter-initial-firmware-update; do
    { [ -e "$f" ] && ! grep -q "Quest 2 port" "$f" 2>/dev/null; } && continue
    printf '#!/bin/sh\n# Quest 2 port: no device firmware to update on this headset; report the first-boot step as done\nexit 0\n' > "$f"; chmod 755 "$f"
  done
  mkdir -p $NR/usr/bin/steamos-polkit-helpers
  f=$NR/usr/bin/steamos-polkit-helpers/jupiter-dock-updater
  [ -e "$f" ] || { printf '#!/bin/sh\n# Quest 2 port: no dock\nexit 7\n' > "$f"; chmod 755 "$f"; }
  log "fixup: SteamOS update/branch helpers answer 'no update' at once"
  # KMS test image (marker /etc/q2-kmstest inside this boot image): boot without Steam / SteamVR, run 'q2kms test', then
  # PC mode.  A normal boot image clears the flag again.
  mkdir -p $NR/var/lib/q2
  if [ -e /etc/q2-kmstest ]; then echo 1 > $NR/var/lib/q2/kmstest; log "KMS TEST IMAGE: no Steam/SteamVR; the display test runs ~30 s after boot, then PC mode"
  else rm -f $NR/var/lib/q2/kmstest; fi
  # Steam-only image (marker /etc/q2-novr inside this boot image): SteamVR does not start by itself (V still starts it)
  if [ -e /etc/q2-novr ] && false; then echo 1 > $NR/var/lib/q2/novr; log "STEAM-ONLY IMAGE: SteamVR does not autostart"   # desk-255: base ramdisk marker ignored
  else rm -f $NR/var/lib/q2/novr; fi
  # The official image is a factory / first-boot ("OOBE") image: it carries /etc/steamos-oobe-image, which Steam reads
  # (Plat_IsSteamOS3FactoryImage / System.IsDeckFactoryImage).  On a factory image Steam never counts first-run setup as
  # finished and its update step always reboots -> endless setup loop.  On a real Frame the factory flow removes it after
  # setup; here we move it aside (kept in /var/lib/q2 so it can be put back).
  mkdir -p $NR/var/lib/q2
  for f in $NR/etc/steamos-oobe-image $NR/var/lib/overlays/etc/upper/steamos-oobe-image; do
    if [ -e "$f" ] || [ -L "$f" ]; then
      cp -a "$f" "$NR/var/lib/q2/steamos-oobe-image.q2orig" 2>/dev/null
      rm -f "$f" && log "fixup: removed factory-image marker ${f#$NR} (copy: /var/lib/q2/steamos-oobe-image.q2orig)"
    fi
  done
  [ -e $NR/etc/steamos-oobe-image ] && log "fixup: WARNING /etc/steamos-oobe-image is still there"
  # Steam's Restart / Shut down / Sleep buttons go through logind, and polkit refused them for the desktop user
  # ("Interactive authentication required": there is no password prompt in Steam's UI). Allow the power actions and
  # SteamOS' own helpers for that user, as a real Steam Frame does.
  mkdir -p $NR/etc/polkit-1/rules.d
  cat > $NR/etc/polkit-1/rules.d/49-q2-steam-power.rules <<'PKRULE'
// Quest 2 port: Steam's power buttons (restart / shut down / sleep) and SteamOS helpers work without a password prompt
polkit.addRule(function(action, subject) {
    var power = ["org.freedesktop.login1.reboot", "org.freedesktop.login1.reboot-multiple-sessions",
                 "org.freedesktop.login1.power-off", "org.freedesktop.login1.power-off-multiple-sessions",
                 "org.freedesktop.login1.suspend", "org.freedesktop.login1.suspend-multiple-sessions",
                 "org.freedesktop.login1.set-reboot-parameter", "org.freedesktop.login1.set-reboot-to-firmware-setup"];
    if ((subject.user == "steamos" || subject.user == "deck") &&
        (power.indexOf(action.id) >= 0 || action.id.indexOf("com.steampowered.") == 0)) {
        return polkit.Result.YES;
    }
});
PKRULE
  chmod 644 $NR/etc/polkit-1/rules.d/49-q2-steam-power.rules
  log "fixup: Steam's restart / shut down / sleep allowed (polkit rule)"
  # (a) Valve's partition-set mounts (home, persist, efi, esp, ...) point at partitions this single-partition drive
  #     doesn't have; each one costs a 90 s device timeout. fstab: comment those lines out. Mount units
  #     (/usr/lib/systemd/system/*.mount with What= on by-partsets/by-partlabel/PARTLABEL): override each in /etc with a
  #     harmless bind of the directory onto itself and drop the fsck/blockdev/device dependencies.
  mkdir -p $NR/etc/systemd/system
  if [ -f $NR/etc/fstab ]; then
    [ -f $NR/etc/fstab.q2orig ] || cp $NR/etc/fstab $NR/etc/fstab.q2orig
    sed -E '/^[^#[:space:]]+[[:space:]]+\/[[:space:]]/!{/^(\/dev\/disk\/by-part|PARTLABEL=|PARTUUID=)/s/^/# q2: /}' \
      $NR/etc/fstab.q2orig > $NR/etc/fstab.q2new 2>/dev/null
    if [ -s $NR/etc/fstab.q2new ]; then cat $NR/etc/fstab.q2new > $NR/etc/fstab; fi
    rm -f $NR/etc/fstab.q2new
    log "fixup: fstab: $(grep -c '^# q2:' $NR/etc/fstab) partition entries commented out"
  fi
  MOUNTFIX=""
  for f in $NR/usr/lib/systemd/system/*.mount; do
    [ -f "$f" ] || continue
    grep -qE '^What=(/dev/disk/by-part|PARTLABEL=|PARTUUID=)' "$f" || continue
    u="${f##*/}"
    w="$(sed -n 's/^Where=//p' "$f" | head -n 1)"
    [ -n "$w" ] || continue
    mkdir -p "$NR$w" 2>/dev/null
    sed -E -e '/^(Requires|After|BindsTo|Wants|Before|Conflicts)=.*(systemd-fsck@|blockdev@|systemd-growfs@|dev-disk-by)/d' \
           -e '/^(Type|Options)=/d' \
           -e "s#^What=.*#What=$w\nType=none\nOptions=bind#" "$f" > "$NR/etc/systemd/system/$u" 2>/dev/null \
      && MOUNTFIX="$MOUNTFIX $u"
  done
  log "fixup: mount units overridden with self-binds:$MOUNTFIX"
  # (b) mask services that only make sense on Steam Frame hardware (they crash-loop or time out here)
  mkdir -p $NR/etc/systemd/system
  MASKED=""
  for f in $NR/usr/lib/systemd/system/*.service; do
    [ -f "$f" ] || continue
    u="${f##*/}"
    case "$u" in deckard-*|steamvr-*|gpu-trace.service|setubootenv.service) hit=1 ;; *) hit=0 ;; esac
    # desk-179: USB network gadget DHCP (start-pre timed out every 90 s, forever) and root-disk repartitioning (always fails)
    case "$u" in usb-ncm-dnsmasq@.service|systemd-repart.service) hit=1 ;; esac
    if [ "$hit" = 0 ] && grep -qE '^Description=.*(Deckard|SteamVR|Predistort|FPGA|Type-C tcpm|Uboot)' "$f"; then hit=1; fi
    if [ "$hit" = 1 ]; then ln -sf /dev/null "$NR/etc/systemd/system/$u"; MASKED="$MASKED $u"; fi
  done
  log "fixup: masked:$MASKED"
  # desk-180: journald took 16.2 s to start (its on-disk journal), holding up the whole boot.  Keep the journal in RAM only;
  # the port's own log (/var/log/q2) is unaffected.  Undo: rm /etc/systemd/journald.conf.d/q2-volatile.conf
  mkdir -p $NR/etc/systemd/journald.conf.d
  printf '[Journal]\nStorage=volatile\nRuntimeMaxUse=48M\n' > $NR/etc/systemd/journald.conf.d/q2-volatile.conf
  # (c) no GPU/compositor yet: boot to multi-user instead of the graphical (gamescope/steam) session
  if [ "$(getarg q2_target)" != "graphical" ]; then
    ln -sf /usr/lib/systemd/system/multi-user.target $NR/etc/systemd/system/default.target
    log "fixup: default target = multi-user (q2_target=graphical to keep the graphical session)"
  fi
fi

# 3b2. system summary: SteamOS' VR image ships neither neofetch nor fastfetch, so install our own tiny q2fetch
# (/usr/bin/q2fetch) and run it ~25 s after boot; its output goes to the kernel log -> headset display + persistent log.
if [ "$ROOTMODE" = "rw" ] && [ "$(getarg q2_fetch)" != "0" ]; then
  cat > $NR/usr/bin/q2fetch <<'Q2FETCH_EOF'
#!/bin/sh
# q2fetch - neofetch-style system summary that only needs /proc, /sys and /etc/os-release.
# (SteamOS' VR image ships neither neofetch nor fastfetch.)  Works in any POSIX sh.
. /etc/os-release 2>/dev/null
rd() { [ -r "$1" ] && tr -d '\0' < "$1" 2>/dev/null; }
kb() { sed -n "s/^$1:[[:space:]]*\([0-9]*\) kB.*/\1/p" /proc/meminfo | head -n 1; }

host="$(rd /proc/sys/kernel/hostname)"; [ -n "$host" ] || host=$(hostname 2>/dev/null)
title="root@$host"
echo "$title"
printf '%*s\n' "${#title}" '' | tr ' ' '-'

echo "OS: ${PRETTY_NAME:-?} ${VERSION_ID:+$VERSION_ID }${VERSION_CODENAME:+($VERSION_CODENAME${VARIANT_ID:+, $VARIANT_ID}) }$(uname -m)"
echo "Build: ${BUILD_ID:-?}"
model="$(rd /proc/device-tree/model)"; [ -n "$model" ] || model="$(rd /sys/firmware/devicetree/base/model)"
hw="$(sed -n 's/.*androidboot.hardware=\([^ ]*\).*/\1/p' /proc/cmdline | head -n 1)"
echo "Host: ${model:-unknown}${hw:+ [$hw]}"
echo "Kernel: $(uname -r)"

up=$(cut -d. -f1 /proc/uptime 2>/dev/null)
if [ -n "$up" ]; then
  d=$((up/86400)); h=$((up%86400/3600)); m=$((up%3600/60)); s=$((up%60))
  u=""; [ $d -gt 0 ] && u="${d}d "; [ $h -gt 0 ] && u="$u${h}h "; [ $m -gt 0 ] && u="$u${m}m "; echo "Uptime: $u${s}s"
fi

pk=""
[ -d /var/lib/pacman/local ] && pk="$(ls /var/lib/pacman/local 2>/dev/null | grep -vc '^ALPM_DB_VERSION$') (pacman)"
[ -n "$pk" ] && echo "Packages: $pk"
echo "Shell: ${SHELL:-/bin/sh}"

soc="$(rd /sys/devices/soc0/machine)"; sid="$(rd /sys/devices/soc0/soc_id)"
n=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null); f=$(rd /sys/devices/system/cpu/cpu7/cpufreq/cpuinfo_max_freq)
[ -n "$f" ] || f=$(rd /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq)
cpuf=""; [ -n "$f" ] && cpuf=" @ $((f/1000))MHz (max)"
echo "CPU: Qualcomm ${soc:-SoC}${sid:+ (id $sid)} (${n:-?} cores)$cpuf"

gpu="$(rd /sys/class/kgsl/kgsl-3d0/gpu_model)"
[ -n "$gpu" ] && echo "GPU: Qualcomm $gpu (KGSL)" || echo "GPU: no KGSL device visible"

mt=$(kb MemTotal); mf=$(kb MemAvailable)
[ -n "$mt" ] && echo "Memory: $(( (mt-${mf:-0})/1024 ))MiB / $((mt/1024))MiB"

df -h / 2>/dev/null | awk 'NR==2{print "Disk (/): " $3 " / " $2 " (" $5 ") " }' 2>/dev/null || true

for m in /sys/class/drm/card*-*/modes; do [ -r "$m" ] && { echo "Display: $(head -n 1 "$m") ($(echo "$m" | cut -d/ -f5))"; break; }; done
echo "Display (splash fb): 1920x3664 (qscreen)"

nic=""
for i in /sys/class/net/*; do b="${i##*/}"; [ "$b" = lo ] && continue; a="$(ip -4 -o addr show dev "$b" 2>/dev/null | sed -n 's/.*inet \([0-9.\/]*\).*/\1/p' | head -n 1)"; nic="$nic $b${a:+=$a}"; done
echo "Network:${nic:- none}"
Q2FETCH_EOF
  chmod 755 $NR/usr/bin/q2fetch
  mkdir -p $NR/etc/systemd/system/multi-user.target.wants
  cat > $NR/etc/systemd/system/q2-fetch.service <<'UNIT'
[Unit]
Description=Quest 2 port: print system info to the kernel log
[Service]
Type=simple
ExecStart=/bin/sh -c 'sleep 25; ( (fastfetch -l none --pipe 2>/dev/null || /usr/bin/q2fetch) 2>&1 ) | while IFS= read -r l; do echo "q2-fetch: $l" > /dev/kmsg; done'
[Install]
WantedBy=multi-user.target
UNIT
  rm -f $NR/etc/systemd/system/multi-user.target.wants/q2-fetch.service   # desk-179: no longer run at boot (q2fetch by hand)
  log "fixup: q2fetch installed (/usr/bin/q2fetch; run it by hand)"
  # q2imgcheck: read-only report on a SteamOS image flashed to a USB drive (official Steam Frame image vs what's installed)
  cat > $NR/usr/bin/q2imgcheck <<'Q2IMGCHECK_EOF'
#!/bin/bash
# q2imgcheck - READ-ONLY look at a SteamOS image written to a USB drive (e.g. Valve's official Steam Frame image flashed
# with balenaEtcher): partition layout, OS build, and every file the Quest 2 port relies on, compared with the SteamOS
# installed on the headset now.  Report: /var/log/q2/imgcheck.txt (in the logs Ctrl+Alt+U hands to the PC).
# The drive is never written: each partition is set read-only in the kernel (blockdev --setro) before it is mounted
# read-only (btrfs: nologreplay, ext4: noload - no journal replay).  Runs by itself when such a drive is plugged in.
# Only USB-attached drives are looked at: the headset's internal storage (also sd*) is skipped before anything else.
OUT=/var/log/q2/imgcheck.txt; mkdir -p /var/log/q2 /run/q2img
k() { echo "q2-imgcheck: $*" > /dev/kmsg 2>/dev/null; }
sha() { [ -f "$1" ] && sha256sum "$1" 2>/dev/null | cut -c1-16 || echo "-"; }
check_disk() {
  local d=$1 dev=/dev/$1
  echo "=== drive $dev: $(cat /sys/block/$d/device/vendor /sys/block/$d/device/model 2>/dev/null | tr -s ' \n' ' ')size $(( $(cat /sys/block/$d/size) / 2048 )) MiB"
  blockdev --setro $dev 2>/dev/null
  lsblk -o NAME,SIZE,FSTYPE,PARTLABEL,LABEL,PARTUUID $dev 2>&1
  for p in $(lsblk -nlo NAME $dev | tail -n +2); do
    local P=/dev/$p fs=$(blkid -o value -s TYPE /dev/$p 2>/dev/null) m=/run/q2img/$p
    blockdev --setro $P 2>/dev/null
    case "$fs" in btrfs) o=ro,nologreplay;; ext4|ext3|ext2) o=ro,noload;; vfat) o=ro;; *) continue;; esac
    mkdir -p $m; mount -t $fs -o $o $P $m 2>/dev/null || mount -t $fs -o ro $P $m 2>/dev/null || { echo "--- $P ($fs): cannot mount read-only"; continue; }
    local r=""
    for c in "$m" "$m/@" "$m/root"; do [ -f "$c/etc/os-release" ] && { r=$c; break; }; done
    if [ -z "$r" ]; then
      echo "--- $P ($fs, $(blkid -o value -s PARTLABEL $P 2>/dev/null)): $(ls $m 2>/dev/null | head -n 12 | tr '\n' ' ')"
      umount $m 2>/dev/null; continue
    fi
    echo "--- $P ($fs, $(blkid -o value -s PARTLABEL $P 2>/dev/null)): SteamOS root filesystem"
    echo "image  : $(grep -E '^(BUILD_ID|VERSION_ID|IMAGE_ID|VARIANT_ID|PRETTY_NAME)=' $r/etc/os-release | tr '\n' ' ')"
    echo "headset: $(grep -E '^(BUILD_ID|VERSION_ID|IMAGE_ID|VARIANT_ID|PRETTY_NAME)=' /etc/os-release | tr '\n' ' ')"
    echo "files the port uses (image | headset sha256 prefix):"
    for f in opt/steamvr/bin/linuxarm64/vrserver opt/steamvr/bin/linuxarm64/vrcompositor opt/steamvr/bin/vrstartup.sh \
             opt/steamvr/bin/linuxarm64/vrclient.so opt/steamvr/drivers/frame_controller/resources/input/frame_controller_profile.json \
             opt/steamvr/drivers/frame_controller/resources/input/vrcompositor_bindings_frame_controller.json \
             opt/steamvr/drivers/frame_controller/resources/input/steam_vrgamepad_bindings_frame_controller.json \
             opt/steamvr/drivers/oculus/resources/input/touch_profile.json opt/steamvr/drivers/cv/bin/linuxarm64/libArcturusPerception.so \
             usr/lib/os-release usr/bin/steam usr/bin/steamos-session-select; do
      local a=$(sha "$r/$f") b=$(sha "/$f")
      printf '  %-90s %s | %s %s\n' "$f" "$a" "$b" "$([ "$a" = "$b" ] && echo same || echo DIFFERENT)"
    done
    echo "SteamVR drivers: image: $(ls $r/opt/steamvr/drivers 2>/dev/null | tr '\n' ' ')"
    echo "                 here : $(ls /opt/steamvr/drivers 2>/dev/null | tr '\n' ' ')"
    echo "SteamVR version : image $(grep -ao 'v1[0-9]\{9\}' $r/opt/steamvr/bin/linuxarm64/vrserver 2>/dev/null | head -n 1) | here $(grep -ao 'v1[0-9]\{9\}' /opt/steamvr/bin/linuxarm64/vrserver 2>/dev/null | head -n 1)"
    echo "Steam bootstrap : image $(ls $r/usr/lib/steam 2>/dev/null | tr '\n' ' ') | here $(ls /usr/lib/steam 2>/dev/null | tr '\n' ' ')"
    for db in var/lib/pacman/local usr/lib/pacman/local usr/share/factory/var/lib/pacman/local; do
      [ -d "$r/$db" ] || continue
      ls "$r/$db" | grep -v ALPM > /run/q2img/pk-new; ls "/$db" 2>/dev/null | grep -v ALPM > /run/q2img/pk-old
      echo "packages ($db): image $(wc -l < /run/q2img/pk-new), here $(wc -l < /run/q2img/pk-old)"
      echo "  only in the image / newer: $(comm -13 /run/q2img/pk-old /run/q2img/pk-new | head -n 80 | tr '\n' ' ')"
      echo "  only here / older        : $(comm -23 /run/q2img/pk-old /run/q2img/pk-new | head -n 80 | tr '\n' ' ')"
      break
    done
    echo "systemd units that differ (first 40):"
    diff -rq $r/usr/lib/systemd/system /usr/lib/systemd/system 2>/dev/null | head -n 40 | sed 's/^/  /'
    umount $m 2>/dev/null
    k "drive $dev partition $p: $(grep -E '^BUILD_ID=' $r/etc/os-release 2>/dev/null) (this headset: $(grep -E '^BUILD_ID=' /etc/os-release))"
  done
  umount /run/q2img/* 2>/dev/null
}
checked=""
while :; do
  for s in /sys/block/sd*; do
    [ -e "$s" ] || continue
    d=$(basename $s); id="$d:$(cat $s/size)"
    # USB drives ONLY: the headset's own storage (UFS: abl, xbl, userdata, ...) also shows up as sd* - never touch it
    readlink -f $s | grep -q '/usb[0-9]*/' || continue
    case " $checked " in *" $id "*) continue;; esac
    checked="$checked $id"
    # only drives with a GPT that holds a Linux root filesystem (an image), not plain USB sticks
    blkid -o value -s PTTYPE /dev/$d 2>/dev/null | grep -q gpt || continue
    k "looking at $d read-only (report in /var/log/q2/imgcheck.txt)"
    { echo "q2imgcheck $(date)"; check_disk $d; } > $OUT.tmp 2>&1
    mv $OUT.tmp $OUT; k "done: $(grep -c DIFFERENT $OUT) of the port's files differ"
  done
  [ "$1" = once ] && break
  sleep 5
done
Q2IMGCHECK_EOF
  chmod 755 $NR/usr/bin/q2imgcheck
  cat > $NR/usr/bin/q2osinstall <<'Q2OSINSTALL_EOF'
#!/bin/bash
# q2osinstall - install a SteamOS image from a USB drive (e.g. Valve's official Steam Frame image flashed with
# balenaEtcher) onto the headset as a FRESH system, keeping the current one for rollback.
#   sudo q2osinstall            copy the image's system (rootfs-A + var-A) into /.q2-new; the switch happens next boot
#   sudo q2osinstall rollback   next boot goes back to the previous system (kept in /.q2-old-*)
#   sudo q2osinstall cancel     forget a prepared install
#   sudo q2osinstall list       show the kept systems
# Writes ONLY inside the running root filesystem (the internal userdata partition).  The USB drive is set read-only and
# mounted read-only.  No other partition (abl, xbl, boot, ...) is touched.
# Fresh means: an empty /home (Steam unpacks itself again and you log in again).  Carried over: the port's settings
# (/var/lib/q2: eye swap, IPD, Hz, ...) and saved Wi-Fi networks, so the headset is still set up and online.
set -u
L() { echo "q2-osinstall: $*"; echo "q2-osinstall: $*" > /dev/kmsg 2>/dev/null; }
die() { L "STOPPED: $*"; umount /run/q2os/var /run/q2os/root 2>/dev/null; exit 1; }
[ "$(id -u)" = 0 ] || die "run it with sudo"
osver() { echo "$(grep -h '^VERSION_ID=' "$1/etc/os-release" "$1/usr/lib/os-release" 2>/dev/null | head -n 1 | cut -d= -f2 | tr -d '"')-$(grep -h '^BUILD_ID=' "$1/etc/os-release" "$1/usr/lib/os-release" 2>/dev/null | head -n 1 | cut -d= -f2 | tr -d '"')"; }
case "${1:-}" in
  list) for d in /.q2-old-*; do [ -d "$d" ] && echo "$d  ($(du -sh "$d" 2>/dev/null | cut -f1))"; done; [ -d /.q2-new ] && echo "/.q2-new prepared: $(osver /.q2-new)"; cat /.q2-switch 2>/dev/null; exit 0 ;;
  cancel) rm -rf /.q2-new /.q2-switch; L "prepared install removed"; exit 0 ;;
  rollback)
    last=$(ls -1dt /.q2-old-* 2>/dev/null | head -n 1); [ -n "$last" ] || die "no previous system kept"
    echo "$(basename "$last")" > /.q2-switch; sync; L "next boot switches back to $(basename "$last")"; exit 0 ;;
esac
# the image: a USB drive with a GPT partition named rootfs-A
SRC=""; VARP=""
for s in /sys/block/sd*; do
  [ -e "$s" ] || continue; readlink -f "$s" | grep -q '/usb[0-9]*/' || continue
  for p in $(lsblk -nlo NAME /dev/$(basename $s) | tail -n +2); do
    case "$(blkid -o value -s PARTLABEL /dev/$p 2>/dev/null)" in rootfs-A) SRC=/dev/$p;; var-A) VARP=/dev/$p;; esac
  done
  [ -n "$SRC" ] && { DISK=/dev/$(basename $s); break; }
done
[ -n "$SRC" ] || die "no USB drive with a SteamOS image (partition rootfs-A) found"
mkdir -p /run/q2os/root /run/q2os/var
blockdev --setro $DISK 2>/dev/null; blockdev --setro $SRC 2>/dev/null; [ -n "$VARP" ] && blockdev --setro $VARP 2>/dev/null
mount -t btrfs -o ro,nologreplay $SRC /run/q2os/root 2>/dev/null || mount -o ro $SRC /run/q2os/root || die "cannot mount $SRC read-only"
VARM=""; [ -n "$VARP" ] && { mount -t ext4 -o ro,noload $VARP /run/q2os/var 2>/dev/null || mount -o ro $VARP /run/q2os/var 2>/dev/null; } && VARM=/run/q2os/var
NEW=$(osver /run/q2os/root); CUR=$(osver /)
[ -d /run/q2os/root/usr ] || die "$SRC does not look like a SteamOS root filesystem"
NEED=$(( $(du -sm /run/q2os/root | cut -f1) + $( [ -n "$VARM" ] && du -sm $VARM | cut -f1 || echo 0) + 1024 ))
FREE=$(df -m / | awk 'NR==2{print $4}')
[ "$FREE" -gt "$NEED" ] || die "not enough free space: need ${NEED} MiB, ${FREE} MiB free"
echo
echo "Install SteamOS $NEW (from $SRC) as a FRESH system, replacing $CUR at the next boot."
echo "  - the current system stays on the headset (/.q2-old-...): 'sudo q2osinstall rollback' brings it back"
echo "  - your home folder starts EMPTY: Steam unpacks itself again and you log in again"
