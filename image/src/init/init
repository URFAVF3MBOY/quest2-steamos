ticks() { local s=0 p t v; for p in "$@"; do for t in /proc/$p/task/*/stat; do v=$(awk '{s=$0; sub(/.*\) /,"",s); split(s,a," "); print a[12]+a[13]}' $t 2>/dev/null); s=$((s + ${v:-0})); done; done; echo $s; }
