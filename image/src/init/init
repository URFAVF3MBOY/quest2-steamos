SEQ=$((SEQ+1)); echo "$SEQ$$ set dashboard steamMatchesHMDFramerate 0" > /tmp/q2dashreq.n; chmod 644 /tmp/q2dashreq.n; mv -f /tmp/q2dashreq.n /tmp/q2dashreq; sleep 3
