        bn = os.path.basename(h)
        shutil.copy(h, FW + '/' + (bn if bn.lower() == 'cm710x.bin' else bn.lower()))   # desk-331: the codec asks for CM710X.bin
    if hits and os.path.exists(FW + '/a650_zap.elf') and not os.path.exists(FW + '/a650_zap.mdt'):
        split_zap()
    # desk-329: Bluetooth (QCA6390) firmware -> /lib/firmware/qca/ under its own names; q2bt links them to the names the
    # kernel driver asks for (qca/rampatch_<version>.bin, qca/nvm_<version>.bin)
    bt = []
    for r, ds, fs in os.walk(mp):
        for fn in fs:
            l = fn.lower()
            if ('btfw' in l and l.endswith(('.tlv', '.mbn', '.bin'))) or re.match(r'^[a-z]{0,2}nv[0-9][0-9]\.bin$', l):
                try:
                    os.makedirs(FW + '/qca', exist_ok=True); shutil.copy(os.path.join(r, fn), FW + '/qca/' + l); bt.append(l)
                except Exception as e:
                    log('%s: bt fw %s: %s' % (label, fn, e))
    if bt:
        logl('%s bluetooth fw: ' % label, ' '.join(sorted(set(bt))))
    # Wi-Fi (QCA6390): firmware dir qca6390/ (modem: image/qca6390) and the driver's config dir wlan/ (vendor: firmware/wlan)
    for sub, dst in (('image/qca6390', 'qca6390'), ('firmware/wlan', 'wlan'), ('qca6390', 'qca6390')):
        s = mp + '/' + sub
        if os.path.isdir(s):
            n, miss = copy_resolving(s, FW + '/' + dst, mp)
            log('%s: copied %s/ -> /lib/firmware/%s (%d files; unresolved links: %s)' % (label, sub, dst, n, ' '.join(miss) or 'none'))
