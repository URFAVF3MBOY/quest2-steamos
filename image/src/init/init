#!/usr/bin/python3
# q2kms - look at the Quest 2's real display driver (msm_drm / SDE, /dev/dri/card0) the way stock software uses it:
# the display engine scanning out GPU buffers directly (KMS), instead of the CPU copying every frame into the bootloader's
# splash framebuffer as the port does today.
#   q2kms            report only: connectors, modes, CRTCs, planes, formats, properties.  Changes nothing.
#   q2kms test [s]   show a test pattern through KMS for s seconds (default 6).  The splash path stops being shown;
#                    REBOOT afterwards to get the normal picture back (nothing is written to any partition).
# Output: stdout + /var/log/q2/kms.txt (report) or /var/log/q2/kms-test.txt (test; kept until the next test).
# After a test the USB-C port goes to PC mode by itself (q2usbpc), so the log drive with kms-test.txt shows up on the PC.  Raw DRM ioctls through ctypes/fcntl, no libdrm needed.
import fcntl, mmap, os, struct, sys, time

OUT = []
def P(s=''):
    print(s); OUT.append(s)
LOGF = {'test': '/var/log/q2/kms-test.txt', 'serve': '/var/log/q2/kmsd.txt'}.get(sys.argv[1] if len(sys.argv) > 1 else '', '/var/log/q2/kms.txt')
def save():
    try:
        os.makedirs('/var/log/q2', exist_ok=True)
        with open(LOGF, 'w') as f:
            f.write('\n'.join(OUT) + '\n'); f.flush(); os.fsync(f.fileno())
    except Exception:
        pass

def IOC(d, nr, size):  # 'd' = 0x64
    return (d << 30) | (size << 16) | (0x64 << 8) | nr
IOWR = lambda nr, size: IOC(3, nr, size)
IOW = lambda nr, size: IOC(1, nr, size)

def ioctl(fd, req, buf):
    b = bytearray(buf)
    fcntl.ioctl(fd, req, b, True)
    return b

class Arr:   # a C array the kernel fills, address passed as u64
    def __init__(s, n, sz):
        import ctypes
        s.c = (ctypes.c_uint8 * max(1, n * sz))(); s.n = n; s.sz = sz
        s.addr = ctypes.addressof(s.c)
    def raw(s): return bytes(s.c)
    def u32(s): return list(struct.unpack_from('<%dI' % s.n, s.raw())) if s.n else []
    def u64(s): return list(struct.unpack_from('<%dQ' % s.n, s.raw())) if s.n else []

MODEINFO = '<IHHHHHHHHHHIII32s'   # drm_mode_modeinfo, 68 bytes
def modeinfo(b, o=0):
    v = struct.unpack_from(MODEINFO, b, o)
    clk, hd, hss, hse, ht, hsk, vd, vss, vse, vt, vsc, vr, fl, ty, nm = v
    return dict(clock=clk, hdisplay=hd, hsync_start=hss, hsync_end=hse, htotal=ht, vdisplay=vd, vsync_start=vss,
                vsync_end=vse, vtotal=vt, vrefresh=vr, flags=fl, type=ty, name=nm.split(b'\0')[0].decode('latin1'))

CONN_TYPES = {0: 'Unknown', 11: 'HDMI-A', 14: 'eDP', 15: 'Virtual', 16: 'DSI', 18: 'Writeback'}

def getprops(fd, obj, otype):
    # DRM_IOCTL_MODE_OBJ_GETPROPERTIES 0xB9: props_ptr, prop_values_ptr, count_props, obj_id, obj_type
    b = ioctl(fd, IOWR(0xB9, 32), struct.pack('<QQIII4x', 0, 0, 0, obj, otype))
    n = struct.unpack_from('<I', b, 16)[0]
    ids, vals = Arr(n, 4), Arr(n, 8)
    ioctl(fd, IOWR(0xB9, 32), struct.pack('<QQIII4x', ids.addr, vals.addr, n, obj, otype))
    res = {}
    for pid, val in zip(ids.u32(), vals.u64()):
        # DRM_IOCTL_MODE_GETPROPERTY 0xAA: values_ptr, enum_blob_ptr, prop_id, flags, name[32], count_values, count_enum_blobs
        pb = ioctl(fd, IOWR(0xAA, 64), struct.pack('<QQII32sII', 0, 0, pid, 0, b'', 0, 0))
        name = pb[24:56].split(b'\0')[0].decode('latin1')
        res[name] = (pid, val)
    return res

def atomic(fd, objprops, flags):
    # DRM_IOCTL_MODE_ATOMIC 0xBC: flags, count_objs, objs_ptr, count_props_ptr, props_ptr, prop_values_ptr, reserved, user_data
    import ctypes
    objs = list(objprops.keys())
    o = (ctypes.c_uint32 * len(objs))(*objs)
    c = (ctypes.c_uint32 * len(objs))(*[len(objprops[k]) for k in objs])
    ids = [pid for k in objs for pid, _ in objprops[k]]
    vals = [v for k in objs for _, v in objprops[k]]
    pi = (ctypes.c_uint32 * len(ids))(*ids)
    pv = (ctypes.c_uint64 * len(vals))(*vals)
    ioctl(fd, IOWR(0xBC, 56), struct.pack('<IIQQQQQQ', flags, len(objs), ctypes.addressof(o), ctypes.addressof(c),
                                          ctypes.addressof(pi), ctypes.addressof(pv), 0, 0))

def report(fd):
    P('== q2kms report %s' % time.strftime('%Y-%m-%d %H:%M:%S'))
    try:
        v = ioctl(fd, IOWR(0x00, 64), struct.pack('<iii4xQQQQQQ', 0, 0, 0, 0, 0, 0, 0, 0, 0))   # DRM_IOCTL_VERSION (name lengths 0)
        P('driver version %d.%d.%d' % struct.unpack_from('<iii', v, 0))
    except OSError as e:
        P('version: %s' % e)
    for cap, nm in ((2, 'universal planes'), (3, 'atomic')):
        try:
            ioctl(fd, IOW(0x0D, 16), struct.pack('<QQ', cap, 1)); P('client cap %s: ok' % nm)
        except OSError as e:
            P('client cap %s: %s' % (nm, e))
    r = ioctl(fd, IOWR(0xA0, 64), bytes(64))
    nfb, ncrtc, ncon, nenc = struct.unpack_from('<IIII', r, 32)
    fbs, crtcs, cons, encs = Arr(nfb, 4), Arr(ncrtc, 4), Arr(ncon, 4), Arr(nenc, 4)
    r = ioctl(fd, IOWR(0xA0, 64), struct.pack('<QQQQIIII', fbs.addr, crtcs.addr, cons.addr, encs.addr, nfb, ncrtc, ncon, nenc) + bytes(16))
    mw, Mw, mh, Mh = struct.unpack_from('<IIII', r, 48)
    P('resources: %d fbs %s, crtcs %s, connectors %s, encoders %s, size %dx%d .. %dx%d' % (nfb, fbs.u32(), crtcs.u32(), cons.u32(), encs.u32(), mw, mh, Mw, Mh))
    info = {'crtcs': crtcs.u32(), 'cons': [], 'planes': [], 'crtcmode': {}}
    for cid in cons.u32():
        b = ioctl(fd, IOWR(0xA7, 80), struct.pack('<QQQQ', 0, 0, 0, 0) + struct.pack('<12I', *([0] * 4 + [cid] + [0] * 7)))
        nm, npr, nen = struct.unpack_from('<III', b, 32)
        modes, encl, pr, pv = Arr(nm, 68), Arr(nen, 4), Arr(npr, 4), Arr(npr, 8)
        b = ioctl(fd, IOWR(0xA7, 80), struct.pack('<QQQQ', encl.addr, modes.addr, pr.addr, pv.addr) + struct.pack('<12I', nm, npr, nen, 0, cid, 0, 0, 0, 0, 0, 0, 0))
        _, _, _, enc, _, ctype, ctid, conn, mmw, mmh, sub, _ = struct.unpack_from('<12I', b, 32)
        P('connector %d: %s-%d %s, %dx%d mm, encoder %d, %d mode(s)' % (cid, CONN_TYPES.get(ctype, str(ctype)), ctid,
          {1: 'connected', 2: 'disconnected'}.get(conn, 'unknown'), mmw, mmh, enc, nm))
        ml = [modeinfo(modes.raw(), i * 68) for i in range(nm)]
        P('   refresh rates: %s' % ' '.join(str(r) for r in sorted(set(x['vrefresh'] for x in ml if x['hdisplay'] == 1920))))
        for m in [x for x in ml if x['vrefresh'] in (60, 72, 90, 120)][:8] or ml[:4]:
            P('   mode %s: %dx%d @%d Hz clock %d htotal %d vtotal %d flags 0x%x type 0x%x' % (m['name'], m['hdisplay'], m['vdisplay'], m['vrefresh'], m['clock'], m['htotal'], m['vtotal'], m['flags'], m['type']))
        try:
            props = getprops(fd, cid, 0xc0c0c0c0)
            P('   props: ' + ', '.join('%s=%s' % (k, v[1]) for k, v in sorted(props.items()))[:900])
        except OSError as e:
            props = {}; P('   props: %s' % e)
        info['cons'].append(dict(id=cid, type=ctype, conn=conn, enc=enc, modes=ml, modes_raw=modes.raw(), props=props))
    for eid in encs.u32():
        b = ioctl(fd, IOWR(0xA6, 20), struct.pack('<5I', eid, 0, 0, 0, 0))
        _, et, crtc, pcrtc, pclone = struct.unpack('<5I', bytes(b))
        P('encoder %d: type %d crtc %d possible_crtcs 0x%x' % (eid, et, crtc, pcrtc))
    for cr in crtcs.u32():
        b = ioctl(fd, IOWR(0xA1, 104), struct.pack('<QIIIIIII', 0, 0, cr, 0, 0, 0, 0, 0) + bytes(68))
        _, _, _, fb, x, y, gsz, mv = struct.unpack_from('<QIIIIIII', b, 0)
        m = modeinfo(b, 36)
        P('crtc %d: fb %d at %d,%d mode_valid %d %s %dx%d@%d' % (cr, fb, x, y, mv, m['name'], m['hdisplay'], m['vdisplay'], m['vrefresh']))
        if mv: info['crtcmode'][cr] = (bytes(b[36:104]), m)
        if fb:
            try:
                f = ioctl(fd, IOWR(0xAD, 28), struct.pack('<7I', fb, 0, 0, 0, 0, 0, 0))
                P('   fb %d: %dx%d pitch %d bpp %d depth %d' % struct.unpack_from('<6I', f, 0))
            except OSError as e:
                P('   fb %d: %s' % (fb, e))
        try:
            props = getprops(fd, cr, 0xcccccccc)
            P('   props: ' + ', '.join('%s=%s' % (k, v[1]) for k, v in sorted(props.items()))[:900])
        except OSError as e:
            P('   props: %s' % e)
    try:
        b = ioctl(fd, IOWR(0xB5, 16), struct.pack('<QI4x', 0, 0))
        n = struct.unpack_from('<I', b, 8)[0]; pl = Arr(n, 4)
        ioctl(fd, IOWR(0xB5, 16), struct.pack('<QI4x', pl.addr, n))
        for pid in pl.u32():
            b = ioctl(fd, IOWR(0xB6, 32), struct.pack('<6IQ', pid, 0, 0, 0, 0, 0, 0))
            _, crtc, fb, poss, gsz, nf, _ = struct.unpack('<6IQ', bytes(b))
            fm = Arr(nf, 4)
            ioctl(fd, IOWR(0xB6, 32), struct.pack('<6IQ', pid, 0, 0, 0, 0, nf, fm.addr))
            fourcc = ' '.join(struct.pack('<I', x).decode('latin1') for x in fm.u32()[:24])
            try:
                pp = getprops(fd, pid, 0xeeeeeeee); ptype = pp.get('type', (0, -1))[1]
            except OSError:
                pp = {}; ptype = -1
            P('plane %d: crtc %d fb %d possible 0x%x type %s formats %s' % (pid, crtc, fb, poss, {0: 'overlay', 1: 'primary', 2: 'cursor'}.get(ptype, ptype), fourcc))
            info['planes'].append(dict(id=pid, crtc=crtc, fb=fb, poss=poss, type=ptype, formats=fm.u32(), props=pp))
    except OSError as e:
        P('planes: %s' % e)
    return info

def dbgdump(when):
    # read-only look at the display driver's own debug view (debugfs): what the crtc / encoders / planes are really doing
    import subprocess
    if not os.path.isdir('/sys/kernel/debug/dri'):
        subprocess.run(['mount', '-t', 'debugfs', 'none', '/sys/kernel/debug'], capture_output=True)
    root = '/sys/kernel/debug/dri/0'
    if not os.path.isdir(root):
        P('debugfs: %s missing' % root); return
    P('== display driver debug view (%s)' % when)
    want = ('status', 'state', 'fps', 'framebuffer', 'clients', 'fence_status', 'danger_status', 'perf_mode', 'threshold_mode')
    for dp, dn, fn in os.walk(root):
        if dp.count('/') - root.count('/') > 2: dn[:] = []; continue
        for f in sorted(fn):
            if f not in want: continue
            path = os.path.join(dp, f)
            try:
                out = subprocess.run(['timeout', '3', 'head', '-c', '6000', path], capture_output=True, text=True, errors='replace').stdout
            except Exception as e:
                out = str(e)
            P('--- %s' % path[len(root) + 1:])
            for l in out.splitlines()[:80]: P('    ' + l[:200])

MDSS = 0xae00000
REGBLOCKS = [('intf1', MDSS + 0x6b800, 0x2b8), ('intf2', MDSS + 0x6c000, 0x2b8), ('dsc0', MDSS + 0x81000, 0x140),
             ('dsc1', MDSS + 0x81400, 0x140), ('pp0', MDSS + 0x71000, 0xd4), ('pp1', MDSS + 0x71800, 0xd4),
             ('ctl0', MDSS + 0x2000, 0x200), ('lm0', MDSS + 0x45000, 0x80), ('lm1', MDSS + 0x46000, 0x80)] + \
            [('sspp@%x' % o, MDSS + o, 0x200) for o in (0x5000, 0x7000, 0x9000, 0xb000, 0x25000, 0x27000, 0x29000, 0x2b000)] + \
            [('vbif', 0xaeb0000, 0x600), ('mdp_top', MDSS + 0x1000, 0x400)]
def regdump(tag):
    # desk-156: READ-ONLY look at the display engine's registers through /dev/mem (nothing is written): how the bootloader
    # programmed the timing / compression blocks vs how the kernel driver programs them.  -> /var/log/q2/kms-regs-<tag>.txt
    import ctypes
    out = []
    P('regs %s: reading' % tag); save()
    try:
        f = os.open('/dev/mem', os.O_RDWR | os.O_SYNC)
    except OSError as e:
        P('regs %s: /dev/mem: %s' % (tag, e)); return {}
    vals = {}
    try:
        for name, pa, sz in REGBLOCKS:
            base = pa & ~4095; po = pa - base; ln = (po + sz + 4095) & ~4095
            try:
                mm = mmap.mmap(f, ln, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=base)
            except OSError as e:
                out.append('%s: mmap %s' % (name, e)); continue
            arr = (ctypes.c_uint32 * (ln // 4)).from_buffer(mm)
            words = [arr[(po + i) // 4] for i in range(0, sz, 4)]   # 32-bit loads only
            del arr; mm.close()
            vals[name] = words
            for i in range(0, len(words), 8):
                out.append('%-10s +%03x: %s' % (name, i * 4, ' '.join('%08x' % w for w in words[i:i + 8])))
    finally:
        os.close(f)
    try:
        with open('/var/log/q2/kms-regs-%s.txt' % tag, 'w') as fo: fo.write('\n'.join(out) + '\n')
    except Exception as e:
        P('regs %s: %s' % (tag, e))
    for n in ('intf1', 'intf2'):
        w = vals.get(n)
        if not w: continue
        hs, vp = w[0x08 // 4], w[0x0c // 4]
        hper = hs & 0xffff
        P('regs %s %s: en %d cfg %08x hsync_ctl %08x (htotal %d) vsync_period %d (vtotal %.1f) vstart %d vend %d hctl %08x active_hctl %08x cfg2 %08x data_hctl %08x panel_fmt %08x prog_fetch %08x' % (
          tag, n, w[0], w[1], hs, hper, vp, vp / hper if hper else 0, w[0x1c // 4], w[0x24 // 4], w[0x3c // 4], w[0x40 // 4],
          w[0x60 // 4], w[0x64 // 4], w[0x90 // 4], w[0x170 // 4]))
    return vals

def clkinfo(tag):
    try:
        l = [x.strip() for x in open('/sys/kernel/debug/clk/clk_summary') if 'disp_cc_mdss' in x and ('mdp_clk' in x or 'pclk' in x or 'byte' in x)]
        for x in l[:12]: P('clk %s: %s' % (tag, ' '.join(x.split())[:160]))
    except Exception as e:
        P('clk %s: %s' % (tag, e))

def test(fd, info, secs):
    con = next((c for c in info['cons'] if c['conn'] == 1 and c['modes']), None)
    if not con:
        P('test: no connected connector with a mode'); return
    # desk-149: keep the mode the driver already has from the boot splash (no mode switch).  desk-148 asked for 90 Hz,
    # which the driver treats as a mode switch and refuses on the first frame after the splash ("DMS not supported on
    # first frame") -> garbage.  With the same mode the driver takes over the running display and SKIPS reprogramming the
    # timing engine (sde_encoder_phys_vid: "skipping intf programming since cont splash is enabled"), so the panel keeps
    # the refresh the bootloader set (90 Hz) whatever the mode's name says.  The page-flip rate below checks that, and the
    # test stops at once if it ever measures above 125 Hz.
    crtc = info['crtcs'][0] if info['crtcs'] else 0
    if crtc not in info['crtcmode']:
        P('test: crtc %d has no current mode - not testing' % crtc); return
    mraw, m = info['crtcmode'][crtc]
    if m['hdisplay'] != 1920 or m['vdisplay'] != 3664:
        P('test: unexpected current mode %dx%d - not testing' % (m['hdisplay'], m['vdisplay'])); return
    W, H = m['hdisplay'], m['vdisplay']
    P('test: connector %d, keeping the current mode (%s; the real refresh is measured below) on crtc %d' % (con['id'], m['name'], crtc))
    # dumb buffer (CPU-mapped scanout buffer): DRM_IOCTL_MODE_CREATE_DUMB 0xB2
    b = ioctl(fd, IOWR(0xB2, 32), struct.pack('<IIIIIIQ', H, W, 32, 0, 0, 0, 0))
    handle, pitch, size = struct.unpack_from('<IIQ', b, 16)
    P('test: dumb buffer handle %d pitch %d size %d' % (handle, pitch, size))
    mb = ioctl(fd, IOWR(0xB3, 16), struct.pack('<IIQ', handle, 0, 0))
    off = struct.unpack_from('<Q', mb, 8)[0]
    mm = mmap.mmap(fd, size, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=off)
    # pattern: 8 vertical colour bars + a white frame + a diagonal, so orientation and scaling are visible
    cols = [0xffffffff, 0xffffff00, 0xff00ffff, 0xff00ff00, 0xffff00ff, 0xffff0000, 0xff0000ff, 0xff202020]
    row = bytearray()
    for x in range(W): row += struct.pack('<I', cols[x * 8 // W])
    if pitch < W * 4 or pitch * H > size:
        P('test: unexpected dumb buffer (pitch %d for width %d, size %d) - not testing' % (pitch, W, size)); return
    row = bytes(row) + bytes(pitch - W * 4)
    for y in range(H):
        mm[y * pitch:(y + 1) * pitch] = row
    for y in range(0, H, max(1, H // 400)):
        x = min(y * W // H, W - 16); o = y * pitch + x * 4
        if o + 64 <= size: mm[o:o + 64] = b'\xff' * 64
    # DRM_IOCTL_MODE_ADDFB2 0xB8 (XRGB8888)
    fmt = struct.unpack('<I', b'XR24')[0]
    fbcmd = struct.pack('<IIIII', 0, W, H, fmt, 0) + struct.pack('<4I', handle, 0, 0, 0) + struct.pack('<4I', pitch, 0, 0, 0) + bytes(16) + bytes(4) + bytes(32)
    fb = struct.unpack_from('<I', ioctl(fd, IOWR(0xB8, len(fbcmd)), fbcmd), 0)[0]
    P('test: framebuffer %d' % fb)
    # legacy SETCRTC with the connector's own mode (the driver does the cont-splash hand-over)
    import ctypes
    conarr = (ctypes.c_uint32 * 1)(con['id'])
    sc = struct.pack('<QIIIIIII', ctypes.addressof(conarr), 1, crtc, fb, 0, 0, 0, 1) + mraw
    dbgdump('before the takeover')
    regdump('splash'); clkinfo('splash')
    # the driver gives the boot splash memory back to the kernel at the hand-over; q2blit writes into exactly that memory,
    # so it must be stopped first (otherwise it scribbles over memory the kernel has handed to someone else)
    import subprocess
    subprocess.run(['systemctl', 'stop', 'q2-desktop.service'], capture_output=True, timeout=60)
    subprocess.run(['pkill', '-9', '-x', 'q2blit'], capture_output=True)
    time.sleep(1)
    left = subprocess.run(['pgrep', '-x', 'q2blit'], capture_output=True).stdout.strip()
    if left:
        P('test: q2blit still running (%s) - not taking over the display' % left); return
    P('test: desktop stopped (q2blit no longer writes the splash memory)')
    def encstat():
        try: return ' '.join(open('/sys/kernel/debug/dri/0/encoder%d/status' % con['enc']).read().split())[:200]
        except Exception as e: return str(e)
    if 'full' in sys.argv:
        # desk-153: the stock sleep/wake path instead of the splash hand-over.  desk-152 showed our frames DO reach the
        # display interfaces (their checksums changed with the picture) but every frame underran (1842/1842): the hand-over
        # keeps the bootloader's interface timing, which matches none of the driver's modes (the panel ends up grey).
        # So: switch the display off (ends the splash hand-over the way a headset going to sleep does), then on again in
        # the driver's own 90 Hz mode - panel power-on, DSC setup and timing all from Meta's device tree, as on wake-up.
        m90 = next((i for i, x in enumerate(con['modes']) if x['vrefresh'] == 90 and x['hdisplay'] == 1920 and x['vdisplay'] == 3664), None)
        if m90 is None:
            P('test: no 90 Hz mode - not testing'); return
        P('test: encoder before: %s' % encstat())
        # desk-154: desk-153's "off" was a no-op ("0 ms") because the driver was still in its boot-splash state, and the
        # 90 Hz "on" then hit the same refusal.  So first the plain hand-over (same mode as the splash, like a stock boot),
        # which ends the splash state; THEN off and on (a stock sleep / wake).
        t0 = time.time()
        try:
            ioctl(fd, IOWR(0xA2, 104), sc)
            P('test: hand-over (same mode) in %.0f ms' % (1000 * (time.time() - t0)))
        except OSError as e:
            P('test: hand-over failed: %s' % e); return
        time.sleep(1.5)
        P('test: encoder after the hand-over: %s' % encstat())
        t0 = time.time()
        try:
            ioctl(fd, IOWR(0xA2, 104), struct.pack('<QIIIIIII', 0, 0, crtc, 0, 0, 0, 0, 0) + bytes(68))   # crtc off
            P('test: display off in %.0f ms' % (1000 * (time.time() - t0)))
        except OSError as e:
            P('test: display off failed: %s' % e); return
        time.sleep(1.5)
        sc = struct.pack('<QIIIIIII', ctypes.addressof(conarr), 1, crtc, fb, 0, 0, 0, 1) + con['modes_raw'][m90 * 68:m90 * 68 + 68]
        P('test: display on in the 90 Hz mode (%s)' % con['modes'][m90]['name'])
    t0 = time.time()
    try:
        ioctl(fd, IOWR(0xA2, 104), sc)
        P('test: SETCRTC ok in %.0f ms - the pattern should be on the panel now' % (1000 * (time.time() - t0)))
    except OSError as e:
        P('test: SETCRTC failed: %s' % e); return
    time.sleep(0.5); P('test: encoder after: %s' % encstat())
    # desk-155: ONE plane 1920 wide = one display pipe that has to fetch 1920 pixels per scanline.  At this panel's link
    # rate (the dtbo's 144 Hz timing: 2184 x 3686 x 144 = ~1.16 Gpixel/s) that is ~1.02 Gpixel/s through one pipe, but the
    # display engine runs at 552 MHz, ~1 pixel per clock per pipe -> it can never keep up: an underrun on every frame
    # (1842/1842), and with DSC compression an underrun scrambles the whole picture.  Stock software (and the bootloader)
    # feed each half of the panel from its own pipe.  So: two planes, left half and right half of the same buffer.
    split = None
    if 'nosplit' not in sys.argv:
        pls = {p['id']: p for p in info['planes']}
        cands = [(58, 80), (58, 83)] + [(a['id'], b['id']) for a in info['planes'] for b in info['planes'] if a['id'] < b['id']]
        tried = set()
        for l, r in cands:
            if (l, r) in tried or l not in pls or r not in pls: continue
            tried.add((l, r))
            if len(tried) > 6: break
            pl, pr = pls[l]['props'], pls[r]['props']
            need = ('FB_ID', 'CRTC_ID', 'SRC_X', 'SRC_Y', 'SRC_W', 'SRC_H', 'CRTC_X', 'CRTC_Y', 'CRTC_W', 'CRTC_H')
            if not all(k in pl and k in pr for k in need):
                P('test: planes %d/%d lack properties' % (l, r)); continue
            hw = W // 2
            def pset(pp, x):
                d = [(pp['FB_ID'][0], fb), (pp['CRTC_ID'][0], crtc), (pp['SRC_X'][0], x << 16), (pp['SRC_Y'][0], 0),
                     (pp['SRC_W'][0], hw << 16), (pp['SRC_H'][0], H << 16), (pp['CRTC_X'][0], x), (pp['CRTC_Y'][0], 0),
                     (pp['CRTC_W'][0], hw), (pp['CRTC_H'][0], H)]
                if 'zpos' in pp: d.append((pp['zpos'][0], 0))
                return d
            req = {l: pset(pl, 0), r: pset(pr, hw)}
            try:
                atomic(fd, req, 0x0100)   # TEST_ONLY
            except OSError as e:
                P('test: split on planes %d+%d refused by the driver (%s)' % (l, r, e)); continue
            t0 = time.time()
            try:
                atomic(fd, req, 0)
            except OSError as e:
                P('test: split commit on planes %d+%d failed (%s)' % (l, r, e)); continue
            P('test: SPLIT active: plane %d = left half, plane %d = right half (%.0f ms)' % (l, r, 1000 * (time.time() - t0)))
            split = (req, l, r); break
        if not split:
            P('test: no plane pair accepted - staying on one plane')
        time.sleep(0.5); P('test: encoder after the split: %s' % encstat())
    # desk-152: four phases the eye can tell apart - live desktop, colour bars, all black, all white - each with the
    # display engine's own checksum of what it sends to the panel (MISR), so the log shows whether our buffer reaches it
    import select, glob, subprocess
    regdump('driver'); clkinfo('driver')
    misr = sorted(glob.glob('/sys/kernel/debug/dri/0/*/misr_data'))
    P('test: misr files: %s' % misr)
    for mf in misr:
        try: open(mf, 'w').write('1 1')
        except Exception as e: P('test: misr enable %s: %s' % (mf, e))
    def misr_read():
        out = []
        for mf in misr:
            try: out.append(open(mf).read().strip().replace('\n', ' | ')[:160])
            except Exception as e: out.append('err %s' % e)
        return ' ;; '.join(out)
    shm = None
    if pitch == 7680:
        try:
            sf = os.open('/dev/shm/q2warp', os.O_RDONLY); shm = mmap.mmap(sf, 4096 + size, mmap.MAP_SHARED, mmap.PROT_READ); os.close(sf)
        except Exception as e:
            P('test: no desktop frame (%s)' % e)
    pattern = bytes(mm[0:size])
    # desk-157: desk-156 showed the "underrun every frame" came from OUR page flips: with the picture just sitting there
    # (no flips) it was ~2 per second whatever was on screen - even with nothing to fetch at all.  So the scrambled
    # picture is not the memory side.  This run shows the picture WITHOUT flipping (draw into the buffer the panel is
    # scanning), and flips only in one short phase to compare.
    def ucount():
        t = encstat().split()
        try: return int(t[t.index('vsync:') + 1]), int(t[t.index('underrun:') + 1])
        except Exception: return 0, 0
    phases = [('desktop', 4, False), ('colour bars', 6, False), ('black', 4, False), ('white', 4, False),
              ('colour bars WITH page flips', 3, True), ('colour bars', 6, False)]
    flips = 0; ts = []
    for name, dur, doflip in phases:
        if name == 'desktop':
            if shm is None: continue
            mm[0:size] = shm[4096:4096 + size]
        elif name.startswith('colour bars'): mm[0:size] = pattern
        elif name == 'black': mm[0:size] = bytes(size)
        else: mm[0:size] = b'\xff' * size
        P('test: phase %s (%d s)' % (name, dur)); save(); t1 = time.time(); n0 = flips; v0, u0 = ucount()
        while time.time() - t1 < dur:
            if not doflip:
                time.sleep(0.25)
                v, u = ucount(); el = time.time() - t1
                if el > 1 and (v - v0) / el > 125:
                    P('test: ABOVE 125 Hz (%.1f) - stopping now (panel goes dark; reboot)' % ((v - v0) / el)); save(); os._exit(3)
                continue
            try:
                if split: atomic(fd, {split[1]: split[0][split[1]][:1], split[2]: split[0][split[2]][:1]}, 0x0201)   # FB_ID again, event + nonblock
                else: ioctl(fd, IOWR(0xB0, 24), struct.pack('<IIIIQ', crtc, fb, 0x01, 0, 0))   # DRM_MODE_PAGE_FLIP_EVENT
            except OSError as e:
                if flips == n0: P('test: page flip: %s' % e)
                time.sleep(0.05); continue
            r, _, _ = select.select([fd], [], [], 0.5)
            if not r:
                P('test: no flip event within 0.5 s'); time.sleep(0.05); continue
            os.read(fd, 4096); flips += 1; ts.append(time.time())
            if len(ts) == 40:
                hz = 39 / (ts[-1] - ts[0])
                P('test: measured refresh (flips) %.1f Hz' % hz)
                if hz > 125:
                    P('test: ABOVE 125 Hz - stopping now (panel goes dark; reboot)'); save(); os._exit(3)
        v1, u1 = ucount(); el = time.time() - t1
        P('test:   %d frames (%.1f Hz), %d underruns, %d flips; misr: %s' % (v1 - v0, (v1 - v0) / el, u1 - u0, flips - n0, misr_read()))
        save()
    regdump('after-phases')
    # desk-156: experiments, 3 s each, underruns per frame for each: tells a memory-speed problem (fewer pixels to fetch
    # -> fewer underruns) from a timing / compression set-up problem (underruns even with NOTHING to fetch).
    def ucount():
        t = encstat().split()
        try: return int(t[t.index('vsync:') + 1]), int(t[t.index('underrun:') + 1])
        except Exception: return 0, 0
    def measure(name, secs=3):
        v0, u0 = ucount(); time.sleep(secs); v1, u1 = ucount()
        P('exp %-28s: %d frames, %d underruns' % (name, v1 - v0, u1 - u0)); save()
    if split and 'exp' in sys.argv:
        req, l, r = split
        pls = {p['id']: p for p in info['planes']}
        def setplanes(fbid, h, w=W):
            hw = w // 2; d = {}
            for pid, x in ((l, 0), (r, hw)):
                pp = pls[pid]['props']
                d[pid] = [(pp['FB_ID'][0], fbid), (pp['CRTC_ID'][0], crtc if fbid else 0)]
                if fbid:
                    d[pid] += [(pp['SRC_X'][0], x << 16), (pp['SRC_Y'][0], 0), (pp['SRC_W'][0], hw << 16), (pp['SRC_H'][0], h << 16),
                               (pp['CRTC_X'][0], x), (pp['CRTC_Y'][0], 0), (pp['CRTC_W'][0], hw), (pp['CRTC_H'][0], h)]
            atomic(fd, d, 0)
        exps = [('split, full screen', lambda: setplanes(fb, H)),
                ('no planes at all', lambda: setplanes(0, H)),
                ('split, top quarter only', lambda: setplanes(fb, H // 4)),
                ('split, full screen again', lambda: setplanes(fb, H))]
        try:
            b16 = ioctl(fd, IOWR(0xB2, 32), struct.pack('<IIIIIIQ', H, W, 16, 0, 0, 0, 0))
            h16, p16, s16 = struct.unpack_from('<IIQ', b16, 16)
            o16 = struct.unpack_from('<Q', ioctl(fd, IOWR(0xB3, 16), struct.pack('<IIQ', h16, 0, 0)), 8)[0]
            m16 = mmap.mmap(fd, s16, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=o16); m16[0:s16] = b'\xff' * s16
            c16 = struct.pack('<IIIII', 0, W, H, struct.unpack('<I', b'RG16')[0], 0) + struct.pack('<4I', h16, 0, 0, 0) + struct.pack('<4I', p16, 0, 0, 0) + bytes(16) + bytes(4) + bytes(32)
            fb16 = struct.unpack_from('<I', ioctl(fd, IOWR(0xB8, len(c16)), c16), 0)[0]
            exps.insert(3, ('split, 16-bit buffer (half data)', lambda: setplanes(fb16, H)))
        except OSError as e:
            P('exp: no 16-bit buffer (%s)' % e)
        mm[0:size] = b'\xff' * size
        for name, fn in exps:
            try: fn()
            except OSError as e: P('exp %-28s: refused (%s)' % (name, e)); continue
            measure(name)
        regdump('end')
    dbgdump('after the test')
    try:
        d = subprocess.run(['dmesg'], capture_output=True, text=True, timeout=10).stdout.splitlines()
        for l in d[-120:]: P('kernel: ' + l[:220])
    except Exception:
        pass
    P('test: done - reboot to get the normal picture back')

def intf_timing():
    # read-only: INTF1 hsync period / vertical total as the hardware runs them right now
    import ctypes
    f = os.open('/dev/mem', os.O_RDWR | os.O_SYNC)
    try:
        mm = mmap.mmap(f, 4096, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=MDSS + 0x6b000)
        arr = (ctypes.c_uint32 * 1024).from_buffer(mm)
        en, hs, vp = arr[0x800 // 4], arr[0x808 // 4], arr[0x80c // 4]
        del arr; mm.close()
    finally:
        os.close(f)
    hper = hs >> 16
    return en, hper, (vp // hper if hper else 0)

def serve(fd, info):
    # desk-158: the display driver scans out OUR buffer (no copies into the bootloader's splash memory any more).
    # What kmstest-157 proved works, and nothing else: keep the bootloader's own timing (no mode change, no display
    # off/on - the device tree's timing is the dtbo's custom 144 Hz one, which garbles the panel and must never be used),
    # two planes (left / right half), no page flips.  q2blit draws into the buffer; it gets it from here over a socket.
    import socket, subprocess, ctypes
    def fail(why):
        P('kmsd: NOT taking over: %s' % why); save()
        open('/run/q2kms.failed', 'w').write(why + '\n'); sys.exit(2)
    con = next((c for c in info['cons'] if c['conn'] == 1 and c['modes']), None)
    crtc = info['crtcs'][0] if info['crtcs'] else 0
    if not con or crtc not in info['crtcmode']: fail('no active display (crtc %d)' % crtc)
    mraw, m = info['crtcmode'][crtc]
    if (m['hdisplay'], m['vdisplay']) != (1920, 3664): fail('unexpected mode %dx%d' % (m['hdisplay'], m['vdisplay']))
    try:
        en, ht, vt = intf_timing()
    except Exception as e:
        fail('cannot read the display timing (%s)' % e)
    P('kmsd: display interface: enabled %d, htotal %d, vtotal %d' % (en, ht, vt))
    # the bootloader's stock 90 Hz timing (DSC: 432 x 4916).  Anything else -> the display was already re-initialised
    # with the device tree's timing (or is off), and a takeover would need a full mode set: refuse.
    if not en or ht != 432 or vt != 4916: fail('display timing is not the bootloader stock 90 Hz one (htotal %d vtotal %d)' % (ht, vt))
    # desk-164: the hand-over needs us to be the display's master; one boot another program held /dev/dri/card0 first
    # (EACCES).  Wait for it (up to 90 s), logging who has the device open.
    def holders():
        out = []
        for pd in os.listdir('/proc'):
            if not pd.isdigit() or int(pd) == os.getpid(): continue
            try:
                for f in os.listdir('/proc/%s/fd' % pd):
                    if os.readlink('/proc/%s/fd/%s' % (pd, f)) == '/dev/dri/card0':
                        out.append('%s:%s' % (pd, open('/proc/%s/comm' % pd).read().strip())); break
            except OSError:
                pass
        return out
    for tries in range(46):
        try:
            if os.path.exists('/run/q2kms.giveup'): fail('the desktop stopped waiting')
            fcntl.ioctl(fd, 0x641e, 0)   # DRM_IOCTL_SET_MASTER (no-op if we already are)
            break
        except OSError as e:
            if tries == 0 or tries % 10 == 0: P('kmsd: display master is taken (%s) - card0 open by: %s; waiting' % (e, ' '.join(holders()) or '?')); save()
            time.sleep(2)
    else:
        fail('another program keeps the display (card0 open by: %s)' % (' '.join(holders()) or '?'))
    # desk-165: started early at boot (its own unit, before Steam and the desktop) so it is the display's master before
    # anything else opens card0; the actual hand-over waits until the desktop is ready to draw (/run/q2kms.go), so the
    # boot log stays on the panel until then.
    open('/run/q2kms.master', 'w').write('%d\n' % os.getpid())
    if os.environ.get('Q2KMS_WAIT_GO'):
        P('kmsd: display master acquired - waiting for the desktop'); save()
        while not os.path.exists('/run/q2kms.go'):
            if os.path.exists('/run/q2kms.giveup'): fail('the desktop stopped waiting')
            time.sleep(0.3)
    W, H = 1920, 3664
    b = ioctl(fd, IOWR(0xB2, 32), struct.pack('<IIIIIIQ', H, W, 32, 0, 0, 0, 0))
    handle, pitch, size = struct.unpack_from('<IIQ', b, 16)
    if pitch != 7680 or size < pitch * H: fail('unexpected buffer pitch %d size %d' % (pitch, size))
    off = struct.unpack_from('<Q', ioctl(fd, IOWR(0xB3, 16), struct.pack('<IIQ', handle, 0, 0)), 8)[0]
    mm = mmap.mmap(fd, size, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=off)
    try:   # start with the desktop frame the GPU warp left, else black
        sf = os.open('/dev/shm/q2warp', os.O_RDONLY); sm = mmap.mmap(sf, 4096 + pitch * H, mmap.MAP_SHARED, mmap.PROT_READ); os.close(sf)
        mm[0:pitch * H] = sm[4096:4096 + pitch * H]; sm.close()
    except Exception:
        pass
    fmt = struct.unpack('<I', b'XR24')[0]
    fbcmd = struct.pack('<IIIII', 0, W, H, fmt, 0) + struct.pack('<4I', handle, 0, 0, 0) + struct.pack('<4I', pitch, 0, 0, 0) + bytes(16) + bytes(4) + bytes(32)
    fb = struct.unpack_from('<I', ioctl(fd, IOWR(0xB8, len(fbcmd)), fbcmd), 0)[0]
    # nothing may write the splash memory once the driver takes it back: the kernel-log console and the old blitter stop
    if os.path.exists('/run/q2kms.giveup'): fail('the desktop stopped waiting')
    open('/run/q2kms.taken', 'w').write('%d\n' % os.getpid())
    subprocess.run(['pkill', '-9', '-x', 'qscreen'], capture_output=True)
    subprocess.run(['pkill', '-9', '-x', 'q2blit'], capture_output=True)
    for _ in range(20):
        if not subprocess.run(['pgrep', '-x', 'q2blit'], capture_output=True).stdout.strip() and \
           not subprocess.run(['pgrep', '-x', 'qscreen'], capture_output=True).stdout.strip(): break
        time.sleep(0.1)
    else:
        os.unlink('/run/q2kms.taken'); fail('q2blit / qscreen would not stop')
    conarr = (ctypes.c_uint32 * 1)(con['id'])
    t0 = time.time()
    try:
        ioctl(fd, IOWR(0xA2, 104), struct.pack('<QIIIIIII', ctypes.addressof(conarr), 1, crtc, fb, 0, 0, 0, 1) + mraw)
    except OSError as e:
        os.unlink('/run/q2kms.taken'); fail('hand-over refused: %s' % e)
    P('kmsd: hand-over in %.0f ms (same mode as the bootloader: %s)' % (1000 * (time.time() - t0), m['name']))
    pls = {p['id']: p for p in info['planes']}
    split = False
    for l, r in ((58, 80), (58, 83)):
        if l not in pls or r not in pls: continue
        req = {}
        for pid, x in ((l, 0), (r, W // 2)):
            pp = pls[pid]['props']
            req[pid] = [(pp['FB_ID'][0], fb), (pp['CRTC_ID'][0], crtc), (pp['SRC_X'][0], x << 16), (pp['SRC_Y'][0], 0),
                        (pp['SRC_W'][0], (W // 2) << 16), (pp['SRC_H'][0], H << 16), (pp['CRTC_X'][0], x), (pp['CRTC_Y'][0], 0),
                        (pp['CRTC_W'][0], W // 2), (pp['CRTC_H'][0], H)]
            if 'zpos' in pp: req[pid].append((pp['zpos'][0], 0))
        try:
            atomic(fd, req, 0x0100); atomic(fd, req, 0)
            P('kmsd: two planes (%d left, %d right)' % (l, r)); split = (l, r); break
        except OSError as e:
            P('kmsd: planes %d+%d: %s' % (l, r, e))
    try:
        en, ht, vt = intf_timing()
        P('kmsd: timing after the hand-over: htotal %d vtotal %d %s' % (ht, vt, '(stock, good)' if (ht, vt) == (432, 4916) else '(CHANGED)'))
    except Exception as e:
        P('kmsd: timing check: %s' % e)
    # the panel must never go through a driver off/on while we run (it would come back with the dtbo's timing):
    # no suspend while KMS owns the display
