  "match-2|1"
)
printf '%-18s %8s %8s %8s %8s %9s %8s %6s %5s %9s  %s\n' variant webui% viz% steam% comp% compGPUms dropped temp gpuR panels/s closed:webui% | tee -a $O
for v in "${V[@]}"; do
