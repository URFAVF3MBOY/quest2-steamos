HLO="--backend headless"; /tmp/q2gamescope-vr --help 2>&1 | grep -q -- '--backend' || HLO="--headless"
SUIHZ=$(cat /var/lib/q2/steamuihz 2>/dev/null | tr -cd 0-9); SUIHZ=${SUIHZ:-45}
V=(
