CMD=$(cat /proc/cmdline)
SWAP=rgb; case "$CMD" in *q2_swap=1*) SWAP=bgr;; esac   # desk-66 photo: #1060d0 blue showed as orange with bgr
MODE=1;   case "$CMD" in *q2_dmode=0*) MODE=0;; esac
# Canvas size: the lenses only show the middle of each 1832x1920 eye image, so use a smaller desktop centred in each eye
# with black margins.  Tune from the kernel cmdline: q2_vw=1200 q2_vh=900 (size), q2_ox=/q2_oy= (offset inside the eye).
arg() { for w in $CMD; do case "$w" in $1=*) echo "${w#*=}";; esac; done | tail -n 1; }
VW=$(arg q2_vw); VH=$(arg q2_vh); OXA=$(arg q2_ox); OYA=$(arg q2_oy)
[ -n "$VW" ] || VW=1832; [ -n "$VH" ] || VH=1920
W=$VW; H=$VH; BLITARGS="-w $VW -h $VH -b 1060d0"
[ -n "$OXA" ] && BLITARGS="$BLITARGS -x $OXA"; [ -n "$OYA" ] && BLITARGS="$BLITARGS -y $OYA"
if [ "$MODE" = 0 ]; then W=3664; H=1920; BLITARGS=""; fi
case "$CMD" in *q2_full=1*) W=1832; H=1920; BLITARGS="";; esac
# lens pre-warp "virtual monitor" (default on for the stage-1 look); q2_warp=0 disables; q2_mon=<half-width tan x100> q2_tmax=<x100> q2_d=<lens decenter px>
if [ "$MODE" != 0 ] && [ -n "$BLITARGS" ] && [ "$(arg q2_warp)" != 0 ]; then
  BLITARGS="$BLITARGS -v"
  MONA=$(arg q2_mon); [ -z "$MONA" ] && MONA=95
  BLITARGS="$BLITARGS -s $MONA"
  [ -n "$(arg q2_tmax)" ] && BLITARGS="$BLITARGS -t $(arg q2_tmax)"
  [ -n "$(arg q2_d)" ] && BLITARGS="$BLITARGS -d $(arg q2_d)"
fi
L "starting desktop: Xvfb ${W}x${H}, blit mode $MODE ($BLITARGS), colors $SWAP"

# the rootfs ships Mesa 26 with only a unified libdril_dri.so; Xvfb's GLX looks for swrast_dri.so, which did not exist -> no GLX.  Alias it.
for n in swrast kms_swrast; do [ -e /usr/lib/dri/${n}_dri.so ] || [ ! -e /usr/lib/dri/libdril_dri.so ] || ln -s libdril_dri.so /usr/lib/dri/${n}_dri.so 2>/dev/null; done
L "swrast alias: $(ls -l /usr/lib/dri/swrast_dri.so 2>&1 | tr -s ' ' | cut -d' ' -f9- | cut -c1-120)"
# optional CPU speed cap in % (was always 60 %: power peaks once knocked out the USB hub).  Default now: none - the
# kernel's own thermal limits (same as stock) still apply.  Re-enable: echo 60 > /var/lib/q2/cpucap (or q2_cpucap=60).
CAP=$(arg q2_cpucap); [ -n "$CAP" ] || CAP=$(cat /var/lib/q2/cpucap 2>/dev/null | tr -cd 0-9); CAP=${CAP:-100}
[ "$CAP" = 0 ] && CAP=100
if [ "$CAP" -lt 100 ]; then
  for P in /sys/devices/system/cpu/cpufreq/policy*; do
    M=$(cat $P/cpuinfo_max_freq 2>/dev/null); [ -n "$M" ] || continue
    T=$((M*CAP/100)); echo $T > $P/scaling_max_freq 2>/dev/null
    L "cpucap: $(basename $P) max $M -> $(cat $P/scaling_max_freq 2>&1) (cur $(cat $P/scaling_cur_freq 2>&1))"
  done
else
  for P in /sys/devices/system/cpu/cpufreq/policy*; do cat $P/cpuinfo_max_freq > $P/scaling_max_freq 2>/dev/null; done
  L "cpucap: none (full speed; kernel thermal limits as stock)"
fi
# old log files nobody needs any more (one-off probes, window grabs, lens/thermal copies already analysed)
( cd /var/log/q2 2>/dev/null && rm -rf chrome-gpu-probe*.txt steam-out-probe*.txt chrome-gpu.txt composer-strings.txt grab-*.png* \
    vr-apidump* vrcompositor.bin vrcheck.txt vulkaninfo.txt vr-vulkaninfo-*.txt vr-lens.txt vr-vsync.txt stock-*.txt kmsg-prev2.log kmsg-prev3.log lens 2>/dev/null )
# keep the USB hub (mouse/keyboard) from autosuspending / being reset
echo -1 > /sys/module/usbcore/parameters/autosuspend 2>/dev/null
for f in /sys/bus/usb/devices/*/power/control; do echo on > "$f" 2>/dev/null; done
mkdir -p /tmp/q2fb; rm -f /tmp/q2fb/* /tmp/.X0-lock /tmp/.X11-unix/X0
# Mesa's software renderer works (createNewScreen2 gives 180 configs) but the X server ends up with no GLX visuals.
# Suspect: the configs lack the RGB mask attributes the server uses to match X visuals.  q2glshim wraps swrast_dri.so and fills them in.
GLENV="LIBGL_ALWAYS_SOFTWARE=1"
# our own Mesa (built by the build-mesa-gl workflow, written to the USB drive at 14 GiB): has llvmpipe, the stock one has no software GL
[ -e /opt/q2gl/lib/libGLX_mesa.so.0 ] || /usr/bin/q2blob gl >/dev/null 2>&1   # desk-179: only if our Mesa is missing (USB search took ~7 s)
if [ -e /opt/q2gl/lib/libGLX_mesa.so.0 ] && [ "$(echo "$CMD" | grep -c q2_gl=0)" = 0 ]; then
  GLENV="LD_LIBRARY_PATH=/opt/q2gl/lib LIBGL_DRIVERS_PATH=/opt/q2gl/lib/dri __EGL_VENDOR_LIBRARY_DIRS=/opt/q2gl/share/glvnd/egl_vendor.d LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe"
  L "using /opt/q2gl Mesa: $(ls /opt/q2gl/lib | grep -E 'gallium|GLX_mesa' | tr '\n' ' ')"
else
  L "no /opt/q2gl Mesa (write q2gl.tar.gz with pack_blob.py --at 14); stock Mesa has no software GL"
fi
# the GPU node is root-only (crw-------) by default: let normal users (Steam runs as steamos) use the Adreno
chmod 666 /dev/kgsl-3d0 2>/dev/null
mkdir -p /etc/udev/rules.d; echo 'KERNEL=="kgsl-3d0", MODE="0666"' > /etc/udev/rules.d/70-q2-kgsl.rules
# shared GPU buffers (dma-buf): Turnip allocates exportable memory from ION / dma_heap.  Root-only by default, so for Steam
# "VK_KHR_external_memory_fd would be unavailable" - Chromium's GPU UI shares its frames between processes through these.
chmod 666 /dev/ion 2>/dev/null; for h in /dev/dma_heap/*; do [ -e "$h" ] && chmod 666 "$h"; done
printf 'KERNEL=="ion", MODE="0666"\nSUBSYSTEM=="dma_heap", MODE="0666"\n' > /etc/udev/rules.d/70-q2-dmabuf.rules
# desk-261: Android shared memory for Lepton (VRChat etc.).  Android itself has /dev/ashmem 0666; here it is root-only, so the
# rootless container could not open it.
chmod 666 /dev/ashmem 2>/dev/null; echo 'KERNEL=="ashmem", MODE="0666"' > /etc/udev/rules.d/70-q2-ashmem.rules
L "dma-buf: $(ls -l /dev/ion /dev/dma_heap 2>&1 | tr -s ' ' | tr '\n' '|' | cut -c1-200)"
# hardware video decoder: when Steam's web UI probes it, the kernel tries to boot the "venus" video core without its firmware;
# desk-54 died right there.  Keep it root-only so Steam's browser decodes video in software instead.
for v in /dev/video*; do [ -e "$v" ] && chmod 600 "$v"; done
echo 'SUBSYSTEM=="video4linux", MODE="0600"' > /etc/udev/rules.d/71-q2-novideo.rules
# crash memory from the previous boot (if the kernel keeps one)
mkdir -p /sys/fs/pstore 2>/dev/null; mount -t pstore pstore /sys/fs/pstore 2>/dev/null
for f in /sys/fs/pstore/*; do [ -f "$f" ] || continue; L "pstore $(basename $f) ($(wc -c < $f) bytes), last lines:"; tail -n 25 "$f" | cut -c1-200 | P; done
[ -n "$(ls /sys/fs/pstore 2>/dev/null)" ] || L "pstore: empty (no crash record from the previous boot)"
# heartbeat every 60 s: when a log stops dead, the last one shows what the headset was doing
( n=0; while true; do
    B=/sys/class/power_supply/battery
    cap=$(cat $B/capacity 2>/dev/null); st=$(cat $B/status 2>/dev/null); cur=$(cat $B/current_now 2>/dev/null)
    tmax=$(cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -n 1)
    gb=$(cat /sys/class/kgsl/kgsl-3d0/gpu_busy_percentage 2>/dev/null)
    st2=$(pgrep -x steam >/dev/null && echo up || echo down)
    L "hb t=${n}s bat=${cap}% ${st} cur=${cur} tmax=$((${tmax:-0}/1000))C load=$(cut -d' ' -f1-3 /proc/loadavg) mem=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)M gpu=${gb} steam=$st2"
    sleep 60; n=$((n+60))
  done ) &
# GPU clock: fixed, no DCVS.  In desk-49 the first automatic GPU frequency/bus change timed out in the GMU and this kernel
# turns a GMU fault into a kernel BUG (CONFIG_QCOM_KGSL_PANIC_ON_GMU_FAULT), killing the GPU.  Set before the GPU first starts.
# Meta's kernel gives "system" uids 1000-1999 lazily-allocated GPU memory (filled in on GPU page faults).  steamos is uid 1000, and
# here those faults stall the GPU MMU ("SMMU is stalled without a pagefault" -> gpu timeout).  2 = lazy allocation off for everyone.
echo 2 > /sys/module/kgsl/parameters/force_lazy_gpumem 2>/dev/null
L "kgsl lazy gpumem: $(cat /sys/module/kgsl/parameters/force_lazy_gpumem 2>&1) (2 = off)"
K=/sys/class/kgsl/kgsl-3d0
if [ -d $K ] && [ "$(echo "$CMD" | grep -c q2_gpudcvs=1)" = 0 ]; then
  FREQS=$(cat $K/gpu_available_frequencies 2>/dev/null)
  # GPU clock: the highest STOCK level, never above 587 MHz.  Higher entries in this headset's table (670 / 805 MHz) are
  # owner-added overclocks in the dtbo and are NOT safe - never pick them (desk-142 did; withdrawn).  Fixed level, set
  # before the GPU starts (no runtime changes: those faulted in desk-49).
  IDX=$(echo $FREQS | awk '{best=-1; bf=0; for(i=1;i<=NF;i++) if($i<=587000000 && $i>bf){bf=$i; best=i-1} if(best<0){m=1e18; for(i=1;i<=NF;i++) if($i<m){m=$i; best=i-1}} print best}')
  echo 0 > $K/pwrscale 2>/dev/null
  echo $IDX > $K/max_pwrlevel 2>/dev/null; echo $IDX > $K/min_pwrlevel 2>/dev/null; echo $IDX > $K/default_pwrlevel 2>/dev/null
  L "gpu clock fixed: levels [$FREQS] -> idx $IDX ; pwrscale=$(cat $K/pwrscale 2>&1) max=$(cat $K/max_pwrlevel 2>&1) min=$(cat $K/min_pwrlevel 2>&1) default=$(cat $K/default_pwrlevel 2>&1)"
fi
# desk-333: Meta's own VR power profile (vendor powerhint.cfg): GPU clock and power rail always on, long idle timer, and
# the GPU's DDR vote not split by its load counter (that counter reads 0 here, so the bus sat at the level's minimum).
# Native resolution: compositor 10 -> 8 ms GPU per frame, dropped frames 45 -> 3 of 128.  The clock is unchanged.
# touch /var/lib/q2/nometabus = old behaviour.
if [ -d $K ] && [ ! -e /var/lib/q2/nometabus ]; then
  echo 0 > $K/bus_split 2>/dev/null; echo 1 > $K/force_bus_on 2>/dev/null; echo 1 > $K/force_clk_on 2>/dev/null
  echo 1 > $K/force_rail_on 2>/dev/null; echo 10000 > $K/idle_timer 2>/dev/null
  L "gpu: Meta VR power profile: bus_split=$(cat $K/bus_split 2>&1) force_bus/clk/rail=$(cat $K/force_bus_on 2>&1)/$(cat $K/force_clk_on 2>&1)/$(cat $K/force_rail_on 2>&1) idle_timer=$(cat $K/idle_timer 2>&1)"
fi
# never let the GPU above 587 MHz, even with q2_gpudcvs=1 (automatic clocking): cap the top level
if [ -d $K ]; then
  CAP=$(cat $K/gpu_available_frequencies 2>/dev/null | awk '{best=-1; bf=0; for(i=1;i<=NF;i++) if($i<=587000000 && $i>bf){bf=$i; best=i-1} print best}')
  [ -n "$CAP" ] && [ "$CAP" -ge 0 ] && echo $CAP > $K/max_pwrlevel 2>/dev/null
fi
# desk-142: memory / cache bus at full speed.  Every frame is copied twice by the CPU (VR: 28 MB GPU->shm, then shm->panel), and
# those copies were bus-limited (q2blit 320-640 rows/ms while the screen scans 442 rows/ms).  CPU-side bus scalers only (L3,
# LLCC, DDR); anything GPU / kgsl is left alone.  Off: q2_busperf=0 on the kernel cmdline or echo 0 > /var/lib/q2/busperf
if [ "$(echo "$CMD" | grep -c q2_busperf=0)" = 0 ] && [ "$(cat /var/lib/q2/busperf 2>/dev/null)" != 0 ]; then
  BP=""
  for d in /sys/class/devfreq/*; do
    n=$(basename "$d"); case "$n" in *kgsl*|*gpu*|*3d0*|*GPU*) continue;; esac
    case "$n" in *l3*|*llcc*|*ddr*|*bw*|*lat*|*mem*) ;; *) continue;; esac
    grep -qw performance "$d/available_governors" 2>/dev/null || continue
    echo performance > "$d/governor" 2>/dev/null && BP="$BP $n"
  done
  L "bus at full speed:${BP:- (no bus scalers found)}"
fi
/usr/bin/q2fw >/dev/null 2>&1   # Adreno 650 (+ Wi-Fi, video) firmware
# q2msm: with KGSL kept from probing (initcall_blacklist=kgsl_3d_init) the GPU runs on the mainline drm/msm port.
# Loaded here - after the firmware is staged, before the GL probe below - so the desktop picks the GPU on it.
if grep -q 'initcall_blacklist=[^ ]*kgsl_3d_init' /proc/cmdline && [ -f /usr/lib/q2/q2msm.ko ] && ! lsmod | grep -q '^q2msm'; then
  # module options: /var/lib/q2/q2msmargs every boot; /var/lib/q2/q2msm_try for this boot only (taken before the load,
  # so a hang + testguard reboot comes back on the defaults)
  # A try boot loads /var/lib/q2/q2msm_dev.ko when there is one (driver tests without reflashing).
  QA=$(cat /var/lib/q2/q2msmargs 2>/dev/null); KO=/usr/lib/q2/q2msm.ko
  [ -f /var/lib/q2/q2msm_try ] && { QA="$QA $(cat /var/lib/q2/q2msm_try)"; mv -f /var/lib/q2/q2msm_try /var/lib/q2/q2msm_try.used; sync
    [ -f /var/lib/q2/q2msm_dev.ko ] && KO=/var/lib/q2/q2msm_dev.ko; }
  insmod $KO $QA >/dev/null 2>&1
  [ -n "$QA" ] && L "gpu: q2msm $KO options:$QA"
  n=0; while [ $n -lt 25 ] && ! ls -l /sys/class/drm/renderD*/device/driver 2>/dev/null | grep -q q2msm; do sleep 0.2; n=$((n+1)); done
  L "gpu: q2msm (mainline drm/msm) $(ls -l /sys/class/drm/renderD*/device/driver 2>/dev/null | grep -q q2msm && echo loaded || echo 'did NOT come up')"
  # GPU clock on q2msm (the kgsl sysfs above doesn't exist): its devfreq defaulted to simple_ondemand, which bounced
  # 305-670 MHz (~35 changes/s) and ran at 670 - an owner-added level a stock headset doesn't have.  Same rule as KGSL:
  # fixed at the highest level <= 587 MHz; with q2_gpudcvs=1 automatic, capped at that level.
  GD=$(ls -d /sys/class/devfreq/*3d00000* 2>/dev/null | head -1)
  if [ -n "$GD" ]; then
    GF=$(cat $GD/available_frequencies 2>/dev/null | tr ' ' '\n' | awk '$1<=587000000 && $1>b{b=$1} END{print b+0}')
    if [ "$GF" -gt 0 ]; then
      echo $GF > $GD/max_freq 2>/dev/null
      if [ "$(echo "$CMD" | grep -c q2_gpudcvs=1)" = 0 ]; then echo $GF > $GD/min_freq 2>/dev/null; echo performance > $GD/governor 2>/dev/null; fi
    fi
    L "gpu: q2msm clock $(cat $GD/governor 2>&1) $(cat $GD/min_freq 2>&1)-$(cat $GD/max_freq 2>&1) Hz"
  fi
fi
( /usr/bin/q2wifi ) &   # Wi-Fi: load the QCA6390 driver if this image carries it (incl. the device-signed zap from the modem partition) before anything opens the GPU
( systemd-run --unit=q2audio --no-block /usr/bin/q2audio >/dev/null 2>&1 || /usr/bin/q2audio ) &
( systemd-run --unit=q2bt --no-block /usr/bin/q2bt >/dev/null 2>&1 || /usr/bin/q2bt ) &   # desk-329: Bluetooth (log: /var/log/q2/bt.txt)   # desk-318: Kona Q6/LPASS audio - load the DSP modules, boot the ADSP, register the ALSA card (log: /var/log/q2/audio.txt)
echo "$GLENV" > /tmp/q2glenv
L "GL env: [$GLENV]"
env _Q=1 $GLENV Xvfb :0 -screen 0 ${W}x${H}x24 -fbdir /tmp/q2fb -nolisten tcp -ac +extension GLX +extension RENDER +extension XTEST >/tmp/q2-xvfb.log 2>&1 &
XVP=$!
n=0
while [ $n -lt 30 ]; do
  sleep 0.5; n=$((n+1))
  kill -0 $XVP 2>/dev/null || break
  [ -s /tmp/q2fb/Xvfb_screen0 ] && timeout 5 xdpyinfo >/dev/null 2>&1 && break
done
if ! timeout 5 xdpyinfo >/dev/null 2>&1; then
  L "Xvfb with GL env did NOT come up; log:"; grep -v -i -E "zink|drirc" /tmp/q2-xvfb.log | tail -n 8 | P
  pkill -9 -x Xvfb 2>/dev/null; sleep 1; GLENV=""; echo "" > /tmp/q2glenv
  rm -f /tmp/q2fb/* /tmp/.X0-lock /tmp/.X11-unix/X0
  Xvfb :0 -screen 0 ${W}x${H}x24 -fbdir /tmp/q2fb -nolisten tcp -ac +extension GLX +extension RENDER +extension XTEST >/tmp/q2-xvfb.log 2>&1 &
  n=0
  while [ $n -lt 30 ]; do
    sleep 0.5; n=$((n+1))
    [ -s /tmp/q2fb/Xvfb_screen0 ] && timeout 5 xdpyinfo >/dev/null 2>&1 && break
  done
fi
if ! timeout 5 xdpyinfo >/dev/null 2>&1; then
  L "Xvfb did NOT come up; log:"; tail -n 20 /tmp/q2-xvfb.log | P; ls -l /tmp/q2fb 2>&1 | P; exit 1
fi
L "Xvfb is up: $(xdpyinfo 2>/dev/null | grep dimensions | tr -s ' ')"
L "xvfb log: $(grep -v -i drirc /tmp/q2-xvfb.log | cut -c1-300 | head -n 8 | tr '\n' '|')"
L "x visuals: $(xdpyinfo 2>/dev/null | grep -E 'visual id|masks|depth of' | head -n 8 | tr -s ' ' | tr '\n' '|' | cut -c1-400)"

grep -q q2_mesa=1 /proc/cmdline && ( /usr/bin/q2blob; sleep 60; /usr/bin/q2mesa ) &
# desk-158: KMS scanout - the display driver scans a buffer q2blit draws into, instead of q2blit copying into the
# bootloader's splash memory.  q2kmsd (q2kms serve, its own unit so desktop restarts don't drop the display) keeps the
# bootloader's stock timing and never switches the panel off/on.  Off: q2_kms=0 or /var/lib/q2/kms=0 -> old splash path.
KMSARG=""
if [ -e /run/q2kms.ready ]; then KMSARG=$(cat /run/q2kms.ready)
elif [ -e /run/q2kms.taken ]; then L "KMS: the display was taken over but q2kmsd is gone - reboot to get the picture back"
elif [ "$(cat /var/lib/q2/kms 2>/dev/null)" != 0 ] && ! grep -q q2_kms=0 /proc/cmdline && [ ! -e /var/lib/q2/kmstest ]; then
  # q2-kmsd.service starts early at boot and holds the display master (desk-165: Steam opened card0 first once);
  # here we tell it to take over now
  rm -f /run/q2kms.giveup
  systemctl is-active -q q2-kmsd.service || { rm -f /run/q2kms.failed; systemctl start --no-block q2-kmsd.service 2>/dev/null; }
  touch /run/q2kms.go
  n=0; while [ ! -e /run/q2kms.ready ] && [ ! -e /run/q2kms.failed ] && [ $n -lt 200 ]; do
    [ $n -gt 10 ] && ! systemctl is-active -q q2-kmsd.service && ! systemctl is-activating -q q2-kmsd.service 2>/dev/null && break
    sleep 0.5; n=$((n+1)); done
  [ -e /run/q2kms.ready ] || touch /run/q2kms.giveup
  if [ -e /run/q2kms.ready ]; then KMSARG=$(cat /run/q2kms.ready); L "KMS: $(grep '^kmsd:' /var/log/q2/kmsd.txt | tr '\n' ' ' | cut -c1-400)"
  else L "KMS: not used ($(cat /run/q2kms.failed 2>/dev/null | head -c 200)) - splash framebuffer path"; fi
fi
pkill -x qscreen 2>/dev/null          # stop the kernel-log console; the desktop owns the display now
rm -f /tmp/q2glenv.done
echo "-m $MODE $BLITARGS $KMSARG -f $SWAP" > /tmp/q2blitargs
/usr/bin/q2blit -m "$MODE" $BLITARGS $KMSARG -f "$SWAP" /tmp/q2fb/Xvfb_screen0 >/tmp/q2-blit.log 2>&1 &
( sleep 2; setsid /usr/bin/q2display run >/dev/null 2>&1 < /dev/null & )   # GPU lens warp, CPU warp as fallback
# keep the mouse and the display path responsive while Steam is busy: raise them, re-check every 20 s (blit/warp restart)
( while true; do for p in $(pgrep -x Xvfb) $(pgrep -f 'q2input.p[y]') $(pgrep -f 'bin/q2gpuwar[p]') $(pgrep -x q2blit) $(pgrep -x openbox); do
    renice -n -10 -p $p >/dev/null 2>&1; done; sleep 20; done ) &
python3 /usr/bin/q2input.py >/tmp/q2-input.log 2>&1 &
xsetroot -solid '#1060d0' 2>&1 | P
# openbox keys (Steam's full-screen window would otherwise hide everything):
#   Ctrl+Alt+T  new terminal (kept on top)     Alt+Tab  switch windows     Ctrl+Alt+D  show/hide desktop
#   Ctrl+Alt+S  restart Steam                   Ctrl+Alt+M  minimise the active window
mkdir -p /root/.config/openbox
python3 - <<'OBEOF' 2>&1 | P
import os, re
src = '/etc/xdg/openbox/rc.xml'
dst = '/root/.config/openbox/rc.xml'
keys = """
    <keybind key="C-A-t"><action name="Execute"><command>xterm -geometry 110x32</command></action></keybind>
    <keybind key="C-A-d"><action name="ToggleShowDesktop"/></keybind>
    <keybind key="C-A-m"><action name="Iconify"/></keybind>
    <keybind key="C-A-u"><action name="Execute"><command>sh -c 'q2usbpc >/dev/null 2>&amp;1'</command></action></keybind>
    <keybind key="C-A-s"><action name="Execute"><command>sh -c 'q2steam restart >/dev/null 2>&amp;1'</command></action></keybind>
    <keybind key="C-A-n"><action name="Execute"><command>sh -c 'q2steam start >/dev/null 2>&amp;1'</command></action></keybind>
    <keybind key="C-A-g"><action name="Execute"><command>sh -c 'q2steam toggle >/dev/null 2>&amp;1'</command></action></keybind>
    <keybind key="C-A-w"><action name="Execute"><command>sh -c 'q2display toggle >/dev/null 2>&amp;1'</command></action></keybind>
    <keybind key="C-A-c"><action name="Execute"><command>q2headtrack recenter</command></action></keybind>
    <keybind key="C-A-r"><action name="Execute"><command>q2headtrack next</command></action></keybind>
    <keybind key="C-A-equal"><action name="Execute"><command>q2headtrack more</command></action></keybind>
    <keybind key="C-A-minus"><action name="Execute"><command>q2headtrack less</command></action></keybind>
    <keybind key="C-A-v"><action name="Execute"><command>q2vr toggle</command></action></keybind>
"""
apps = """
    <application class="XTerm"><layer>above</layer><focus>yes</focus></application>
"""
if os.path.exists(src):
    x = open(src).read()
    x = x.replace('</keyboard>', keys + '</keyboard>', 1)
    if '<applications>' in x:
        x = x.replace('<applications>', '<applications>' + apps, 1)
    else:
        x = x.replace('</openbox_config>', '<applications>' + apps + '</applications></openbox_config>', 1)
else:
    x = ('<?xml version="1.0"?><openbox_config xmlns="http://openbox.org/3.4/rc"><keyboard>' + keys +
         '<keybind key="A-Tab"><action name="NextWindow"/></keybind></keyboard><applications>' + apps + '</applications></openbox_config>')
open(dst, 'w').write(x)
