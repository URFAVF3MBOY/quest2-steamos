def mine():
    names = {}
    for u in glob.glob('/sys/class/block/*/uevent'):
        d = os.path.basename(os.path.dirname(u))
        for l in open(u).read().split('\n'):
            if l.startswith('PARTNAME='):
                names[l[9:]] = '/dev/' + d
    logl('partitions: ', ' '.join(sorted(names)), 340)
    got = 0
    # a) a plain vendor partition
    for n in ('vendor_a', 'vendor', 'vendor_b'):
        if n in names and not got:
            got = mount_scan(names[n], n)
    # b) vendor inside the dynamic 'super' partition
    sup = names.get('super')
    if sup and not got:
        f = open(sup, 'rb')
        f.seek(4096); g = f.read(52)
        if struct.unpack_from('<I', g, 0)[0] != 0x616c4467:
            log('super: bad geometry magic')
        else:
            f.seek(4096 + 8192); h = f.read(256)
            hm, maj, mnr, hsz = struct.unpack_from('<IHHI', h, 0)
            tsz = struct.unpack_from('<I', h, 44)[0]
            po, pn, pe, eo, en, ee = struct.unpack_from('<IIIIII', h, 80)
            f.seek(4096 + 8192 + hsz); tab = f.read(tsz)
            parts = []
            for i in range(pn):
                e = tab[po + i * pe: po + (i + 1) * pe]
                nm = e[:36].split(b'\0')[0].decode()
                attrs, fe, ne, gi = struct.unpack_from('<IIII', e, 36)
                parts.append((nm, fe, ne))
            exts = []
            for i in range(en):
                e = tab[eo + i * ee: eo + (i + 1) * ee]
                ns, tt, td, ts = struct.unpack_from('<QIQI', e, 0)
                exts.append((ns, tt, td))
            logl('super: ', ' '.join('%s(%dx,%dM)' % (n, c, sum(exts[a + j][0] for j in range(c)) // 2048) for n, a, c in parts), 340)
            want = [p for p in parts if p[0].startswith('vendor') and 'dlkm' not in p[0]]
            want.sort(key=lambda p: (not p[0].endswith('_a'), p[0]))
            for nm, a, c in want[:1]:
                if c != 1:
                    log('%s has %d extents; not handled' % (nm, c)); continue
                ns, tt, td = exts[a]
                got = mount_scan(sup, nm, td * 512, ns * 512)
    # wlan_mac.bin (the headset's real Wi-Fi MAC) lives on the persist partition; read-only
    if 'persist' in names:
        try:
            os.makedirs('/mnt/q2persist', exist_ok=True)
            if sh('mount', '-o', 'ro,noload', '-t', 'ext4', names['persist'], '/mnt/q2persist')[0] == 0:
                for r, ds, fs in os.walk('/mnt/q2persist'):
                    for fn in fs:
                        if fn == 'wlan_mac.bin':
                            os.makedirs(FW + '/wlan/qca_cld', exist_ok=True)
                            shutil.copyfile(os.path.join(r, fn), FW + '/wlan/qca_cld/wlan_mac.bin')
                            log('persist: wlan_mac.bin found (%s)' % r.replace('/mnt/q2persist', ''))
                sh('umount', '/mnt/q2persist')
        except Exception as e:
            log('persist: %s' % e)
    # c) the modem partition (FAT, mounted at /vendor/firmware_mnt on Android): on production units the device-signed
    #    zap shader lives here as a650_zap.mdt + .bNN; the a650_zap.elf in /vendor/firmware is test-signed (TrustZone says -22)
    for n in ('modem_a', 'modem'):
        if n in names:
            mount_scan(names[n], n)
            break
    # desk-329: the Bluetooth firmware partition (/vendor/bt_firmware on Horizon OS, FAT)
    for n in ('bluetooth_a', 'bluetooth', 'bluetooth_b', 'bt_firmware'):
        if n in names:
            mount_scan(names[n], n)
            break
    try:
        os.makedirs('/var/log/q2', exist_ok=True)
        open('/var/log/q2/partitions.txt', 'w').write(' '.join(sorted(names)) + '\n')
    except Exception:
        pass
    log('final: ' + listing())

try:
    if not os.path.exists('/tmp/q2fw.vendor.done'):
        open('/tmp/q2fw.vendor.done', 'w').write('1')
        mine()
except Exception:
    log('EXCEPTION ' + traceback.format_exc().replace('\n', ' | ')[-330:])
