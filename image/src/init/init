#!/usr/bin/python3
# q2-qrtr-ns - QRTR name service (Python port of linux-msm/qrtr src/ns.c, BSD-3).
# The Quest 2's 4.19 kernel has no in-kernel QRTR name server (Android runs one in userspace).
# Without it the Wi-Fi firmware never announces its QMI service (WLFW) -> "Timeout waiting for FW ready".
import os, socket, struct, sys, time

HELLO, BYE, NEW_SERVER, DEL_SERVER, DEL_CLIENT, RESUME_TX, EXIT, PING, NEW_LOOKUP, DEL_LOOKUP = range(2, 12)
NAMES = {2: 'hello', 3: 'bye', 4: 'new-server', 5: 'del-server', 6: 'del-client', 7: 'resume-tx',
         8: 'exit', 9: 'ping', 10: 'new-lookup', 11: 'del-lookup'}
PORT_CTRL = 0xfffffffe
NODE_BCAST = 0xffffffff
VERBOSE = '-v' in sys.argv

def log(m):
    try:
        with open('/dev/kmsg', 'w') as k:
            k.write('q2-qrtr-ns: %s\n' % m)
    except Exception:
        pass
    print('q2-qrtr-ns:', m, flush=True)

sock = socket.socket(socket.AF_QIPCRTR, socket.SOCK_DGRAM, 0)
local_node = sock.getsockname()[0]
try:
    sock.bind((local_node, PORT_CTRL))
except OSError as e:
    log('bind control port failed (%s) - name server already running?' % e)
    sys.exit(0)
BCAST = (NODE_BCAST, PORT_CTRL)

servers = {}   # node -> {port: (service, instance, node, port)}
lookups = []   # [(node, port, service, instance)]

def pkt(cmd, a=0, b=0, c=0, d=0):
    return struct.pack('<5I', cmd, a, b, c, d)

def send(to, data):
    try:
        sock.sendto(data, to)
    except OSError as e:
        if VERBOSE:
            log('sendto %s failed: %s' % (to, e))

def announce(to, srv, new=True):
    send(to, pkt(NEW_SERVER if new else DEL_SERVER, *srv))

def lookup_notify(to, srv, new=True):
    send(to, pkt(NEW_SERVER if new else DEL_SERVER, *(srv or (0, 0, 0, 0))))

def server_del(node, port):
    srv = servers.get(node, {}).pop(port, None)
    if not srv:
        return
    fc = fake_clients.pop((node, port), None)
    if fc:
        fc.close()
    if srv[2] == local_node:
        announce(BCAST, srv, False)
    for ln, lp, ls, li in lookups:
        if ls and ls != srv[0]:
            continue
        if li and li != srv[1]:
            continue
        lookup_notify((ln, lp), srv, False)

def to_local_services(data):
    for srv in list(servers.get(local_node, {}).values()):
        send((srv[2], srv[3]), data)


# Stand-in for Android's cnss-daemon.  The Quest's device tree sets "cnss-daemon-support", so the kernel tells the
# Wi-Fi firmware to expect 2 QMI clients; the firmware then waits for the daemon before it asks for memory/BDF and
# never reports "FW ready".  We register as that second client (indication-register with our own client id) and keep
# the socket open for as long as the firmware's WLFW service exists.
WLFW_SVC = 0x45
fake_clients = {}
def fake_daemon(node, port):
    if os.path.exists('/proc/cmdline') and 'q2_nodaemon=1' in open('/proc/cmdline').read():
        return
    try:
        c = socket.socket(socket.AF_QIPCRTR, socket.SOCK_DGRAM, 0)
        c.settimeout(5)
        tlv = struct.pack('<BHI', 0x15, 4, 0x4e4d4443)            # client_id = "CDMN"
        msg = struct.pack('<BHHH', 0, 1, 0x20, len(tlv)) + tlv     # request, txn 1, IND_REGISTER_REQ
        c.sendto(msg, (node, port))
        r, _ = c.recvfrom(4096)
        res = err = -1
        i = 7
        while i + 3 <= len(r):
            ty, ln = struct.unpack_from('<BH', r, i)
            if ty == 0x02 and ln >= 4:
                res, err = struct.unpack_from('<HH', r, i + 3)
            i += 3 + ln
        log('cnss-daemon stand-in registered with WLFW %d:%d (result %d, error %d)' % (node, port, res, err))
        old = fake_clients.pop((node, port), None)
        if old:
            old.close()
        fake_clients[(node, port)] = c
    except Exception as e:
        log('cnss-daemon stand-in failed: %s' % e)

log('running on node %d' % local_node)
send(BCAST, pkt(HELLO))
seen = set()
while True:
    try:
        data, frm = sock.recvfrom(4096)
    except InterruptedError:
        continue
    if len(data) < 4:
        continue
    cmd = struct.unpack_from('<I', data)[0]
    a = struct.unpack_from('<4I', data.ljust(20, b'\0'), 4)
    fn, fp = frm[0], frm[1]
    if VERBOSE:
        log('%s from %d:%d %s' % (NAMES.get(cmd, hex(cmd)), fn, fp, a))
    try:
        if cmd == HELLO:
            send(frm, data)
            for srv in list(servers.get(local_node, {}).values()):
                announce(frm, srv)
            if fn not in seen:
                seen.add(fn); log('hello from node %d' % fn)
        elif cmd == BYE:
            for port in list(servers.get(fn, {})):
                server_del(fn, port)
            to_local_services(pkt(BYE, fn))
        elif cmd == DEL_CLIENT:
            node, port = a[0], a[1]
            if fn != node or (fn == local_node and fp != port):
                continue
            lookups[:] = [l for l in lookups if not (l[0] == node and l[1] == port)]
            server_del(node, port)
            to_local_services(pkt(DEL_CLIENT, node, port))
        elif cmd == NEW_SERVER:
            service, instance, node, port = a
            if fn == local_node:
                node, port = fn, fp
            if fn != node or not service or not port:
                continue
            srv = (service, instance, node, port)
            servers.setdefault(node, {})[port] = srv
            log('server %d:%d (0x%x) on %d:%d' % (service, instance & 0xff, instance, node, port))
            if node == local_node:
                announce(BCAST, srv)
            for ln, lp, ls, li in lookups:
                if ls and ls != service:
                    continue
                if li and li != instance:
                    continue
                lookup_notify((ln, lp), srv)
            if service == WLFW_SVC and node != local_node:
                time.sleep(0.3)   # let the kernel driver connect first; it is the primary client
                fake_daemon(node, port)
        elif cmd == DEL_SERVER:
            service, instance, node, port = a
            if fn == local_node:
                node, port = fn, fp
            if fn != node or (fn == local_node and fp != port):
                continue
            server_del(node, port)
        elif cmd == NEW_LOOKUP:
            if fn != local_node:
                continue
            service, instance = a[0], a[1]
            lookups.append((fn, fp, service, instance))
            for nd in list(servers.values()):
                for srv in list(nd.values()):
                    if service and srv[0] != service:
                        continue
                    if instance and (srv[1] & 0xffffffff) != instance:
                        continue
                    lookup_notify(frm, srv)
            lookup_notify(frm, None)
        elif cmd == DEL_LOOKUP:
            service, instance = a[0], a[1]
            lookups[:] = [l for l in lookups if not (l[0] == fn and l[1] == fp and l[2] == service
                                                     and (not l[3] or l[3] == instance))]
    except Exception as e:
        log('error handling %s from %d:%d: %s' % (NAMES.get(cmd, cmd), fn, fp, e))
Q2NS_EOF
