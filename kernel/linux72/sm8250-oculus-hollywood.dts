/* Pin states of the camera I2C buses and sensor clocks, from Quest OS's tree */
&tlmm {
	q2pin_160: cci0-active-state {
		mux {
			pins = "gpio101", "gpio102";
			function = "cci_i2c";
		};
		config {
			pins = "gpio101", "gpio102";
			bias-pull-up;
			drive-strength = <0x2>;
		};
	};
	q2pin_161: cci1-active-state {
		mux {
			pins = "gpio103", "gpio104";
			function = "cci_i2c";
		};
		config {
			pins = "gpio103", "gpio104";
			bias-pull-up;
			drive-strength = <0x2>;
		};
	};
	q2pin_162: cci0-suspend-state {
		mux {
			pins = "gpio101", "gpio102";
			function = "cci_i2c";
		};
		config {
			pins = "gpio101", "gpio102";
			bias-pull-down;
			drive-strength = <0x2>;
		};
	};
	q2pin_163: cci1-suspend-state {
		mux {
			pins = "gpio103", "gpio104";
			function = "cci_i2c";
		};
		config {
			pins = "gpio103", "gpio104";
			bias-pull-down;
			drive-strength = <0x2>;
		};
	};
	q2pin_164: cci2-active-state {
		mux {
			pins = "gpio105", "gpio106";
			function = "cci_i2c";
		};
		config {
			pins = "gpio105", "gpio106";
			bias-pull-up;
			drive-strength = <0x2>;
		};
	};
	q2pin_165: cci3-active-state {
		mux {
			pins = "gpio107", "gpio108";
			function = "cci_i2c";
		};
		config {
			pins = "gpio107", "gpio108";
			bias-pull-up;
			drive-strength = <0x2>;
		};
	};
	q2pin_166: cci2-suspend-state {
		mux {
			pins = "gpio105", "gpio106";
			function = "cci_i2c";
		};
		config {
			pins = "gpio105", "gpio106";
			bias-pull-down;
			drive-strength = <0x2>;
		};
	};
	q2pin_167: cci3-suspend-state {
		mux {
			pins = "gpio107", "gpio108";
			function = "cci_i2c";
		};
		config {
			pins = "gpio107", "gpio108";
			bias-pull-down;
			drive-strength = <0x2>;
		};
	};
	q2pin_320: cam-sensor-mclk0-active-state {
		mux {
			pins = "gpio94";
			function = "cam_mclk";
		};
		config {
			pins = "gpio94";
			bias-disable;
			drive-strength = <0x8>;
		};
	};
	q2pin_321: cam-sensor-mclk0-suspend-state {
		mux {
			pins = "gpio94";
			function = "cam_mclk";
		};
		config {
			pins = "gpio94";
			bias-pull-down;
			drive-strength = <0x8>;
		};
	};
	q2pin_322: cam-sensor-mclk1-active-state {
		mux {
			pins = "gpio95";
			function = "cam_mclk";
		};
		config {
			pins = "gpio95";
			bias-disable;
			drive-strength = <0x2>;
		};
	};
	q2pin_323: cam-sensor-mclk1-suspend-state {
		mux {
			pins = "gpio95";
			function = "cam_mclk";
		};
		config {
			pins = "gpio95";
			bias-pull-down;
