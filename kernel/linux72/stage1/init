#!/bin/busybox sh
# Stage 1 on the 7.2 kernel: a shell over USB (NCM network, telnet on 10.42.0.2:23, and an ACM
# serial console), the kernel log in /run/dmesg.txt and the previous boot's RAM console in pstore.
# Nothing is mounted from the headset's storage.
/bin/busybox --install -s /bin
export PATH=/bin
mkdir -p /proc /sys /dev /run /tmp /sys/kernel/config
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t configfs configfs /sys/kernel/config
mount -t pstore pstore /sys/fs/pstore 2>/dev/null

log() { echo "stage1: $*" > /dev/kmsg; }
log "up, kernel $(uname -r)"

UDC=""
n=0
while [ $n -lt 100 ] && [ -z "$UDC" ]; do UDC=$(ls /sys/class/udc 2>/dev/null | head -n 1); [ -n "$UDC" ] || { sleep 0.2; n=$((n + 1)); }; done
G=/sys/kernel/config/usb_gadget/q2
if [ -n "$UDC" ]; then
  mkdir -p $G && cd $G
  echo 0x1d6b > idVendor; echo 0x0104 > idProduct
  mkdir -p strings/0x409; echo "Quest 2 stage 1" > strings/0x409/product; echo hollywood > strings/0x409/serialnumber
  mkdir -p configs/c.1 functions/ncm.usb0 functions/acm.usb0
  ln -s functions/ncm.usb0 configs/c.1/ 2>/dev/null
  ln -s functions/acm.usb0 configs/c.1/ 2>/dev/null
  echo "$UDC" > UDC
  cd /
  log "USB gadget on $UDC"
else
  log "no USB device controller"
fi

n=0
while [ $n -lt 50 ] && ! ip link show usb0 >/dev/null 2>&1; do sleep 0.2; n=$((n + 1)); done
ip addr add 10.42.0.2/24 dev usb0 2>/dev/null
ip link set usb0 up 2>/dev/null
telnetd -l /bin/sh -b 10.42.0.2
mkdir -p /etc /var/lib/misc && : > /var/lib/misc/udhcpd.leases
printf 'start 10.42.0.1\nend 10.42.0.1\ninterface usb0\noption subnet 255.255.255.0\nmax_leases 1\n' > /etc/udhcpd.conf
udhcpd /etc/udhcpd.conf
( while true; do dmesg > /run/dmesg.txt; sleep 2; done ) &
( while true; do [ -e /dev/ttyGS0 ] && setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'; sleep 1; done ) &
log "telnet on 10.42.0.2"

part() { for p in /sys/class/block/*; do grep -q "^PARTNAME=$1\$" $p/uevent 2>/dev/null && { echo /dev/${p##*/}; return; }; done; }
n=0
while [ $n -lt 50 ] && [ -z "$(part userdata)" ]; do sleep 0.2; n=$((n + 1)); done
mkdir -p /mnt/modem /mnt/root /lib/firmware/qcom/sm8250/hollywood
M=$(part modem_a)
[ -n "$M" ] && mount -t vfat -o ro "$M" /mnt/modem && cp /mnt/modem/image/a650_zap.* /lib/firmware/qcom/sm8250/hollywood/
U=$(part userdata)
[ -n "$U" ] && mount -t btrfs -o ro,rescue=nologreplay "$U" /mnt/root && cp /mnt/root/usr/share/q2fw/a650_sqe.fw /mnt/root/usr/share/q2fw/a650_gmu.bin /lib/firmware/qcom/ 2>/dev/null
log "GPU firmware: $(ls /lib/firmware/qcom /lib/firmware/qcom/sm8250/hollywood | tr '\n' ' ')"

# Stage 2: SteamOS from userdata (read-only) under a RAM overlay; nothing is written to the headset's storage.
# Units made for the 4.19 kernel (q2-*; q2-headtrack runs: head rotation and controllers through SyncBoss), SteamOS' own USB gadget and its /etc overlay (already merged into /etc; an overlay
# cannot be the upper dir of another) stay off; root gets a shell on the USB serial port.
stage2() {
  mountpoint -q /mnt/root || return 1
  mkdir -p /mnt/ov /mnt/new
  mount -t tmpfs -o size=3g,mode=755 tmpfs /mnt/ov || return 1
  mkdir -p /mnt/ov/upper /mnt/ov/work
  mount -t overlay overlay -o lowerdir=/mnt/root,upperdir=/mnt/ov/upper,workdir=/mnt/ov/work /mnt/new || return 1
  N=/mnt/new
  mkdir -p $N/usr/lib/firmware/qcom/sm8250/hollywood
  cp /lib/firmware/qcom/a650_* $N/usr/lib/firmware/qcom/
  cp /lib/firmware/qcom/sm8250/hollywood/* $N/usr/lib/firmware/qcom/sm8250/hollywood/
  S=$N/etc/systemd/system
  for u in $(cd $S && ls -d q2-*.service | grep -v -x q2-headtrack.service) usb-gadget.service adbd.service adbd-pre.service adbd-post.service \
           usb-ncm-gadget@usb0.service etc.mount; do
    rm -f $S/$u; ln -s /dev/null $S/$u
  done
  mkdir -p $S/serial-getty@ttyGS0.service.d $S/getty.target.wants
  printf '[Service]\nExecStart=\nExecStart=-/usr/bin/agetty --autologin root --noclear --keep-baud 115200 - ${TERM}\n' \
    > $S/serial-getty@ttyGS0.service.d/autologin.conf
  ln -sf /usr/lib/systemd/system/serial-getty@.service $S/getty.target.wants/serial-getty@ttyGS0.service
  # Valve's health checks repair a SteamVR that fails to start by unpacking Steam again (2.5 GB, into the RAM overlay)
  # and by switching the Frame's A/B boot slot: both answer "fine" here.
  for f in usr/share/deckard/steam-health-check usr/share/deckard/steamvr-health-check usr/bin/steamos-bootconf; do
    [ -e $N/$f ] && printf '#!/bin/sh\nexit 0\n' > $N/$f
  done
  # The compositor's own output (asserts, crashes) into /tmp/vrcompositor-stderr.txt.
  L=$N/opt/steamvr/bin/linuxarm64/vrcompositor-launcher.sh
  [ -e $L ] && sed -i 's|^exec "$ROOT/vrcompositor-launcher" "$@"$|exec "$ROOT/vrcompositor-launcher" "$@" >>/tmp/vrcompositor-stderr.txt 2>\&1|' $L
  # The Frame's tracking driver: vrcompositor loads its passthrough library, which stops it on anything but a Frame
  # ("Expecting only to run on either SM8650 or SM8250 but got platform Meta Quest 2").
  [ -d $N/opt/steamvr/drivers/cv ] && mv $N/opt/steamvr/drivers/cv $N/opt/steamvr-drivers-cv-off
  # gamescope's WSI layer stays out of SteamVR: it wrapped the compositor's direct-mode swapchain and failed every present.
  # The pacing layer keeps the compositor one frame ahead with vblanks 5 ms early and its scanout images compressible
  # (about 52 flips/s with present waits failing without it, 90 with it).
  cp /usr/share/q2vr/libVkLayer_Q2_vr_pacing.so $N/usr/lib/
  cp /usr/share/q2vr/VkLayer_Q2_vr_pacing.json $N/usr/share/vulkan/implicit_layer.d/
  mkdir -p $N/etc/systemd/user/steamvr.service.d
  printf '[Service]\nEnvironment=DISABLE_GAMESCOPE_WSI=1\nEnvironment=Q2_FRAMES_AHEAD=1\nEnvironment=Q2_VSYNC_LEAD_US=5000\n' \
    > $N/etc/systemd/user/steamvr.service.d/50-q2.conf
  # Steam's VR session (gamescope-session.target), not the desktop mode the 4.19 system last chose. OpenGL on the GPU is
  # zink on Turnip (the Frame's Mesa has no other GL driver); the web helper composites through ANGLE on Vulkan.
  printf '[Autologin]\nSession=gamescope-wayland.desktop\n' > $N/etc/sddm.conf.d/zz-steamos-autologin.conf
  mkdir -p $N/etc/systemd/user/steam.service.d $N/etc/systemd/user/gamescope-session.service.d
  printf '[Service]\nEnvironment=MESA_LOADER_DRIVER_OVERRIDE=zink\nEnvironment=STEAM_EXTRA_ARGS=-cef-use-vulkan\nEnvironment=STEAM_LAUNCH_WRAPPER_AFFINITY_LIST=0xf0\nEnvironment=STEAM_DESKTOP_APP_AFFINITY_LIST=0xf0\n' \
    > $N/etc/systemd/user/steam.service.d/50-q2.conf
  printf '[Service]\nEnvironment=WLR_LIBINPUT_NO_DEVICES=1\nEnvironment=MESA_LOADER_DRIVER_OVERRIDE=zink\n' \
    > $N/etc/systemd/user/gamescope-session.service.d/50-q2.conf
  # The 4.19 system's own Steam pieces: ~/.steam/sdkarm64 as a directory with its launch wrapper (Valve's RUNSTEAM.sh
  # links it and stopped at "cannot overwrite directory"), and a wrapper script around the web helper.
  H=$N/home/steamos
  [ -d $H/.steam/sdkarm64 ] && [ ! -L $H/.steam/sdkarm64 ] && rm -rf $H/.steam/sdkarm64
  W=$H/.local/share/Steam/steamrtarm64
  [ -e $W/steamwebhelper.q2real ] && mv -f $W/steamwebhelper.q2real $W/steamwebhelper
  umount /mnt/modem 2>/dev/null
  log "stage 2: switching to SteamOS on $U (RAM overlay)"
  kill -9 -1
  for d in dev proc sys; do mount --move /$d $N/$d; done
  exec switch_root $N /usr/lib/systemd/systemd
}

mkfifo /run/stage2
grep -qw q2_stage2=1 /proc/cmdline || { log "echo > /run/stage2 starts SteamOS"; read x < /run/stage2; }
stage2 || log "stage 2 failed"
exec sh -c 'while true; do sleep 3600; done'
