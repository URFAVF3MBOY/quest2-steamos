+/*
+ * Qualcomm's downstream fastrpc ABI on /dev/adsprpc-smd and /dev/adsprpc-smd-secure, for userspace built
+ * against it (the Quest 2's own Android libraries). The DSP-side protocol is the same; each request is
+ * translated onto this driver's own calls. Only the compute DSP's channel gets these nodes.
+ */
+struct adsprpc_invoke {
+	u32 handle;
+	u32 sc;
+	u64 pra;
+};
+
+struct adsprpc_invoke_crc {
+	struct adsprpc_invoke inv;
+	u64 fds;
+	u64 attrs;
+	u64 crc;
+};
+
+struct adsprpc_init {
+	u32 flags;
+	u64 file;
+	u32 filelen;
+	s32 filefd;
+	u64 mem;
+	u32 memlen;
+	s32 memfd;
+};
+
+struct adsprpc_init_attrs {
+	struct adsprpc_init init;
+	s32 attrs;
+	u32 siglen;
+};
+
+struct adsprpc_mmap {
+	s32 fd;
+	u32 flags;
+	u64 vaddrin;
+	u64 size;
+	u64 vaddrout;
+};
+
+struct adsprpc_munmap {
+	u64 vaddrout;
+	u64 size;
+};
+
+struct adsprpc_munmap_fd {
+	s32 fd;
+	u32 flags;
+	u64 va;
+	s64 len;
+};
+
+struct adsprpc_control {
+	u32 req;
+	u32 arg[2];
+};
+
+struct adsprpc_dsp_caps {
+	u32 domain;
+	u32 attributes[7];
+};
+
+union adsprpc_remote_arg {
+	struct {
+		u64 pv;
+		u64 len;
+	} buf;
+	struct {
+		s32 fd;
+		u32 offset;
+	} dma;
+	u32 h;
+};
+
+#define ADSPRPC_IOCTL_INVOKE		_IOWR('R', 1, struct adsprpc_invoke)
+#define ADSPRPC_IOCTL_MMAP		_IOWR('R', 2, struct adsprpc_mmap)
+#define ADSPRPC_IOCTL_MUNMAP		_IOWR('R', 3, struct adsprpc_munmap)
+#define ADSPRPC_IOCTL_INVOKE_FD		_IOWR('R', 4, struct { struct adsprpc_invoke inv; u64 fds; })
+#define ADSPRPC_IOCTL_SETMODE		_IOWR('R', 5, u32)
+#define ADSPRPC_IOCTL_INIT		_IOWR('R', 6, struct adsprpc_init)
+#define ADSPRPC_IOCTL_INVOKE_ATTRS	_IOWR('R', 7, struct { struct adsprpc_invoke inv; u64 fds; u64 attrs; })
+#define ADSPRPC_IOCTL_GETINFO		_IOWR('R', 8, u32)
+#define ADSPRPC_IOCTL_INIT_ATTRS	_IOWR('R', 10, struct adsprpc_init_attrs)
+#define ADSPRPC_IOCTL_INVOKE_CRC	_IOWR('R', 11, struct adsprpc_invoke_crc)
+#define ADSPRPC_IOCTL_CONTROL		_IOWR('R', 12, struct adsprpc_control)
+#define ADSPRPC_IOCTL_MUNMAP_FD		_IOWR('R', 13, struct adsprpc_munmap_fd)
+#define ADSPRPC_IOCTL_MMAP_64		_IOWR('R', 14, struct adsprpc_mmap)
+#define ADSPRPC_IOCTL_MUNMAP_64		_IOWR('R', 15, struct adsprpc_munmap)
+#define ADSPRPC_IOCTL_GET_DSP_INFO	_IOWR('R', 16, struct adsprpc_dsp_caps)
+
+struct adsprpc_invoke2 {
+	u32 req;
+	u64 invparam;
+	u32 size;
+	s32 err;
+};
+
+struct adsprpc_capability {
+	u32 domain;
+	u32 attribute_id;
+	u32 capability;
+};
+
+#define ADSPRPC_IOCTL_GET_CAPABILITY	_IOWR('R', 17, struct adsprpc_capability)
+#define ADSPRPC_IOCTL_INVOKE2		_IOWR('R', 18, struct adsprpc_invoke2)
+#define ADSPRPC_INVOKE2_KERNEL_OPTIMIZATIONS	3
+
+#define ADSPRPC_INIT_ATTACH		0
+#define ADSPRPC_INIT_CREATE		1
+#define ADSPRPC_INIT_CREATE_STATIC	2
+#define ADSPRPC_INIT_ATTACH_SENSORS	3
+#define ADSPRPC_CONTROL_KALLOC		3
+
+#include <linux/dma-map-ops.h>
+#include <linux/mm.h>
+
+int q2ion_sync_range(struct dma_buf *d, size_t off, size_t len, bool for_device);
+
+/*
+ * CPU cache maintenance on the dma-bufs passed by fd, as downstream does for a context bank that is not IO-coherent:
+ * before the call every buffer is cleaned, after it the output buffers are invalidated. Only the bytes the call uses,
+ * found through the caller's mapping of the buffer (an argument is a slice of a larger pool); the whole buffer when the
+ * address is not in a mapping of it. A coherent context bank (the DSP snoops the CPU caches) needs none.
+ */
+static void adsprpc_sync_fd_bufs(struct fastrpc_user *fl, struct fastrpc_invoke_args *args, u32 inbufs, u32 nbufs,
+				 bool to_dsp)
+{
+	u32 i;
+
+	if (!fl->sctx || dev_is_dma_coherent(fl->sctx->dev))
+		return;
+	for (i = to_dsp ? 0 : inbufs; i < nbufs; i++) {
+		struct vm_area_struct *vma;
+		struct dma_buf *db;
+		size_t off = 0, len;
+
+		if (args[i].fd <= 0 || !args[i].length)
+			continue;
+		db = dma_buf_get(args[i].fd);
+		if (IS_ERR(db))
+			continue;
+		len = db->size;
+		mmap_read_lock(current->mm);
+		vma = vma_lookup(current->mm, args[i].ptr);
+		if (vma && vma->vm_file == db->file) {
+			off = args[i].ptr - vma->vm_start + (vma->vm_pgoff << PAGE_SHIFT);
+			len = args[i].length;
+		}
+		mmap_read_unlock(current->mm);
+		if (q2ion_sync_range(db, off, len, to_dsp)) {
+			if (to_dsp)
+				dma_buf_end_cpu_access(db, DMA_BIDIRECTIONAL);
+			else
+				dma_buf_begin_cpu_access(db, DMA_BIDIRECTIONAL);
+		}
+		dma_buf_put(db);
+	}
+}
+
+static unsigned int adsprpc_trace;
+module_param(adsprpc_trace, uint, 0644);
+MODULE_PARM_DESC(adsprpc_trace, "log every downstream invoke (handle, scalars, arguments, result)");
+
+static int adsprpc_invoke(struct fastrpc_user *fl, char __user *argp, unsigned int cmd)
+{
+	struct adsprpc_invoke_crc inv = {};
+	union adsprpc_remote_arg *pra = NULL;
+	struct fastrpc_invoke_args *args = NULL;
+	s32 *fds = NULL;
+	u32 n, nbufs, i;
+	int err;
+
+	if (copy_from_user(&inv, argp, _IOC_SIZE(cmd)))
+		return -EFAULT;
+	n = REMOTE_SCALARS_LENGTH(inv.inv.sc);
+	nbufs = REMOTE_SCALARS_INBUFS(inv.inv.sc) + REMOTE_SCALARS_OUTBUFS(inv.inv.sc);
+	if (n) {
+		pra = kcalloc(n, sizeof(*pra), GFP_KERNEL);
+		args = kcalloc(n, sizeof(*args), GFP_KERNEL);
+		fds = kcalloc(n, sizeof(*fds), GFP_KERNEL);
+		err = -ENOMEM;
+		if (!pra || !args || !fds)
+			goto out;
+		err = -EFAULT;
+		if (copy_from_user(pra, u64_to_user_ptr(inv.inv.pra), n * sizeof(*pra)))
+			goto out;
+		if (cmd != ADSPRPC_IOCTL_INVOKE && inv.fds) {
+			if (copy_from_user(fds, u64_to_user_ptr(inv.fds), n * sizeof(*fds)))
+				goto out;
+		} else {
+			for (i = 0; i < n; i++)
+				fds[i] = -1;
+		}
+		for (i = 0; i < n; i++) {
+			if (i < nbufs) {
+				args[i].ptr = pra[i].buf.pv;
+				args[i].length = pra[i].buf.len;
+				args[i].fd = fds[i] > 0 ? fds[i] : -1;
+			} else {
+				args[i].fd = pra[i].dma.fd;
+				args[i].ptr = pra[i].dma.offset;
+			}
+		}
+	}
+	if (adsprpc_trace) {
+		dev_info(&fl->cctx->rpdev->dev, "adsprpc: %s: invoke handle 0x%x sc 0x%x (%u args, cmd nr %u)\n",
+			 current->comm, inv.inv.handle, inv.inv.sc, n, _IOC_NR(cmd));
+		for (i = 0; i < n; i++)
+			dev_info(&fl->cctx->rpdev->dev, "adsprpc:   arg %u: ptr 0x%llx len %llu fd %d\n",
+				 i, args[i].ptr, args[i].length, args[i].fd);
+	}
+	/*
+	 * Downstream keeps cached buffers passed by fd coherent with the DSP on every call: clean them before,
+	 * invalidate them after. This driver only syncs when it first maps a buffer.
+	 */
+	adsprpc_sync_fd_bufs(fl, args, REMOTE_SCALARS_INBUFS(inv.inv.sc), nbufs, true);
+	err = fastrpc_internal_invoke(fl, false, inv.inv.handle, inv.inv.sc, args);
+	if (!err)
+		adsprpc_sync_fd_bufs(fl, args, REMOTE_SCALARS_INBUFS(inv.inv.sc), nbufs, false);
+	if (adsprpc_trace)
+		dev_info(&fl->cctx->rpdev->dev, "adsprpc: %s: invoke handle 0x%x sc 0x%x -> %d\n",
+			 current->comm, inv.inv.handle, inv.inv.sc, err);
+	if (cmd == ADSPRPC_IOCTL_INVOKE_CRC && inv.crc && n) {
+		/* No CRCs are computed here: report zeros, as a DSP without CRC checking does. */
+		u32 *zero = kcalloc(n, sizeof(u32), GFP_KERNEL);
+
+		if (zero && copy_to_user(u64_to_user_ptr(inv.crc), zero, n * sizeof(u32)))
+			err = err ?: -EFAULT;
+		kfree(zero);
+	}
+out:
+	kfree(fds);
+	kfree(args);
+	kfree(pra);
+	return err;
+}
+
+static int adsprpc_init(struct fastrpc_user *fl, char __user *argp, unsigned int cmd)
+{
+	struct adsprpc_init_attrs ia = {};
+
+	if (copy_from_user(&ia, argp, _IOC_SIZE(cmd)))
+		return -EFAULT;
+	switch (ia.init.flags) {
+	case ADSPRPC_INIT_ATTACH:
+		return fastrpc_init_attach(fl, ROOT_PD);
+	case ADSPRPC_INIT_ATTACH_SENSORS:
+		return fastrpc_init_attach(fl, SENSORS_PD);
+	case ADSPRPC_INIT_CREATE: {
+		struct fastrpc_init_create c = {
+			.filelen = ia.init.filelen,
+			.filefd = ia.init.filefd,
+			.attrs = ia.attrs,
+			.siglen = ia.siglen,
+			.file = ia.init.file,
+		};
+
+		return fastrpc_init_create_process(fl, NULL, &c);
+	}
+	case ADSPRPC_INIT_CREATE_STATIC: {
+		struct fastrpc_init_create_static s = {
+			.namelen = ia.init.filelen,
+			.memlen = ia.init.memlen,
+			.name = ia.init.file,
+		};
+
+		return fastrpc_init_create_static_process(fl, NULL, &s);
+	}
+	}
+	return -ENOTTY;
+}
+
+static long adsprpc_ioctl_one(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct fastrpc_user *fl = (struct fastrpc_user *)file->private_data;
+	char __user *argp = (char __user *)arg;
+
+	switch (cmd) {
+	case ADSPRPC_IOCTL_INVOKE:
+	case ADSPRPC_IOCTL_INVOKE_FD:
+	case ADSPRPC_IOCTL_INVOKE_ATTRS:
+	case ADSPRPC_IOCTL_INVOKE_CRC:
+		return adsprpc_invoke(fl, argp, cmd);
+	case ADSPRPC_IOCTL_INIT:
+	case ADSPRPC_IOCTL_INIT_ATTRS:
+		return adsprpc_init(fl, argp, cmd);
+	case ADSPRPC_IOCTL_MMAP:
+	case ADSPRPC_IOCTL_MMAP_64: {
+		struct adsprpc_mmap m;
+		struct fastrpc_req_mmap r;
+		int err;
+
+		if (copy_from_user(&m, argp, sizeof(m)))
+			return -EFAULT;
+		r = (struct fastrpc_req_mmap){ .fd = m.fd, .flags = m.flags, .vaddrin = m.vaddrin, .size = m.size };
+		err = fastrpc_req_mmap(fl, NULL, &r);
+		if (err)
+			return err;
+		m.vaddrout = r.vaddrout;
+		return copy_to_user(argp, &m, sizeof(m)) ? -EFAULT : 0;
+	}
+	case ADSPRPC_IOCTL_MUNMAP:
+	case ADSPRPC_IOCTL_MUNMAP_64: {
+		struct adsprpc_munmap m;
+		struct fastrpc_req_munmap r;
+
+		if (copy_from_user(&m, argp, sizeof(m)))
+			return -EFAULT;
+		r = (struct fastrpc_req_munmap){ .vaddrout = m.vaddrout, .size = m.size };
+		return fastrpc_req_munmap(fl, NULL, &r);
+	}
+	case ADSPRPC_IOCTL_MUNMAP_FD:
+		/* The mapping goes with the buffer's last reference on this driver. */
+		return 0;
+	case ADSPRPC_IOCTL_SETMODE:
+		return 0;
+	case ADSPRPC_IOCTL_GET_CAPABILITY: {
+		struct adsprpc_capability c;
+		struct fastrpc_ioctl_capability cap = {};
+		int err;
+
+		if (copy_from_user(&c, argp, sizeof(c)))
+			return -EFAULT;
+		/* Ids from 256 up are kernel-side features of newer drivers: none of them here */
+		if (c.attribute_id >= FASTRPC_MAX_DSP_ATTRIBUTES) {
+			err = 0;
+			c.capability = 0;
+		} else {
+			cap.attribute_id = c.attribute_id;
+			err = fastrpc_get_info_from_kernel(&cap, fl);
+			c.capability = err ? 0 : cap.capability;
+		}
+		if (adsprpc_trace)
+			dev_info(&fl->cctx->rpdev->dev, "adsprpc: %s: capability domain %u id %u -> %u (%d)\n",
+				 current->comm, c.domain, c.attribute_id, c.capability, err);
+		return copy_to_user(argp, &c, sizeof(c)) ? -EFAULT : 0;
+	}
+	case ADSPRPC_IOCTL_INVOKE2: {
+		struct adsprpc_invoke2 i2;
+		u32 off = 0;
+
+		if (copy_from_user(&i2, argp, sizeof(i2)))
+			return -EFAULT;
+		if (i2.req == ADSPRPC_INVOKE2_KERNEL_OPTIMIZATIONS && i2.size == sizeof(u32))
+			return copy_to_user(u64_to_user_ptr(i2.invparam), &off, sizeof(off)) ? -EFAULT : 0;
+		dev_warn_ratelimited(&fl->cctx->rpdev->dev, "adsprpc: %s: invoke2 request %u (size %u) not supported\n",
+				     current->comm, i2.req, i2.size);
+		return -ENOTTY;
+	}
+	case ADSPRPC_IOCTL_GETINFO: {
+		u32 info = 1;	/* the DSP sits behind an SMMU */
+
+		return copy_to_user(argp, &info, sizeof(info)) ? -EFAULT : 0;
+	}
+	case ADSPRPC_IOCTL_CONTROL: {
+		struct adsprpc_control c;
+
+		if (copy_from_user(&c, argp, sizeof(c)))
+			return -EFAULT;
+		if (c.req == ADSPRPC_CONTROL_KALLOC) {
+			c.arg[0] = 1;
+			return copy_to_user(argp, &c, sizeof(c)) ? -EFAULT : 0;
+		}
+		return 0;
+	}
+	case ADSPRPC_IOCTL_GET_DSP_INFO: {
+		struct adsprpc_dsp_caps caps;
+		u32 i;
+
+		if (copy_from_user(&caps, argp, sizeof(caps)))
+			return -EFAULT;
+		for (i = 0; i < ARRAY_SIZE(caps.attributes); i++) {
+			struct fastrpc_ioctl_capability cap = { .attribute_id = i };
+
+			caps.attributes[i] = fastrpc_get_info_from_kernel(&cap, fl) ? 0 : cap.capability;
+		}
+		return copy_to_user(argp, &caps, sizeof(caps)) ? -EFAULT : 0;
+	}
+	}
+	dev_warn_ratelimited(&fl->cctx->rpdev->dev, "adsprpc: %s: unhandled ioctl 0x%x (nr %u, size %u)\n",
+			     current->comm, cmd, _IOC_NR(cmd), _IOC_SIZE(cmd));
+	return -ENOTTY;
+}
