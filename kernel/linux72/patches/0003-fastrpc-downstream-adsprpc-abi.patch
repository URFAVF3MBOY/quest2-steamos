+/* A request from userspace (argp), or from inside the driver (kreq, for the downstream ABI below). */
+static int fastrpc_req_in(void *dst, char __user *argp, const void *kreq, size_t n)
+{
+	if (kreq) {
+		memcpy(dst, kreq, n);
+		return 0;
+	}
+	return copy_from_user(dst, argp, n) ? -EFAULT : 0;
+}
+
+static int fastrpc_req_out(char __user *argp, void *kreq, const void *src, size_t n)
+{
+	if (kreq) {
+		memcpy(kreq, src, n);
+		return 0;
+	}
+	return copy_to_user(argp, src, n) ? -EFAULT : 0;
+}
