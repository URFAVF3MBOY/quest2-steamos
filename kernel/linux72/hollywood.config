# The Quest 2 on Valve's Frame kernel: merged over linux-valve's gabe_defconfig (SM8650).
# Stage 1 loads no modules, so everything it needs is built in.
CONFIG_LOCALVERSION="-hollywood"
# CONFIG_LOCALVERSION_AUTO is not set

# SM8250 beside the Frame's SM8650
CONFIG_PINCTRL_SM8250=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_QCOM_LLCC=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y

# Display and GPU clock controllers (the display and GPU come after stage 1)
CONFIG_SM_DISPCC_8250=y
CONFIG_SM_GPUCC_8250=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_REGULATOR_QCOM_REFGEN=y

# USB gadget: NCM network and a serial console
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y

CONFIG_WATCHDOG_PRETIMEOUT_GOV=y
CONFIG_WATCHDOG_PRETIMEOUT_GOV_PANIC=y
CONFIG_WATCHDOG_PRETIMEOUT_DEFAULT_GOV_PANIC=y

# CONFIG_RDS is not set

# Reboot modes and the RAM console across a warm reboot
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_REBOOT_MODE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

CONFIG_QRTR_SMD=y
